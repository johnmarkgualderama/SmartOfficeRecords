@{
    ViewBag.Title = "Request Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Request Management - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #f5f5f5;
                overflow: hidden;
            }

            .dashboard-container {
                display: flex;
                height: 100vh;
                width: 100%;
            }

            .sidebar {
                width: 158px;
                min-width: 158px;
                height: 100vh;
                background: #1F2933;
                color: #FFFFFF;
                display: flex;
                flex-direction: column;
                transition: all .3s ease;
                overflow-y: auto;
                overflow-x: hidden;
            }

            .sidebar {
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.25) transparent;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.25);
                    border-radius: 10px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .sidebar.collapsed {
                    width: 78px;
                    min-width: 78px;
                }

                    .sidebar.collapsed .system-name {
                        display: block;
                        font-size: 10px;
                        font-weight: 600;
                        margin-top: 8px;
                    }

                    .sidebar.collapsed .logo-circle {
                        width: 42px;
                        height: 42px;
                    }

                    .sidebar.collapsed .logo-section {
                        padding: 18px 10px;
                    }

                    .sidebar.collapsed .menu a span,
                    .sidebar.collapsed .logout a span {
                        display: none;
                    }

                    .sidebar.collapsed .menu {
                        padding: 15px 10px;
                    }

                        .sidebar.collapsed .menu a {
                            width: 42px;
                            height: 42px;
                            margin: 0 auto 10px auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            border-radius: 6px;
                        }

                            .sidebar.collapsed .menu a.active {
                                background: #B91C1C;
                                box-shadow: 0 4px 10px rgba(0,0,0,.15);
                            }

                            .sidebar.collapsed .menu a i,
                            .sidebar.collapsed .logout a i {
                                margin: 0;
                            }

                    .sidebar.collapsed .logout {
                        padding-bottom: 15px;
                    }

                        .sidebar.collapsed .logout a {
                            width: 42px;
                            height: 42px;
                            margin: 0 auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                        }

                    .sidebar.collapsed .small-arrow {
                        display: none;
                    }

            .logo-section {
                text-align: center;
                padding: 16px 10px;
                border-bottom: 1px solid rgba(255,255,255,.18);
            }

            .logo-circle {
                width: 40px;
                height: 40px;
                background: #FFFFFF;
                border-radius: 50%;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            .system-name {
                margin-top: 8px;
                font-size: 12px;
                font-weight: 600;
                color: #FFFFFF;
            }

            .menu {
                padding: 14px 8px;
            }

                .menu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 8px 10px;
                    margin-bottom: 3px;
                    border-radius: 5px;
                    font-size: 11px;
                    font-weight: 500;
                    transition: all .2s ease;
                }

                    .menu a i {
                        font-size: 14px;
                        min-width: 14px;
                    }

                    .menu a:hover {
                        background: rgba(185, 28, 28, .18);
                        color: #FFFFFF;
                    }

                    .menu a.active {
                        background: #B91C1C;
                        color: #FFFFFF;
                        box-shadow: 0 3px 8px rgba(185,28,28,.22);
                    }

            .sidebar-dropdown {
                margin-bottom: 3px;
            }

            .dropdown-toggle-menu {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                border-radius: 5px;
                cursor: pointer;
                font-size: 11px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .dropdown-toggle-menu:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

            .small-arrow {
                font-size: 8px;
                transition: transform .3s ease;
            }

            .dropdown-submenu {
                display: none;
                flex-direction: column;
                padding-left: 14px;
                margin-top: 3px;
            }

                .dropdown-submenu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 7px 9px;
                    font-size: 10px;
                    border-radius: 5px;
                }

                    .dropdown-submenu a:hover {
                        background: rgba(185,28,28,.18);
                        color: #FFFFFF;
                    }

            .sidebar-dropdown.open .dropdown-submenu {
                display: flex;
            }

            .sidebar-dropdown.open .small-arrow {
                transform: rotate(180deg);
            }

            .logout {
                margin-top: auto;
                padding: 10px 8px 12px 8px;
            }

                .logout a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    gap: 10px;
                    align-items: center;
                    padding: 8px 10px;
                    font-size: 11px;
                    font-weight: 500;
                    border-radius: 5px;
                    transition: all .2s ease;
                }

                    .logout a:hover {
                        background: rgba(185,28,28,.18);
                    }

            .main-content {
                flex: 1;
                background: #F5F6F8;
                display: flex;
                flex-direction: column;
                height: 100vh;
                overflow: hidden;
            }

            .topbar {
                height: 52px;
                min-height: 52px;
                flex-shrink: 0;
                border-bottom: 1px solid #E5E7EB;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 16px;
                background: #FFFFFF;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .menu-toggle {
                background: none;
                border: none;
                color: #B91C1C;
                font-size: 16px;
                cursor: pointer;
                padding: 4px;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-left: auto;
            }

            .notification-icon {
                font-size: 17px;
                color: #374151;
                cursor: pointer;
                transition: color .2s ease;
            }

                .notification-icon:hover {
                    color: #B91C1C;
                }

            .profile {
                display: flex;
                align-items: center;
                gap: 7px;
                padding-left: 8px;
                border-left: 1px solid #E5E7EB;
            }

                .profile img {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    object-fit: cover;
                }

            .profile-info {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

                .profile-info h5 {
                    margin: 0;
                    font-size: 10px;
                    font-weight: 600;
                    color: #111827;
                }

                .profile-info span {
                    font-size: 8px;
                    color: #6B7280;
                }

            .profile-arrow {
                color: #6B7280;
                font-size: 9px;
                margin-left: 2px;
            }

            .content-area {
                flex: 1;
                padding: 18px 28px;
                overflow-y: auto;
                overflow-x: hidden;
            }

            .page-title {
                font-size: 19px;
                font-weight: 700;
                color: #E32626;
                margin-bottom: 2px;
            }

            .page-subtitle {
                font-size: 10px;
                font-weight: 500;
                color: #64748B;
                margin-bottom: 25px;
            }

            .action-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 15px;
                gap: 15px;
            }

            .search-filter {
                display: flex;
                gap: 12px;
                flex: 1;
            }

            .search-box {
                flex: 1;
                position: relative;
                max-width: 535px;
            }

                .search-box i {
                    position: absolute;
                    top: 50%;
                    left: 13px;
                    transform: translateY(-50%);
                    color: #8B929A;
                    font-size: 13px;
                }

                .search-box input {
                    width: 100%;
                    height: 38px;
                    border: 1px solid #E2E5E8;
                    border-radius: 18px;
                    padding-left: 35px;
                    padding-right: 15px;
                    font-size: 11px;
                    outline: none;
                    background: #ffffff;
                    box-shadow: 0 3px 12px rgba(0,0,0,.06);
                    transition: .2s ease;
                }

                    .search-box input:focus {
                        border-color: #C91C1C;
                        box-shadow: 0 0 0 3px rgba(201,28,28,.08);
                    }

                    .search-box input::placeholder {
                        color: #9CA3AF;
                    }

            .status-filter {
                width: 205px;
                height: 38px;
                border: 1px solid #D1D5DB;
                border-radius: 6px;
                padding: 0 12px;
                font-size: 11px;
                font-weight: 500;
                outline: none;
                background: white;
                color: #374151;
            }

                .status-filter:focus {
                    border-color: #C91C1C;
                }

            .table-container {
                background: white;
                border-radius: 6px;
                overflow: hidden;
                border: 1px solid #E1E1E1;
                box-shadow: 0 1px 5px rgba(0,0,0,.02);
            }

            .table {
                margin-bottom: 0;
                width: 100%;
            }

                .table thead {
                    background: #1A1F24;
                }

                    .table thead th {
                        padding: 11px 12px;
                        font-size: 11px;
                        font-weight: 700;
                        color: #FFFFFF;
                        border-bottom: 1px solid #1A1F24;
                        white-space: nowrap;
                    }

                .table tbody td {
                    padding: 11px 12px;
                    vertical-align: middle;
                    font-size: 10px;
                    color: #000000;
                    border-bottom: 1px solid #E5E7EB;
                    white-space: nowrap;
                }

                .table tbody tr:last-child td {
                    border-bottom: none;
                }

                .table tbody tr:hover {
                    background: #FAFAFA;
                }

            .status-pill-pending {
                background: #FFF4E5;
                color: #E58A00;
                padding: 4px 8px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: 600;
                display: inline-block;
            }

            .status-pill-approved {
                background: #DCFCE7;
                color: #15803D;
                padding: 4px 8px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: 600;
                display: inline-block;
            }

            .status-pill-completed {
                background: #DBEAFE;
                color: #1D4ED8;
                padding: 4px 8px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: 600;
                display: inline-block;
            }

            .status-pill-rejected {
                background: #FEE2E2;
                color: #B91C1C;
                padding: 4px 8px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: 600;
                display: inline-block;
            }

            .action-buttons {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-wrap: wrap;
            }

            .action-btn {
                height: 24px;
                border: none;
                border-radius: 4px;
                font-size: 8px;
                font-weight: 600;
                padding: 0 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 4px;
                color: #FFFFFF;
                transition: all .2s ease;
                cursor: pointer;
                text-decoration: none;
                white-space: nowrap;
            }

                .action-btn i {
                    font-size: 9px;
                }

                .action-btn:hover {
                    color: #FFFFFF;
                }

            .btn-view {
                background: #8B5CF6;
            }

                .btn-view:hover {
                    background: #6D28D9;
                }

            .btn-approve {
                background: #16A34A;
                opacity: .55;
            }

                .btn-approve:hover {
                    background: #15803D;
                    opacity: .8;
                }

            .btn-reject {
                background: #E32626;
                opacity: .55;
            }

                .btn-reject:hover {
                    background: #B91C1C;
                    opacity: .8;
                }

            /* =========================================================
                                       RESTRICTED ACTION MODAL (STAFF)
                                    ========================================================= */

            .confirm-modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 3000;
                padding: 20px;
            }

                .confirm-modal-overlay.show {
                    display: flex;
                }

            .confirm-modal-card {
                width: 100%;
                max-width: 320px;
                background: #ffffff;
                border-radius: 12px;
                padding: 30px 26px 24px;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0,0,0,.28);
                opacity: 0;
                transform: translateY(16px);
                animation: confirmSlideIn .25s ease forwards;
            }

            @@keyframes confirmSlideIn {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .confirm-modal-icon {
                width: 62px;
                height: 62px;
                border-radius: 50%;
                background: #FEF3C7;
                color: #D97706;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
                margin: 0 auto 16px;
            }

            .confirm-modal-title {
                color: #111827;
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .confirm-modal-text {
                color: #6B7280;
                font-size: 12px;
                line-height: 1.5;
                margin-bottom: 22px;
            }

            .confirm-modal-btn-ok {
                width: 100%;
                height: 40px;
                border: none;
                background: #1A1F24;
                color: #ffffff;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
            }

                .confirm-modal-btn-ok:hover {
                    background: #000000;
                }

            /* ========================================
                                           PAGINATION FOOTER
                                        ======================================== */

            .pagination-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 18px;
                padding: 0 2px;
            }

            .showing-text {
                font-size: 11px;
                color: #6B7280;
                font-weight: 500;
            }

            .pagination-buttons {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .pill-btn {
                height: 30px;
                padding: 0 16px;
                border-radius: 20px;
                background: #DCFCE7;
                color: #15803D;
                font-size: 11px;
                font-weight: 600;
                border: none;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: all .2s ease;
            }

                .pill-btn:hover {
                    background: #BBF7D0;
                    color: #15803D;
                }

                .pill-btn.disabled {
                    background: #F3F4F6;
                    color: #9CA3AF;
                    pointer-events: none;
                }

            /* ========================================
                                           VIEW APPLICANT MODAL
                                        ======================================== */

            .view-modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .view-modal-overlay.show {
                    display: flex;
                }

            .view-modal-card {
                width: 100%;
                max-width: 380px;
                max-height: 88vh;
                background: #FFFFFF;
                border-radius: 12px;
                box-shadow: 0 25px 60px rgba(0,0,0,.3);
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-modal-header {
                position: relative;
                background: #1A1F24;
                color: #FFFFFF;
                padding: 16px 18px;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .view-modal-close {
                position: absolute;
                top: 10px;
                right: 10px;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: #FFFFFF;
                border: none;
                color: #374151;
                font-size: 13px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 6px rgba(0,0,0,.2);
            }

            .view-modal-avatar {
                width: 38px;
                height: 38px;
                min-width: 38px;
                border-radius: 50%;
                background: #B91C1C;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #FFFFFF;
                font-weight: 700;
                font-size: 13px;
            }

            .view-modal-name {
                font-size: 14px;
                font-weight: 700;
                flex: 1;
            }

            .view-modal-status {
                margin-left: auto;
            }

            .view-modal-body {
                padding: 18px 20px 20px;
                overflow-y: auto;
            }

            .view-modal-section-title {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .6px;
                color: #9CA3AF;
                text-transform: uppercase;
                padding-bottom: 6px;
                border-bottom: 1px solid #E5E7EB;
                margin-bottom: 12px;
                margin-top: 16px;
            }

                .view-modal-section-title:first-child {
                    margin-top: 0;
                }

            .view-modal-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .view-modal-field-label {
                font-size: 8.5px;
                font-weight: 700;
                color: #9CA3AF;
                letter-spacing: .4px;
                text-transform: uppercase;
                margin-bottom: 3px;
            }

            .view-modal-field-value {
                font-size: 11px;
                font-weight: 600;
                color: #1F2933;
            }

                .view-modal-field-value.link {
                    color: #2563EB;
                }

            .view-modal-notes-box {
                background: #F3F4F6;
                border-radius: 6px;
                padding: 10px 12px;
                font-size: 10.5px;
                color: #6B7280;
            }

            .view-modal-docs {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .view-modal-doc-btn {
                border: 1px solid #E5E7EB;
                border-radius: 6px;
                padding: 10px;
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                color: #1F2933;
                transition: all .2s ease;
            }

                .view-modal-doc-btn:hover {
                    border-color: #B91C1C;
                    background: #FEF2F2;
                }

                .view-modal-doc-btn.disabled {
                    opacity: .5;
                    pointer-events: none;
                }

            .view-modal-doc-icon {
                font-size: 15px;
                color: #6B7280;
            }

            .view-modal-doc-text {
                display: flex;
                flex-direction: column;
                line-height: 1.3;
            }

            .view-modal-doc-title {
                font-size: 10px;
                font-weight: 700;
            }

            .view-modal-doc-sub {
                font-size: 8px;
                color: #9CA3AF;
            }

            /* ========================================
                                           RESPONSIVE
                                        ======================================== */

            @@media (max-width: 900px) {

                .content-area {
                    padding: 18px;
                }

                .action-bar {
                    flex-wrap: wrap;
                }

                .search-filter {
                    width: 100%;
                }

                .table-container {
                    overflow-x: auto;
                }

                .table {
                    min-width: 850px;
                }

                .pagination-footer {
                    flex-direction: column;
                    gap: 10px;
                    align-items: flex-start;
                }
            }
    </style>

</head>

<body>

    <div class="dashboard-container">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="logo-section">

                <div class="logo-circle">
                    <img src="~/Images/newlogo.png"
                         class="logo-img"
                         alt="SORS Logo">
                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>

            <div class="menu">

                <a href="@Url.Action("StaffDashboard", "Staff")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("StaffRequest", "Staff")" class="active">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Request</span>
                </a>

                <a href="@Url.Action("StaffRecords", "Staff")">
                    <i class="bi bi-folder2-open"></i>
                    <span>Records</span>
                </a>

                <a href="@Url.Action("StaffReports", "Staff")">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>
                </a>

                <div class="sidebar-dropdown">

                    <a href="javascript:void(0)" class="dropdown-toggle-menu">
                        <i class="bi bi-gear-fill"></i>
                        <span>Settings</span>
                        <i class="bi bi-chevron-right ms-auto small-arrow"></i>
                    </a>

                    <div class="dropdown-submenu">

                        <a href="@Url.Action("StaffSettings", "Staff")">
                            <i class="bi bi-sliders"></i>
                            <span>General Settings</span>
                        </a>

                        <a href="@Url.Action("SAccountSettings", "Staff")">
                            <i class="bi bi-person-gear"></i>
                            <span>Account & Security</span>
                        </a>

                    </div>

                </div>

            </div>

            <div class="logout">

                <a href="@Url.Action("StaffLogin", "Staff")">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>

            </div>

        </aside>


        <!-- MAIN CONTENT -->

        <div class="main-content">

            <!-- TOPBAR -->

            <div class="topbar">

                <div class="topbar-left">

                    <button class="menu-toggle" id="menuToggle">
                        <i class="bi bi-list"></i>
                    </button>

                </div>

                <div class="topbar-right">

                    <i class="bi bi-bell notification-icon"></i>

                    <div class="profile">

                        <img src="~/Images/adminpic.jpg" alt="Profile" />

                        <div class="profile-info">
                            <h5>John Cruz</h5>
                            <span>Staff</span>
                        </div>

                        <i class="bi bi-chevron-down profile-arrow"></i>

                    </div>

                </div>

            </div>


            <!-- CONTENT -->

            <div class="content-area">

                <div class="page-title">Request</div>

                <div class="page-subtitle">
                    Here's what's happening with your interviews and records today.
                </div>

                @using (Html.BeginForm("StaffRequest", "Staff", FormMethod.Get))
                {
                    <div class="action-bar">

                        <div class="search-filter">

                            <div class="search-box">

                                <i class="bi bi-search"></i>

                                <input type="text"
                                       name="search"
                                       value="@ViewBag.SearchTerm"
                                       placeholder="Search here..."
                                       onchange="this.form.submit()" />

                            </div>

                            <select name="status" class="status-filter" onchange="this.form.submit()">
                                <option value="All Status" selected="@(ViewBag.SelectedStatus == null || ViewBag.SelectedStatus == "All Status")">All Status</option>
                                <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending</option>
                                <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved")">Approved</option>
                                <option value="Rejected" selected="@(ViewBag.SelectedStatus == "Rejected")">Rejected</option>
                                <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
                            </select>
                        </div>

                    </div>
                }

                <!-- TABLE -->

                <div class="table-container">

                    <table class="table">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>APPLICANT NAME</th>
                                <th>EMAIL ADDRESS</th>
                                <th>DATE APPLIED</th>
                                <th>STATUS</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (ViewBag.Requests == null || ViewBag.Requests.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No requests found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var request in ViewBag.Requests)
                                {
                                    string statusClass = request.Status switch
                                    {
                                        "Pending" => "status-pill-pending",
                                        "Approved" => "status-pill-approved",
                                        "Completed" => "status-pill-completed",
                                        "Rejected" => "status-pill-rejected",
                                        _ => "status-pill-pending"
                                    };

                                    <tr>

                                        <td>@request.DisplayId</td>

                                        <td>@request.ApplicantName</td>

                                        <td>@request.ApplicantEmail</td>

                                        <td>@request.DateAppliedFormatted</td>

                                        <td>
                                            <span class="@statusClass">@request.Status</span>
                                        </td>

                                        <td>

                                            <div class="action-buttons">

                                                <button type="button"
                                                        class="action-btn btn-view"
                                                        onclick="openViewModal(this)"
                                                        data-id="@request.DisplayId"
                                                        data-name="@request.ApplicantName"
                                                        data-initials="@request.Initials"
                                                        data-status="@request.Status"
                                                        data-statusclass="@statusClass"
                                                        data-email="@request.Email"
                                                        data-contact="@request.ContactNumber"
                                                        data-appdate="@request.AppointmentDateFormatted"
                                                        data-apptime="@request.AppointmentTimeFormatted"
                                                        data-submitted="@request.DateSubmittedFormatted"
                                                        data-notes="@request.AdditionalNotes"
                                                        data-resume="@(string.IsNullOrEmpty((string)request.ResumeFile) ? "" : Url.Content("~/Resumes/" + request.ResumeFile))"
                                                        data-validid="@(string.IsNullOrEmpty((string)request.ValidIDFile) ? "" : Url.Content("~/ValidIDs/" + request.ValidIDFile))">
                                                    <i class="bi bi-eye"></i> View
                                                </button>

                                                @if (request.Status == "Pending")
                                                {
                                                    <button type="button" class="action-btn btn-approve" onclick="openRestrictedModal()">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>

                                                    <button type="button" class="action-btn btn-reject" onclick="openRestrictedModal()">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>
                                                }

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

                <!-- PAGINATION FOOTER -->
                @{
                    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
                    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
                    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : (ViewBag.Requests != null ? ViewBag.Requests.Count : 0);
                    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 5;

                    int startItem = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
                    int endItem = Math.Min(currentPage * pageSize, totalCount);
                }

                <div class="pagination-footer">

                    <div class="showing-text">
                        Showing @startItem to @endItem of @totalCount users
                    </div>

                        <div class="pagination-buttons">

                        @if (currentPage <= 1)
                        {
                            <span class="pill-btn disabled">Previous</span>
                        }
                        else
                        {
                            <a href="@Url.Action("StaffRequest", "Staff", new { search = ViewBag.SearchTerm, status = ViewBag.SelectedStatus, page = currentPage - 1 })" class="pill-btn">Previous</a>
                        }

                        @if (currentPage >= totalPages)
                        {
                            <span class="pill-btn disabled">Next</span>
                        }
                        else
                        {
                            <a href="@Url.Action("StaffRequest", "Staff", new { search = ViewBag.SearchTerm, status = ViewBag.SelectedStatus, page = currentPage + 1 })" class="pill-btn">Next</a>
                        }

                    </div>

                </div>

                <!-- ================================================
                     VIEW APPLICANT MODAL
                ================================================= -->

                <div class="view-modal-overlay" id="viewApplicantModal">
                    <div class="view-modal-card">

                        <div class="view-modal-header">
                            <button type="button" class="view-modal-close" onclick="closeViewModal()">&times;</button>
                            <div class="view-modal-avatar" id="vmAvatar"></div>
                            <div class="view-modal-name" id="vmName"></div>
                            <span class="view-modal-status" id="vmStatus"></span>
                        </div>

                        <div class="view-modal-body">

                            <div class="view-modal-section-title">Contact Information</div>
                            <div class="view-modal-grid">
                                <div>
                                    <div class="view-modal-field-label">Email</div>
                                    <div class="view-modal-field-value" id="vmEmail"></div>
                                </div>
                                <div>
                                    <div class="view-modal-field-label">Contact Number</div>
                                    <div class="view-modal-field-value link" id="vmContact"></div>
                                </div>
                            </div>

                            <div class="view-modal-section-title">Interview Details</div>
                            <div class="view-modal-grid">
                                <div>
                                    <div class="view-modal-field-label">Appointment Date</div>
                                    <div class="view-modal-field-value" id="vmAppDate"></div>
                                </div>
                                <div>
                                    <div class="view-modal-field-label">Date Submitted</div>
                                    <div class="view-modal-field-value" id="vmSubmitted"></div>
                                </div>
                                <div>
                                    <div class="view-modal-field-label">Appointment Time</div>
                                    <div class="view-modal-field-value" id="vmAppTime"></div>
                                </div>
                            </div>

                            <div class="view-modal-section-title">Additional Notes</div>
                            <div class="view-modal-notes-box" id="vmNotes"></div>

                            <div class="view-modal-section-title">Submitted Documents</div>
                            <div class="view-modal-docs">
                                <a href="#" target="_blank" class="view-modal-doc-btn" id="vmResumeLink">
                                    <i class="bi bi-eye view-modal-doc-icon"></i>
                                    <div class="view-modal-doc-text">
                                        <span class="view-modal-doc-title">View Resume</span>
                                        <span class="view-modal-doc-sub">PDF DOCUMENT</span>
                                    </div>
                                </a>
                                <a href="#" target="_blank" class="view-modal-doc-btn" id="vmValidIdLink">
                                    <i class="bi bi-eye view-modal-doc-icon"></i>
                                    <div class="view-modal-doc-text">
                                        <span class="view-modal-doc-title">View Valid ID</span>
                                        <span class="view-modal-doc-sub">IMAGE / PDF</span>
                                    </div>
                                </a>
                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>


        <!-- ================================================
             RESTRICTED ACTION MODAL (STAFF CANNOT APPROVE / REJECT)
        ================================================= -->

        <div class="confirm-modal-overlay" id="restrictedModal">
            <div class="confirm-modal-card">

                <div class="confirm-modal-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <div class="confirm-modal-title">Action Not Allowed</div>
                <div class="confirm-modal-text">Only an Administrator can approve or reject an applicant. You may still view their information.</div>

                <button type="button" class="confirm-modal-btn-ok" onclick="closeRestrictedModal()">OK</button>

            </div>
        </div>

    </div>


    <!-- JAVASCRIPT -->

    <script>

            const dropdown = document.querySelector('.sidebar-dropdown');
            const toggle = document.querySelector('.dropdown-toggle-menu');

            toggle.addEventListener('click', function () {
                dropdown.classList.toggle('open');
            });

            const sidebar = document.querySelector('.sidebar');
            const toggleBtn = document.getElementById('menuToggle');

            toggleBtn.addEventListener('click', function () {
                sidebar.classList.toggle('collapsed');
            });


            /* =========================================
               VIEW APPLICANT MODAL
            ========================================= */

            function openViewModal(btn) {
                const d = btn.dataset;

                document.getElementById('vmAvatar').textContent = d.initials;
                document.getElementById('vmName').textContent = d.name;

                const statusEl = document.getElementById('vmStatus');
                statusEl.textContent = d.status;
                statusEl.className = 'view-modal-status ' + d.statusclass;

                document.getElementById('vmEmail').textContent = d.email;
                document.getElementById('vmContact').textContent = d.contact;
                document.getElementById('vmAppDate').textContent = d.appdate;
                document.getElementById('vmSubmitted').textContent = d.submitted;
                document.getElementById('vmAppTime').textContent = d.apptime;
                document.getElementById('vmNotes').textContent = d.notes;

                const resumeLink = document.getElementById('vmResumeLink');
                if (d.resume) {
                    resumeLink.href = d.resume;
                    resumeLink.classList.remove('disabled');
                } else {
                    resumeLink.href = '#';
                    resumeLink.classList.add('disabled');
                }

                const validIdLink = document.getElementById('vmValidIdLink');
                if (d.validid) {
                    validIdLink.href = d.validid;
                    validIdLink.classList.remove('disabled');
                } else {
                    validIdLink.href = '#';
                    validIdLink.classList.add('disabled');
                }

                document.getElementById('viewApplicantModal').classList.add('show');
            }

            function closeViewModal() {
                document.getElementById('viewApplicantModal').classList.remove('show');
            }

            document.getElementById('viewApplicantModal').addEventListener('click', function (e) {
                if (e.target === this) {
                    closeViewModal();
                }
            });


            /* =========================================
               RESTRICTED ACTION MODAL
            ========================================= */

            function openRestrictedModal() {
                document.getElementById('restrictedModal').classList.add('show');
            }

            function closeRestrictedModal() {
                document.getElementById('restrictedModal').classList.remove('show');
            }

            document.getElementById('restrictedModal').addEventListener('click', function (e) {
                if (e.target === this) {
                    closeRestrictedModal();
                }
            });

            
    </script>

</body>
</html>