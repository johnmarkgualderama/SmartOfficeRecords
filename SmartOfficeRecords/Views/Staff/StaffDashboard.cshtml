    <!-- JAVASCRIPT -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        /* =========================================
        SETTINGS DROPDOWN
        ========================================= */

        const dropdown = document.querySelector('.sidebar-dropdown');
        const dropdownToggle = document.querySelector('.dropdown-toggle-menu');

        dropdownToggle.addEventListener('click', function () {
        dropdown.classList.toggle('open');
        });


        /* =========================================
        SIDEBAR COLLAPSE
        ========================================= */

        const sidebar = document.querySelector('.sidebar');
        const menuToggle = document.getElementById('menuToggle');

        menuToggle.addEventListener('click', function () {
        sidebar.classList.toggle('collapsed');
        });


        /* =========================================
        CHART.JS: REQUEST OVERVIEW GRAPH
        ========================================= */

        let chart;
        const currentYear = @(ViewBag.CurrentYear)

        function loadChart(range, year) {

        fetch(`/Staff/GetRequestChartData?range=${range}&year=${year}`)
        .then(res => res.json())
        .then(data => {

        const ctx = document.getElementById('requestChart').getContext('2d');

        if (chart) chart.destroy();

        chart = new Chart(ctx, {
        type: 'bar',
        data: {
        labels: data.labels,
        datasets: [{
        label: 'Appointment Requests',
        data: data.counts,
        backgroundColor: '#B91C1C',
        borderRadius: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false }
        },
        scales: {
        y: {
        beginAtZero: true,
        ticks: { stepSize: 1, font: { size: 9 } }
        },
        x: {
        ticks: { font: { size: 9 } }
        }
        }
        }
        });

        });
        }

        const rangeSelect = document.getElementById('rangeSelect');
        const yearSelect = document.getElementById('yearSelect');

        function currentSelection() {
        return { range: rangeSelect.value, year: parseInt(yearSelect.value, 10) };
        }

        loadChart('month', currentYear);

        rangeSelect.addEventListener('change', function () {
        const sel = currentSelection();
        loadChart(sel.range, sel.year);
        });

        yearSelect.addEventListener('change', function () {
        const sel = currentSelection();

        // Week view doesn't make sense for a past year — auto-switch to Month
        if (sel.range === 'week' && sel.year !== currentYear) {
        rangeSelect.value = 'month';
        loadChart('month', sel.year);
        } else {
        loadChart(sel.range, sel.year);
        }
        });


        /* =========================================
        STAT SUMMARY CARD POPUPS
        ========================================= */

        function openStatModal(id) {
        document.getElementById(id).classList.add('show');
        }

        function closeStatModal(id) {
        document.getElementById(id).classList.remove('show');
        }

        document.querySelectorAll('.stat-modal-overlay').forEach(function (overlay) {
        overlay.addEventListener('click', function (e) {
        if (e.target === overlay) {
        overlay.classList.remove('show');
        }
        });
        });

        function filterStatTable(input) {
        const targetId = input.getAttribute('data-target');
        const table = document.getElementById(targetId);
        const filter = input.value.toLowerCase();
        const rows = table.querySelectorAll('tbody tr');

        rows.forEach(function (row) {
        const text = row.textContent.toLowerCase();
        row.style.display = text.indexOf(filter) > -1 ? '' : 'none';
        });
        }


        /* =========================================
        RESTRICTED ACTION MODAL
        ========================================= */

        function openRestrictedModal() {
        document.getElementById('restrictedModal').classList.add('show');
        }

        function closeRestrictedModal() {
        document.getElementById('restrictedModal').classList.remove('show');
        }

        document.getElementById('restrictedModal').addEventListener('click', function (e) {
        if (e.target === this) {
        closeRestrictedModal();
        }
        });

    </script>


