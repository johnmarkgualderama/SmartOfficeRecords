@{
    ViewBag.Title = "Staff Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Staff Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #F5F6F8;
                overflow: hidden;
            }

            .dashboard-container {
                display: flex;
                height: 100vh;
                width: 100%;
            }

            .sidebar {
                width: 158px;
                min-width: 158px;
                height: 100vh;
                background: #1F2933;
                color: #FFFFFF;
                display: flex;
                flex-direction: column;
                transition: all .3s ease;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.25) transparent;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.25);
                    border-radius: 10px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .sidebar.collapsed {
                    width: 78px;
                    min-width: 78px;
                }

                    .sidebar.collapsed .system-name {
                        display: block;
                        font-size: 10px;
                        font-weight: 600;
                        margin-top: 8px;
                    }

                    .sidebar.collapsed .logo-circle {
                        width: 42px;
                        height: 42px;
                    }

                    .sidebar.collapsed .logo-section {
                        padding: 18px 10px;
                    }

                    .sidebar.collapsed .menu a span,
                    .sidebar.collapsed .logout a span {
                        display: none;
                    }

                    .sidebar.collapsed .menu {
                        padding: 15px 10px;
                    }

                        .sidebar.collapsed .menu a {
                            width: 42px;
                            height: 42px;
                            margin: 0 auto 10px auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            border-radius: 6px;
                        }

                            .sidebar.collapsed .menu a.active {
                                background: #B91C1C;
                                box-shadow: 0 4px 10px rgba(0,0,0,.15);
                            }

                            .sidebar.collapsed .menu a i,
                            .sidebar.collapsed .logout a i {
                                margin: 0;
                            }

                    .sidebar.collapsed .logout {
                        padding-bottom: 15px;
                    }

                        .sidebar.collapsed .logout a {
                            width: 42px;
                            height: 42px;
                            margin: 0 auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                        }

                    .sidebar.collapsed .small-arrow {
                        display: none;
                    }

            .logo-section {
                text-align: center;
                padding: 16px 10px;
                border-bottom: 1px solid rgba(255,255,255,.18);
            }

            .logo-circle {
                width: 40px;
                height: 40px;
                background: #FFFFFF;
                border-radius: 50%;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            .system-name {
                margin-top: 8px;
                font-size: 12px;
                font-weight: 600;
                color: #FFFFFF;
            }

            .menu {
                padding: 14px 8px;
            }

                .menu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 8px 10px;
                    margin-bottom: 3px;
                    border-radius: 5px;
                    font-size: 11px;
                    font-weight: 500;
                    transition: all .2s ease;
                }

                    .menu a i {
                        font-size: 14px;
                        min-width: 14px;
                    }

                    .menu a:hover {
                        background: rgba(185, 28, 28, .18);
                        color: #FFFFFF;
                    }

                    .menu a.active {
                        background: #B91C1C;
                        color: #FFFFFF;
                        box-shadow: 0 3px 8px rgba(185,28,28,.22);
                    }

            .sidebar-dropdown {
                margin-bottom: 3px;
            }

            .dropdown-toggle-menu {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                border-radius: 5px;
                cursor: pointer;
                font-size: 11px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .dropdown-toggle-menu:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

            .small-arrow {
                font-size: 8px;
                transition: transform .3s ease;
            }

            .dropdown-submenu {
                display: none;
                flex-direction: column;
                padding-left: 14px;
                margin-top: 3px;
            }

                .dropdown-submenu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 7px 9px;
                    font-size: 10px;
                    border-radius: 5px;
                }

                    .dropdown-submenu a:hover {
                        background: rgba(185,28,28,.18);
                        color: #FFFFFF;
                    }

            .sidebar-dropdown.open .dropdown-submenu {
                display: flex;
            }

            .sidebar-dropdown.open .small-arrow {
                transform: rotate(180deg);
            }

            .logout {
                margin-top: auto;
                padding: 10px 8px 12px 8px;
            }

                .logout a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    gap: 10px;
                    align-items: center;
                    padding: 8px 10px;
                    font-size: 11px;
                    font-weight: 500;
                    border-radius: 5px;
                    transition: all .2s ease;
                }

                    .logout a:hover {
                        background: rgba(185,28,28,.18);
                    }

            .main-content {
                flex: 1;
                background: #F5F6F8;
                display: flex;
                flex-direction: column;
                height: 100vh;
                overflow: hidden;
            }

            .topbar {
                height: 52px;
                min-height: 52px;
                flex-shrink: 0;
                border-bottom: 1px solid #E5E7EB;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 16px;
                background: #FFFFFF;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .menu-toggle {
                background: none;
                border: none;
                color: #B91C1C;
                font-size: 16px;
                cursor: pointer;
                padding: 4px;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-left: auto;
            }

            .notification-icon {
                font-size: 17px;
                color: #374151;
                cursor: pointer;
                transition: color .2s ease;
            }

                .notification-icon:hover {
                    color: #B91C1C;
                }

            .profile {
                display: flex;
                align-items: center;
                gap: 7px;
                padding-left: 8px;
                border-left: 1px solid #E5E7EB;
            }

                .profile img {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    object-fit: cover;
                }

            .profile-info {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

                .profile-info h5 {
                    margin: 0;
                    font-size: 10px;
                    font-weight: 600;
                    color: #111827;
                }

                .profile-info span {
                    font-size: 8px;
                    color: #6B7280;
                }

            .profile-arrow {
                color: #6B7280;
                font-size: 9px;
                margin-left: 2px;
            }

            .content-area {
                flex: 1;
                padding: 18px 28px;
                overflow-y: auto;
                overflow-x: hidden;
            }

            .welcome-section {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 13px;
            }

            .welcome-text h2 {
                font-size: 18px;
                font-weight: 700;
                color: #B91C1C;
                margin: 0 0 2px 0;
            }

            .welcome-text p {
                font-size: 9px;
                color: #64748B;
                font-weight: 500;
                margin: 0;
            }

            .search-box {
                width: 255px;
                height: 34px;
                background: #FFFFFF;
                border-radius: 20px;
                box-shadow: 0 3px 12px rgba(0,0,0,.07);
                display: flex;
                align-items: center;
                padding: 0 12px;
                gap: 8px;
            }

                .search-box i {
                    color: #6B7280;
                    font-size: 12px;
                }

                .search-box input {
                    width: 100%;
                    border: none;
                    outline: none;
                    font-size: 10px;
                    color: #374151;
                    background: transparent;
                }

                    .search-box input::placeholder {
                        color: #9CA3AF;
                    }

            .cards-container {
                display: flex;
                gap: 12px;
                width: 100%;
                margin-bottom: 18px;
            }

            .dashboard-card {
                flex: 1;
                min-width: 150px;
                height: 86px;
                background: #FFFFFF;
                border: 1px solid #E5E7EB;
                border-radius: 6px;
                display: flex;
                align-items: center;
                padding: 13px;
                gap: 12px;
                transition: all .2s ease;
                cursor: pointer;
            }

                .dashboard-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(0,0,0,.06);
                }

            .card-icon {
                width: 43px;
                height: 43px;
                min-width: 43px;
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                color: #FFFFFF;
                font-size: 18px;
            }

            .purple {
                background: #7C3AED;
            }

            .orange {
                background: #F59E0B;
            }

            .green {
                background: #10B981;
            }

            .blue {
                background: #3B82F6;
            }

            .red {
                background: #EF4444;
            }

            .card-info h2 {
                margin: 0;
                font-size: 21px;
                font-weight: 700;
                color: #111827;
            }

            .card-info span {
                font-size: 9px;
                font-weight: 600;
            }

            /* =========================================================
                                           LOWER CONTENT (GRAPH + TABLE)
                                        ========================================================= */

            .lower-content {
                display: grid;
                grid-template-columns: 1.65fr .95fr;
                gap: 14px;
            }

            .dashboard-panel {
                background: #FFFFFF;
                border: 1px solid #D9DDE3;
                border-radius: 6px;
                overflow: hidden;
            }

            .panel-header {
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 15px;
            }

                .panel-header h4 {
                    font-size: 11px;
                    font-weight: 700;
                    color: #111827;
                    margin: 0;
                }

            .filter-select {
                height: 27px;
                min-width: 115px;
                border: 1px solid #D1D5DB;
                background: #FFFFFF;
                padding: 0 8px;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 600;
                color: #374151;
            }

                .filter-select:hover {
                    border-color: #B91C1C;
                }

                .filter-select:focus {
                    outline: none;
                    border-color: #B91C1C;
                }

            .graph-panel-body {
                height: 240px;
                padding: 6px 15px 15px 15px;
            }

            /* =========================================================
                                           APPLICANT TABLE PANEL
                                        ========================================================= */

            .table-panel {
                height: 296px;
                display: flex;
                flex-direction: column;
            }

            .applicant-table {
                width: 100%;
                border-collapse: collapse;
                margin: 0;
            }

                .applicant-table thead {
                    background: #D1D1D1;
                }

                .applicant-table th {
                    height: 36px;
                    padding: 0 10px;
                    font-size: 9px;
                    font-weight: 700;
                    color: #111827;
                    border-bottom: 1px solid #D1D5DB;
                    white-space: nowrap;
                    text-align: left;
                }

                .applicant-table thead th {
                    position: sticky;
                    top: 0;
                    z-index: 1;
                }

                .applicant-table td {
                    min-height: 34px;
                    padding: 9px 10px;
                    font-size: 9px;
                    color: #374151;
                    border-bottom: 1px solid #E5E7EB;
                    vertical-align: middle;
                    white-space: nowrap;
                }

                .applicant-table tbody tr:hover {
                    background: #FEF2F2;
                }

                .applicant-table tbody tr:last-child td {
                    border-bottom: none;
                }

            .applicant-table-scroll {
                flex: 1;
                overflow-y: auto;
            }

                .applicant-table-scroll::-webkit-scrollbar {
                    width: 6px;
                }

                .applicant-table-scroll::-webkit-scrollbar-thumb {
                    background: #D1D5DB;
                    border-radius: 10px;
                }

                .applicant-table-scroll::-webkit-scrollbar-track {
                    background: transparent;
                }

            /* =========================================================
                                           STAT SUMMARY CARD POPUPS
                                        ========================================================= */

            .stat-modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .stat-modal-overlay.show {
                    display: flex;
                }

            .stat-modal-card {
                width: 100%;
                max-width: 560px;
                max-height: 85vh;
                background: #ffffff;
                border-radius: 10px;
                box-shadow: 0 25px 60px rgba(0,0,0,.28);
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .stat-modal-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 20px;
                border-bottom: 1px solid #E5E7EB;
            }

            .stat-modal-title-group {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .stat-modal-title {
                font-size: 14px;
                font-weight: 700;
                color: #111827;
            }

            .stat-modal-badge {
                background: #B91C1C;
                color: #ffffff;
                font-size: 10px;
                font-weight: 700;
                padding: 2px 8px;
                border-radius: 10px;
            }

            .stat-modal-close {
                background: none;
                border: none;
                font-size: 18px;
                color: #6B7280;
                cursor: pointer;
                line-height: 1;
            }

                .stat-modal-close:hover {
                    color: #B91C1C;
                }

            .stat-modal-date {
                padding: 10px 20px 0;
                font-size: 10px;
                font-weight: 600;
                color: #B91C1C;
            }

            .stat-modal-search {
                padding: 12px 20px;
            }

                .stat-modal-search .search-box {
                    width: 100%;
                }

            .stat-modal-table-wrap {
                flex: 1;
                overflow-y: auto;
                padding: 0 20px 16px;
            }

            .stat-modal-table {
                width: 100%;
                border-collapse: collapse;
            }

                .stat-modal-table thead th {
                    position: sticky;
                    top: 0;
                    background: #D1D1D1;
                    font-size: 9px;
                    font-weight: 700;
                    color: #111827;
                    padding: 8px 10px;
                    text-align: left;
                    white-space: nowrap;
                    z-index: 1;
                }

                .stat-modal-table td {
                    padding: 9px 10px;
                    font-size: 10px;
                    color: #374151;
                    border-bottom: 1px solid #E5E7EB;
                    vertical-align: middle;
                    white-space: nowrap;
                }

                .stat-modal-table tbody tr:hover {
                    background: #FEF2F2;
                }

            .stat-avatar-row {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .stat-avatar {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffffff;
                font-size: 9px;
                font-weight: 700;
                flex-shrink: 0;
            }

            .status-pill-approved {
                background: #DCFCE7;
                color: #15803D;
                padding: 4px 10px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: 600;
                display: inline-block;
            }

            .status-pill-completed {
                background: #DBEAFE;
                color: #2563EB;
                padding: 4px 10px;
                border-radius: 4px;
                font-size: 9px;
                font-weight: 600;
                display: inline-block;
            }

            /* =========================================================
                                           RESTRICTED ACTION MODAL (STAFF)
                                        ========================================================= */

            .confirm-modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 2100;
                padding: 20px;
            }

                .confirm-modal-overlay.show {
                    display: flex;
                }

            .confirm-modal-card {
                width: 100%;
                max-width: 340px;
                background: #ffffff;
                border-radius: 12px;
                padding: 30px 26px 26px;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0,0,0,.3);
                opacity: 0;
                transform: translateY(16px);
                animation: confirmSlideIn .3s ease forwards;
            }

            @@keyframes confirmSlideIn {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .confirm-modal-icon {
                width: 58px;
                height: 58px;
                border-radius: 50%;
                background: #FEE2E2;
                color: #B91C1C;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 24px;
                margin: 0 auto 16px;
            }

            .confirm-modal-title {
                font-size: 15px;
                font-weight: 700;
                color: #1F2933;
                margin-bottom: 8px;
            }

            .confirm-modal-text {
                font-size: 11px;
                color: #6B7280;
                line-height: 1.5;
                margin-bottom: 22px;
            }

            .confirm-modal-btn-ok {
                width: 100%;
                height: 42px;
                border: none;
                background: #B91C1C;
                color: #ffffff;
                border-radius: 7px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(185,28,28,.2);
                transition: .2s ease;
            }

                .confirm-modal-btn-ok:hover {
                    background: #991B1B;
                }

            /* =========================================================
                                           RESPONSIVE
                                        ========================================================= */

            @@media (max-width: 1000px) {

                .cards-container {
                    flex-wrap: wrap;
                }

                .dashboard-card {
                    min-width: 180px;
                }

                .lower-content {
                    grid-template-columns: 1fr;
                }

                .search-box {
                    width: 200px;
                }

                .applicant-table {
                    min-width: 400px;
                }

                .table-panel {
                    overflow-x: auto;
                    height: auto;
                }
            }


            @@media (max-width: 768px) {

                body {
                    overflow-y: auto;
                }

                .sidebar {
                    width: 70px;
                    min-width: 70px;
                }

                .system-name,
                .menu a span,
                .dropdown-toggle-menu span,
                .logout a span {
                    display: none;
                }

                .logo-section {
                    padding: 15px 8px;
                }

                .logo-circle {
                    width: 40px;
                    height: 40px;
                }

                .menu {
                    padding: 15px 8px;
                }

                    .menu a {
                        justify-content: center;
                        padding: 10px;
                    }

                .dropdown-toggle-menu {
                    justify-content: center;
                    padding: 10px;
                }

                .small-arrow {
                    display: none;
                }

                .logout a {
                    justify-content: center;
                }

                .content-area {
                    padding: 12px;
                }

                .welcome-section {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 12px;
                }

                .search-box {
                    width: 100%;
                }

                .cards-container {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                }

                .dashboard-card {
                    width: 100%;
                }
            }


            @@media (max-width: 500px) {

                .cards-container {
                    grid-template-columns: 1fr;
                }

                .profile-info {
                    display: none;
                }

                .lower-content {
                    display: block;
                }

                .dashboard-panel {
                    margin-bottom: 15px;
                }
            }
    </style>

</head>


<body>

    <div class="dashboard-container">


        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/logo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>

            <div class="menu">

                <a href="@Url.Action("StaffDashboard", "Staff")"
                   class="active">

                    <i class="bi bi-grid-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>

                <a href="@Url.Action("StaffRequest", "Staff")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Request
                    </span>

                </a>

                <a href="@Url.Action("StaffRecords", "Staff")">

                    <i class="bi bi-folder2-open"></i>

                    <span>
                        Records
                    </span>

                </a>

                <a href="@Url.Action("StaffReports", "Staff")">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                    <span>
                        Reports
                    </span>

                </a>

                <div class="sidebar-dropdown">

                    <a href="javascript:void(0)"
                       class="dropdown-toggle-menu">

                        <i class="bi bi-gear-fill"></i>

                        <span>
                            Settings
                        </span>

                        <i class="bi bi-chevron-right ms-auto small-arrow"></i>

                    </a>

                    <div class="dropdown-submenu">

                        <a href="@Url.Action("StaffSettings", "Staff")">

                            <i class="bi bi-sliders"></i>

                            <span>
                                General Settings
                            </span>

                        </a>

                        <a href="@Url.Action("SAccountSettings", "Staff")">

                            <i class="bi bi-person-gear"></i>

                            <span>
                                Account & Security
                            </span>

                        </a>

                    </div>

                </div>

            </div>

            <div class="logout">

                <a href="@Url.Action("StaffLogin", "Staff")">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </aside>


        <!-- MAIN CONTENT -->

        <div class="main-content">

            <!-- TOPBAR -->

            <div class="topbar">

                <div class="topbar-left">

