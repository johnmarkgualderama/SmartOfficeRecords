@{
    ViewBag.Title = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #F3F4F6;
            min-height: 100vh;
            overflow: hidden;
        }

        /* =========================================
                   MAIN CONTAINER
                   ========================================= */

        .main-container {
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-wrapper {
            width: 100%;
            height: 100vh;
            display: flex;
            overflow: hidden;
            background: #FFFFFF;
        }


        /* =========================================
                   LEFT SIDE
                   ========================================= */

        .left-side {
            width: 41%;
            height: 100vh;
            background: #111827;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding-top: 72px;
            position: relative;
        }


        /* =========================================
                   LOGO
                   ========================================= */

        .top-content {
            width: 100%;
            text-align: center;
        }

            .top-content img {
                width: 120px;
                height: 120px;
                object-fit: contain;
                background: #FFFFFF;
                padding: 8px;
                border-radius: 50%;
                margin-bottom: 32px;
            }


            /* =========================================
                   SYSTEM NAME
                   ========================================= */

            .top-content h1 {
                color: #FFFFFF;
                font-size: 30px;
                font-weight: 700;
                line-height: 1.35;
                letter-spacing: 0.2px;
                margin: 0;
            }


        /* =========================================
                   RIGHT SIDE
                   ========================================= */

        .right-side {
            width: 59%;
            height: 100vh;
            background: #FFFFFF;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
        }


        /* =========================================
                   LOGIN CARD
                   ========================================= */

        .login-card {
            width: 100%;
            max-width: 430px;
            background: #FFFFFF;
            padding: 52px 45px 55px 45px;
            border-radius: 8px;
            border: none;
            box-shadow: 0 8px 25px rgba(17, 24, 39, 0.07);
            animation: fadeIn 0.6s ease forwards;
        }


            /* =========================================
                   TITLE
                   ========================================= */

            .login-card h2 {
                text-align: center;
                font-size: 27px;
                font-weight: 700;
                color: #111827;
                margin-bottom: 5px;
            }

        .subtitle {
            text-align: center;
            color: #6B7280;
            font-size: 13px;
            margin-bottom: 40px;
        }



        /* =========================================
                   LABEL
                   ========================================= */

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 7px;
        }


        /* =========================================
                   INPUT GROUP
                   ========================================= */

        .input-group-custom {
            position: relative;
            margin-bottom: 25px;
        }


            /* LEFT ICON */

            .input-group-custom .left-icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #9CA3AF;
                font-size: 16px;
                z-index: 2;
                transition: 0.2s ease;
            }


            /* RIGHT ICON */

            .input-group-custom .right-icon {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #6B7280;
                font-size: 16px;
                cursor: pointer;
                z-index: 2;
                transition: 0.2s ease;
            }

                .input-group-custom .right-icon:hover {
                    color: #991B1B;
                }


        /* =========================================
                   INPUT
                   ========================================= */

        .form-control-custom {
            width: 100%;
            height: 48px;
            background: #FFFFFF;
            border: 1px solid #D1D5DB;
            border-radius: 6px;
            padding-left: 44px;
            padding-right: 44px;
            color: #111827;
            font-size: 14px;
            outline: none;
            transition: all 0.2s ease;
        }

            .form-control-custom::placeholder {
                color: #9CA3AF;
            }

            .form-control-custom:hover {
                border-color: #9CA3AF;
            }

            .form-control-custom:focus {
                border-color: #B91C1C;
                box-shadow: 0 0 0 2px rgba(185, 28, 28, 0.10);
                background: #FFFFFF;
            }

        .input-group-custom:focus-within .left-icon {
            color: #B91C1C;
        }


        /* =========================================
                   LOGIN BUTTON
                   ========================================= */

        .btn-login {
            width: 100%;
            height: 58px;
            border: none;
            border-radius: 6px;
            background: #B91C1C;
            color: #FFFFFF;
            font-size: 17px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(185, 28, 28, 0.18);
        }


            .btn-login:hover {
                background: #991B1B;
                transform: translateY(-1px);
                box-shadow: 0 6px 15px rgba(153, 27, 27, 0.25);
            }


            .btn-login:active {
                background: #7F1D1D;
                transform: translateY(1px);
            }


        /* =========================================
                   ERROR MESSAGE
                   ========================================= */

        .error-message {
            background: #FEF2F2;
            border: 1px solid #FECACA;
            color: #B91C1C;
            text-align: center;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 18px;
            font-size: 12px;
            font-weight: 500;
        }


        /* =========================================
                   ANIMATION
                   ========================================= */

        @@keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================
                   RESPONSIVE
                   ========================================= */

        @@media (max-width: 991px) {

            body {
                overflow-y: auto;
            }

            .login-wrapper {
                flex-direction: column;
                height: auto;
                min-height: 100vh;
            }

            .left-side {
                width: 100%;
                height: auto;
                min-height: 420px;
                padding-top: 50px;
            }

            .right-side {
                width: 100%;
                height: auto;
                min-height: 550px;
                padding: 35px 20px;
            }

            .top-content img {
                width: 105px;
                height: 105px;
                margin-bottom: 25px;
            }

            .top-content h1 {
                font-size: 26px;
            }

            .login-card {
                max-width: 420px;
            }
        }


        /* =========================================
                   MOBILE
                   ========================================= */

        @@media (max-width: 576px) {

            .left-side {
                min-height: 350px;
                padding-top: 40px;
            }

            .top-content img {
                width: 90px;
                height: 90px;
                margin-bottom: 20px;
            }

            .top-content h1 {
                font-size: 22px;
            }

            .right-side {
                padding: 25px 15px;
            }

            .login-card {
                padding: 35px 25px 40px 25px;
            }

                .login-card h2 {
                    text-align: center;
                    font-size: 29px;
                    font-weight: 700;
                    color: #111827;
                    margin-bottom: 6px;
                }
        }

    </style>
</head>


<body>

    <div class="main-container">

        <div class="login-wrapper">


            <!-- =====================================
                 LEFT SIDE
                 ===================================== -->

            <div class="left-side">

                <div class="top-content">

                    <img src="~/Images/logo.png"
                         alt="Smart Office Records System Logo" />

                    <h1>
                        SMART OFFICE
                        <br />
                        RECORDS SYSTEM
                    </h1>

                </div>

            </div>


            <!-- =====================================
                 RIGHT SIDE
                 ===================================== -->

            <div class="right-side">

                <div class="login-card">


                    <!-- TITLE -->

                    <h2>
                        Welcome Back!
                    </h2>

                    <p class="subtitle">
                        Please sign in to continue.
                    </p>


                    <!-- ERROR -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="error-message">

                            <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error

                        </div>
                    }


                    <!-- LOGIN FORM -->
                    @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
                    {


                        <!-- USERNAME -->

                        <div class="mb-1">

                            <label class="form-label">
                                Username
                            </label>

                            <div class="input-group-custom">

                                <i class="bi bi-person left-icon"></i>

                                <input type="text"
                                       name="Username"
                                       class="form-control-custom"
                                       placeholder="Enter Username"
                                       required />

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="mb-1">

                            <label class="form-label">
                                Password
                            </label>

                            <div class="input-group-custom">

                                <i class="bi bi-lock left-icon"></i>

                                <input type="password"
                                       id="password"
                                       name="Password"
                                       class="form-control-custom"
                                       placeholder="Enter Password"
                                       required />

                                <i class="bi bi-eye right-icon"
                                   id="togglePassword"></i>

                            </div>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button type="submit"
                                class="btn-login">

                            Login

                        </button>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         PASSWORD TOGGLE
         ========================================= -->

    <script>

        const togglePassword =
            document.querySelector("#togglePassword");

        const password =
            document.querySelector("#password");


        togglePassword.addEventListener("click", function () {

            const type =
                password.getAttribute("type") === "password"
                    ? "text"
                    : "password";

            password.setAttribute("type", type);


            this.classList.toggle("bi-eye");

            this.classList.toggle("bi-eye-slash");

        });

    </script>

</body>
</html>