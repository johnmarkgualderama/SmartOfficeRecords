@{
    ViewBag.Title = "Create Request";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Request - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <style>

            /* =========================================================
                               GLOBAL
                            ========================================================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #F5F6F8;
                overflow: hidden;
            }


            /* =========================================================
                               MAIN CONTAINER
                            ========================================================= */

            .dashboard-container {
                display: flex;
                height: 100vh;
                width: 100%;
            }


            /* =========================================================
                               SIDEBAR
                            ========================================================= */

            .sidebar {
                width: 158px;
                min-width: 158px;
                height: 100vh;
                background: #1F2933;
                color: #FFFFFF;
                display: flex;
                flex-direction: column;
                transition: all .3s ease;
                overflow-y: auto;
                overflow-x: hidden;
            }


            /* =========================================================
                               SIDEBAR SCROLLBAR
                            ========================================================= */

            .sidebar {
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.25) transparent;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.25);
                    border-radius: 10px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }


                /* =========================================================
                               COLLAPSED SIDEBAR
                            ========================================================= */

                .sidebar.collapsed {
                    width: 78px;
                    min-width: 78px;
                }

                    .sidebar.collapsed .system-name {
                        display: block;
                        font-size: 10px;
                        font-weight: 600;
                        margin-top: 8px;
                    }

                    .sidebar.collapsed .logo-circle {
                        width: 42px;
                        height: 42px;
                    }

                    .sidebar.collapsed .logo-section {
                        padding: 18px 10px;
                    }

                    .sidebar.collapsed .menu a span,
                    .sidebar.collapsed .dropdown-toggle-menu span,
                    .sidebar.collapsed .logout a span {
                        display: none;
                    }

                    .sidebar.collapsed .menu {
                        padding: 15px 10px;
                    }

                        .sidebar.collapsed .menu a {
                            width: 42px;
                            height: 42px;
                            margin: 0 auto 10px auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            border-radius: 6px;
                        }

                            .sidebar.collapsed .menu a.active {
                                background: #B91C1C;
                                box-shadow: 0 4px 10px rgba(0,0,0,.15);
                            }

                            .sidebar.collapsed .menu a i,
                            .sidebar.collapsed .logout a i {
                                margin: 0;
                            }

                    .sidebar.collapsed .dropdown-toggle-menu {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                    .sidebar.collapsed .small-arrow {
                        display: none;
                    }

                    .sidebar.collapsed .dropdown-submenu {
                        display: none !important;
                    }

                    .sidebar.collapsed .logout {
                        padding-bottom: 15px;
                    }

                        .sidebar.collapsed .logout a {
                            width: 42px;
                            height: 42px;
                            margin: 0 auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                        }


            /* =========================================================
                               LOGO SECTION
                            ========================================================= */

            .logo-section {
                text-align: center;
                padding: 16px 10px;
                border-bottom: 1px solid rgba(255,255,255,.18);
            }

            .logo-circle {
                width: 40px;
                height: 40px;
                background: #FFFFFF;
                border-radius: 50%;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            .system-name {
                margin-top: 8px;
                font-size: 12px;
                font-weight: 600;
                color: #FFFFFF;
            }


            /* =========================================================
                               MENU
                            ========================================================= */

            .menu {
                padding: 14px 8px;
            }

                .menu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 8px 10px;
                    margin-bottom: 3px;
                    border-radius: 5px;
                    font-size: 11px;
                    font-weight: 500;
                    transition: all .2s ease;
                }

                    .menu a i {
                        font-size: 14px;
                        min-width: 14px;
                    }

                    /* HOVER */
                    .menu a:hover {
                        background: rgba(185, 28, 28, .18);
                        color: #FFFFFF;
                    }

                    /* ACTIVE */
                    .menu a.active {
                        background: #B91C1C;
                        color: #FFFFFF;
                        box-shadow: 0 3px 8px rgba(185,28,28,.22);
                    }


            /* =========================================================
                               SETTINGS DROPDOWN
                            ========================================================= */

            .sidebar-dropdown {
                margin-bottom: 3px;
            }

            .dropdown-toggle-menu {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                border-radius: 5px;
                cursor: pointer;
                font-size: 11px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .dropdown-toggle-menu:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

            .small-arrow {
                font-size: 8px;
                transition: transform .3s ease;
            }

            .dropdown-submenu {
                display: none;
                flex-direction: column;
                padding-left: 14px;
                margin-top: 3px;
            }

                .dropdown-submenu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 7px 9px;
                    font-size: 10px;
                    border-radius: 5px;
                }

                    .dropdown-submenu a:hover {
                        background: rgba(185,28,28,.18);
                        color: #FFFFFF;
                    }

            .sidebar-dropdown.open .dropdown-submenu {
                display: flex;
            }

            .sidebar-dropdown.open .small-arrow {
                transform: rotate(90deg);
            }


            /* =========================================================
                               LOGOUT
                            ========================================================= */

            .logout {
                margin-top: auto;
                padding: 10px 8px 12px 8px;
            }

                .logout a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    gap: 10px;
                    align-items: center;
                    padding: 8px 10px;
                    font-size: 11px;
                    font-weight: 500;
                    border-radius: 5px;
                    transition: all .2s ease;
                }

                    .logout a:hover {
                        background: rgba(185,28,28,.18);
                        color: #FFFFFF;
                    }


            /* =========================================================
                               MAIN CONTENT
                            ========================================================= */

            .main-content {
                flex: 1;
                background: #F5F6F8;
                display: flex;
                flex-direction: column;
                height: 100vh;
                overflow: hidden;
            }


            /* =========================================================
                               TOPBAR
                            ========================================================= */

            .topbar {
                height: 52px;
                min-height: 52px;
                flex-shrink: 0;
                border-bottom: 1px solid #E5E7EB;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 16px;
                background: #FFFFFF;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .menu-toggle {
                background: none;
                border: none;
                color: #B91C1C;
                font-size: 16px;
                cursor: pointer;
                padding: 4px;
            }


            /* =========================================================
                               TOPBAR RIGHT
                            ========================================================= */

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-left: auto;
            }

            .notification-icon {
                font-size: 17px;
                color: #374151;
                cursor: pointer;
                transition: color .2s ease;
            }

                .notification-icon:hover {
                    color: #B91C1C;
                }


            /* =========================================================
                               PROFILE
                            ========================================================= */

            .profile {
                display: flex;
                align-items: center;
                gap: 7px;
                padding-left: 8px;
                border-left: 1px solid #E5E7EB;
            }

                .profile img {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    object-fit: cover;
                }

            .profile-info {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

                .profile-info h5 {
                    margin: 0;
                    font-size: 10px;
                    font-weight: 600;
                    color: #111827;
                }

                .profile-info span {
                    font-size: 8px;
                    color: #6B7280;
                }

            .profile-arrow {
                color: #6B7280;
                font-size: 9px;
                margin-left: 2px;
            }


            /* =========================================================
                               CONTENT AREA
                            ========================================================= */

            .content-area {
                flex: 1;
                padding: 18px 28px;
                overflow-y: auto;
                overflow-x: hidden;
            }


            /* =========================================================
                               BREADCRUMB
                            ========================================================= */

            .breadcrumb-title {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 19px;
                font-weight: 700;
                margin: 0;
                padding: 0;
                color: #111827;
                line-height: 1.3;
            }

            .rcreate-breadcrumb {
                text-decoration: none;
                color: #9CA3AF;
                transition: .2s ease;
            }

                .rcreate-breadcrumb:hover {
                    color: #B91C1C;
                }

            .breadcrumb-title strong {
                color: #E32626;
                font-weight: 700;
            }


            /* =========================================================
                               PAGE DESCRIPTION
                            ========================================================= */

            .page-description {
                color: #64748B;
                font-size: 10px;
                font-weight: 400;
                margin: 3px 0 20px 0;
                padding: 0;
                line-height: 1.4;
            }

            /* =========================================================
                               REQUEST CARD
                            ========================================================= */

            .request-card {
                width: 100%;
                background: #FFFFFF;
                border: 1px solid #E5E7EB;
                border-radius: 9px;
                padding: 15px 14px 20px 14px;
                min-height: 520px;
                box-shadow: 0 3px 12px rgba(0,0,0,.04);
            }


            /* =========================================================
                               REQUEST FORM HEADER
                            ========================================================= */

            .form-header {
                display: flex;
                align-items: center;
                gap: 10px;
                padding-bottom: 13px;
                border-bottom: 1px solid #E5E7EB;
                margin-bottom: 10px;
            }

            .form-header-icon {
                width: 25px;
                height: 25px;
                border: 2px solid #374151;
                border-radius: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #374151;
                font-size: 14px;
            }

            .form-header h3 {
                margin: 0;
                font-size: 13px;
                font-weight: 700;
                color: #374151;
            }


            /* =========================================================
                               SECTION TITLE
                            ========================================================= */

            .section-title {
                font-size: 12px;
                font-weight: 600;
                color: #EF4444;
                margin: 8px 0 14px 0;
            }


            /* =========================================================
                               FORM GRID
                            ========================================================= */

            .request-form {
                display: grid;
                grid-template-columns: 1fr 1fr;
                column-gap: 38px;
                row-gap: 14px;
            }


            /* =========================================================
                               FORM GROUP
                            ========================================================= */

            .form-group {
                width: 100%;
            }

                .form-group label {
                    display: block;
                    font-size: 11px;
                    font-weight: 600;
                    color: #374151;
                    margin-bottom: 7px;
                }

                    .form-group label .required-star {
                        color: #EF4444;
                    }

                    .form-group label .optional-text {
                        color: #9CA3AF;
                        font-size: 10px;
                        font-weight: 500;
                    }


            /* =========================================================
                               INPUT WRAPPER
                            ========================================================= */

            .input-wrapper {
                position: relative;
                width: 100%;
            }

            .input-icon {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: #9CA3AF;
                font-size: 13px;
                pointer-events: none;
            }


            /* =========================================================
                               INPUT
                            ========================================================= */

            .form-control-custom {
                width: 100%;
                height: 38px;
                border: 1px solid #D1D5DB;
                border-radius: 6px;
                padding: 0 12px 0 36px;
                outline: none;
                font-size: 11px;
                color: #374151;
                background: #FFFFFF;
                transition: all .2s ease;
                box-shadow: 0 2px 5px rgba(0,0,0,.08);
            }

                .form-control-custom:focus {
                    border-color: #B91C1C;
                    box-shadow: 0 0 0 2px rgba(185,28,28,.08);
                }

                .form-control-custom::placeholder {
                    color: #9CA3AF;
                }

            select.form-control-custom {
                appearance: auto;
            }

            .form-control-custom[type="date"] {
                color: #9CA3AF;
            }


            /* =========================================================
                               TEXTAREA
                            ========================================================= */

            .description-group {
                grid-column: 1 / -1;
            }

            .description-box {
                width: 100%;
                height: 100px;
                border: 1px solid #D1D5DB;
                border-radius: 6px;
                padding: 9px 11px;
                resize: none;
                outline: none;
                font-size: 11px;
                color: #374151;
                box-shadow: 0 2px 5px rgba(0,0,0,.08);
            }

                .description-box:focus {
                    border-color: #B91C1C;
                    box-shadow: 0 0 0 2px rgba(185,28,28,.08);
                }

                .description-box::placeholder {
                    color: #9CA3AF;
                }


            /* =========================================================
                               BUTTON SECTION
                            ========================================================= */

            .button-section {
                margin-top: 30px;
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 10px;
            }

            .cancel-btn {
                width: 180px;
                height: 38px;
                border: 1px solid #EF1C24;
                border-radius: 6px;
                background: #FFFFFF;
                color: #EF1C24;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                transition: all .2s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
            }

                .cancel-btn:hover {
                    background: #FEF2F2;
                    border-color: #B91C1C;
                    color: #B91C1C;
                }

            .submit-btn {
                width: 180px;
                height: 38px;
                border: none;
                border-radius: 6px;
                background: #EF1C24;
                color: #FFFFFF;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 3px 8px rgba(239,28,36,.20);
                transition: all .2s ease;
            }

                .submit-btn:hover {
                    background: #B91C1C;
                    transform: translateY(-1px);
                    box-shadow: 0 5px 12px rgba(185,28,28,.25);
                }


            /* =========================================================
                               RESPONSIVE
                            ========================================================= */

            @@media (max-width: 900px) {

                .request-form {
                    grid-template-columns: 1fr;
                }

                .description-group {
                    grid-column: 1;
                }

                .button-section {
                    margin-top: 30px;
                }
            }


            @@media (max-width: 768px) {

                body {
                    overflow-y: auto;
                }

                .sidebar {
                    width: 78px;
                    min-width: 78px;
                }

                .system-name,
                .menu a span,
                .dropdown-toggle-menu span,
                .logout a span {
                    display: none;
                }

                .logo-section {
                    padding: 18px 10px;
                }

                .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .menu {
                    padding: 15px 10px;
                }

                    .menu a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        justify-content: center;
                    }

                .dropdown-toggle-menu {
                    width: 42px;
                    height: 42px;
                    margin: 0 auto 10px auto;
                    padding: 0;
                    justify-content: center;
                }

                .small-arrow {
                    display: none;
                }

                .logout a {
                    width: 42px;
                    height: 42px;
                    margin: 0 auto;
                    padding: 0;
                    justify-content: center;
                }

                .content-area {
                    padding: 14px;
                }

                .request-card {
                    padding: 14px;
                }

                .button-section {
                    justify-content: center;
                }
            }


            @@media (max-width: 500px) {

                .profile-info {
                    display: none;
                }

                .profile-arrow {
                    display: none;
                }

                .button-section {
                    flex-direction: column;
                }

                .cancel-btn,
                .submit-btn {
                    width: 100%;
                }
            }
    </style>

</head>


<body>

    <div class="dashboard-container">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/logo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>


            <!-- MENU -->

            <div class="menu">


                <!-- DASHBOARD -->

                <a href="@Url.Action("Dashboard", "Admin")">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- REQUEST -->

                <a href="@Url.Action("RequestManagement", "Admin")"
                   class="active">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Request
                    </span>

                </a>


                <!-- RECORDS -->

                <a href="@Url.Action("RecordsManagement", "Admin")">

                    <i class="bi bi-folder2-open"></i>

                    <span>
                        Records
                    </span>

                </a>


                <!-- REPORTS -->

                <a href="@Url.Action("ReportsManagement", "Admin")">

                    <i class="bi bi-clipboard-data"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- USERS -->

                <a href="@Url.Action("UsersManagement", "Admin")">

                    <i class="bi bi-people"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- SETTINGS -->

                <div class="sidebar-dropdown">

                    <a href="javascript:void(0)"
                       class="dropdown-toggle-menu">

                        <i class="bi bi-gear"></i>

                        <span>
                            Settings
                        </span>

                        <i class="bi bi-caret-down-fill ms-auto small-arrow"></i>

                    </a>


                    <div class="dropdown-submenu">

                        <a href="@Url.Action("Settings", "Admin")">

                            <i class="bi bi-sliders"></i>

                            <span>
                                General Settings
                            </span>

                        </a>


                        <a href="#">

                            <i class="bi bi-person-gear"></i>

                            <span>
                                Account & Security
                            </span>

                        </a>

                    </div>

                </div>


            </div>


            <!-- LOGOUT -->

            <div class="logout">

                <a href="@Url.Action("Login", "Admin")">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>


        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <div class="main-content">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <div class="topbar">


                <!-- LEFT -->

                <div class="topbar-left">

                    <button class="menu-toggle"
                            id="menuToggle">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <!-- RIGHT -->

                <div class="topbar-right">


                    <!-- NOTIFICATION -->

                    <i class="bi bi-bell-fill notification-icon"></i>


                    <!-- PROFILE -->

                    <div class="profile">

                        <img src="~/Images/adminpic.jpg"
                             alt="Profile" />

                        <div class="profile-info">

                            <h5>
                                Juan Dela Cruz
                            </h5>

                            <span>
                                Administrator
                            </span>

                        </div>

                        <i class="bi bi-chevron-down profile-arrow"></i>

                    </div>

                </div>


            </div>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="content-area">

                <!-- =================================================
                              BREADCRUMB
                ================================================== -->

                <div class="breadcrumb-title">

                    <a href="@Url.Action("RequestManagement", "Admin")"
                       class="rcreate-breadcrumb">

                        Request

                    </a>

                    <span>
                        ›
                    </span>

                    <strong>
                        Create Request
                    </strong>

                </div>

                <p class="page-description">
                    Submit a new request and provide the necessary details.
                </p>


                <!-- =================================================
                     REQUEST CARD
                ================================================== -->

                <div class="request-card">


                    <!-- FORM HEADER -->

                    <div class="form-header">

                        <div class="form-header-icon">

                            <i class="bi bi-list-check"></i>

                        </div>

                        <h3>
                            Request Form
                        </h3>

                    </div>


                    <!-- FORM -->

                    @using (Html.BeginForm("RCreateRequest", "Admin", FormMethod.Post))
                    {

                        <div class="request-form">


                            <!-- =================================================
                             POSITION TYPE
                        ================================================== -->

                            <div class="form-group">

                                <label>
                                    Position Type <span class="required-star">*</span>
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-briefcase input-icon"></i>

                                    <select class="form-control-custom" name="PositionType" required>

                                        <option value="">Select position type</option>
                                        <option value="Customer Service Representative">Customer Service Representative</option>
                                        <option value="Office Staff">Office Staff</option>
                                        <option value="Back Office">Back Office</option>
                                        <option value="Data Encoder">Data Encoder</option>
                                        <option value="Data Input Specialist">Data Input Specialist</option>

                                    </select>

                                </div>

                            </div>


                            <!-- =================================================
                             REQUEST TYPE
                        ================================================== -->

                            <div class="form-group">

                                <label>
                                    Request Type <span class="required-star">*</span>
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-tag input-icon"></i>

                                    <select class="form-control-custom" name="RequestType" required>

                                        <option value="">Select request type</option>

                                    </select>

                                </div>

                            </div>


                            <!-- =================================================
                             TITLE
                        ================================================== -->

                            <div class="form-group">

                                <label>
                                    Title <span class="required-star">*</span>
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-card-text input-icon"></i>

                                    <input type="text"
                                           class="form-control-custom"
                                           name="Title"
                                           placeholder="Enter request title"
                                           required />

                                </div>

                            </div>


                            <!-- =================================================
                             PREFERRED DATE
                        ================================================== -->

                            <div class="form-group">

                                <label>
                                    Preferred Date <span class="required-star">*</span>
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-calendar3 input-icon"></i>

                                    <input type="date"
                                           class="form-control-custom"
                                           name="PreferredDate"
                                           required />

                                </div>

                            </div>


                            <!-- =================================================
                             DESCRIPTION
                        ================================================== -->

                            <div class="form-group description-group">

                                <label>
                                    Description
                                    <span class="optional-text">(Optional)</span>
                                </label>

                                <textarea class="description-box"
                                          name="Description"
                                          placeholder="Provide details of your request..."></textarea>

                            </div>
                        </div>

                        <!-- =================================================
                         BUTTONS
                    ================================================== -->

                        <div class="button-section">


                            <a href="@Url.Action("RequestManagement", "Admin")"
                               class="cancel-btn">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="submit-btn">

                                Submit Request

                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>


            /* =====================================================
               SETTINGS DROPDOWN
            ===================================================== */

            const dropdown =
                document.querySelector('.sidebar-dropdown');

            const dropdownToggle =
                document.querySelector('.dropdown-toggle-menu');


            dropdownToggle.addEventListener('click', function () {

                dropdown.classList.toggle('open');

            });


            /* =====================================================
               SIDEBAR COLLAPSE
            ===================================================== */

            const sidebar =
                document.querySelector('.sidebar');

            const menuToggle =
                document.getElementById('menuToggle');


            menuToggle.addEventListener('click', function () {

                sidebar.classList.toggle('collapsed');

            });


    </script>


</body>
</html>