@model SmartOfficeRecords.Models.Appointment
@{
    ViewBag.Title = "Applicant Details";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Applicant Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="p-4">

    <div class="container">
        <h3>Applicant Booking Details</h3>

        <table class="table table-bordered mt-3">
            <tr><th>Full Name</th><td>@Model.Applicant?.FullName</td></tr>
            <tr><th>Email</th><td>@Model.Applicant?.Email</td></tr>
            <tr><th>Contact Number</th><td>@Model.ContactNumber</td></tr>
            <tr><th>Purpose</th><td>@Model.Purpose</td></tr>
            <tr><th>Appointment Date</th><td>@Model.AppointmentDate.</td></tr>
            <tr><th>Appointment Time</th><td>@DateTime.Today.Add(Model.AppointmentTime).</td></tr>
            <tr><th>Status</th><td>@Model.Status</td></tr>
            <tr><th>Additional Notes</th><td>@Model.AdditionalNotes</td></tr>
            <tr>
                <th>Resume</th>
                <td>
                    @if (!string.IsNullOrEmpty(Model.ResumeFile))
                    {
                        <a href="~/Resumes/@Model.ResumeFile" target="_blank">View Resume</a>
                    }
                    else
                    {
                        <span class="text-muted">Not uploaded</span>
                    }
                </td>
            </tr>
            <tr>
                <th>Valid ID</th>
                <td>
                    @if (!string.IsNullOrEmpty(Model.ValidIDFile))
                    {
                        <a href="~/ValidIDs/@Model.ValidIDFile" target="_blank">View Valid ID</a>
                    }
                    else
                    {
                        <span class="text-muted">Not uploaded</span>
                    }
                </td>
            </tr>
        </table>

        <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</body>
</html>