@{
    ViewBag.Title = "Records Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Records Management</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Inter Font - SAME AS REQUEST -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: #F5F6F8;
            overflow: hidden;
            color: #111827;
        }

        .dashboard-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }

        /* SIDEBAR */

        .sidebar {
            width: 158px;
            min-width: 158px;
            height: 100vh;
            background: #1F2933;
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            transition: all .3s ease;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.25) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar.collapsed {
                width: 78px;
                min-width: 78px;
            }

                .sidebar.collapsed .system-name {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    margin-top: 8px;
                    letter-spacing: .2px;
                }

                .sidebar.collapsed .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .sidebar.collapsed .logo-section {
                    padding: 18px 10px;
                }

                .sidebar.collapsed .menu a span,
                .sidebar.collapsed .logout a span {
                    display: none;
                }

                .sidebar.collapsed .menu {
                    padding: 16px 10px;
                }

                    .sidebar.collapsed .menu a {
                        width: 44px;
                        height: 44px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                        .sidebar.collapsed .menu a.active {
                            background: #B91C1C;
                            box-shadow: 0 4px 10px rgba(0,0,0,.15);
                        }

                        .sidebar.collapsed .menu a i,
                        .sidebar.collapsed .logout a i {
                            margin: 0;
                            font-size: 17px;
                        }

                .sidebar.collapsed .logout {
                    padding-bottom: 15px;
                }

                    .sidebar.collapsed .logout a {
                        width: 44px;
                        height: 44px;
                        margin: 0 auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }

        .logo-section {
            text-align: center;
            padding: 18px 10px;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .logo-circle {
            width: 42px;
            height: 42px;
            background: #FFFFFF;
            border-radius: 50%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .system-name {
            margin-top: 9px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .3px;
            color: #FFFFFF;
        }

        /* MENU */

        .menu {
            padding: 16px 9px;
        }

            .menu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 10px 11px;
                margin-bottom: 5px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                line-height: 1.2;
                transition: all .2s ease;
            }

                .menu a i {
                    font-size: 16px;
                    min-width: 16px;
                }

                .menu a:hover {
                    background: rgba(185, 28, 28, .18);
                    color: #FFFFFF;
                }

                .menu a.active {
                    background: #B91C1C;
                    color: #FFFFFF;
                    box-shadow: 0 3px 8px rgba(185,28,28,.22);
                }

        /* SETTINGS + LOGOUT */

        .logout {
            margin-top: auto;
            padding: 12px 9px 15px 9px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .logout a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                gap: 11px;
                align-items: center;
                padding: 10px 11px;
                font-size: 13px;
                font-weight: 500;
                border-radius: 6px;
                transition: all .2s ease;
            }

                .logout a i {
                    font-size: 16px;
                    min-width: 16px;
                }

        .settings-link:hover {
            background: rgba(185, 28, 28, .18);
            color: #FFFFFF;
        }

        .logout-link:hover {
            background: rgba(185,28,28,.25);
            color: #FFFFFF;
        }

        /* MAIN CONTENT */

        .main-content {
            flex: 1;
            background: #F5F6F8;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        .topbar {
            height: 56px;
            min-height: 56px;
            flex-shrink: 0;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            background: #FFFFFF;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: #B91C1C;
            font-size: 19px;
            cursor: pointer;
            padding: 5px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-left: auto;
        }

        .notification-icon {
            font-size: 19px;
            color: #374151;
            cursor: pointer;
            transition: color .2s ease;
        }

            .notification-icon:hover {
                color: #B91C1C;
            }

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding-left: 12px;
            border-left: 1px solid #E5E7EB;
        }

            .profile img {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                object-fit: cover;
            }

        .profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.25;
        }

            .profile-info h5 {
                margin: 0;
                font-size: 12px;
                font-weight: 600;
                color: #111827;
            }

            .profile-info span {
                font-size: 10px;
                color: #6B7280;
                margin-top: 2px;
            }

        .profile-arrow {
            color: #6B7280;
            font-size: 10px;
            margin-left: 3px;
        }

        /* CONTENT AREA */

        .content-area {
            flex: 1;
            padding: 22px 30px;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: #C7CBD1 transparent;
        }

            .content-area::-webkit-scrollbar {
                width: 6px;
            }

            .content-area::-webkit-scrollbar-thumb {
                background: #C7CBD1;
                border-radius: 10px;
            }

            .content-area::-webkit-scrollbar-track {
                background: transparent;
            }

        /* PAGE HEADER */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 18px;
        }

        .page-title {
            color: #B91C1C;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.2px;
            margin: 0 0 5px 0;
            line-height: 1.2;
        }

        .page-description {
            color: #64748B;
            font-size: 13px;
            font-weight: 400;
            margin: 0;
            line-height: 1.5;
        }

        /* ACTION BAR */

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .search-filter {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }

        .search-box {
            height: 36px;
            flex: 1;
            max-width: 540px;
            background: #FFFFFF;
            border-radius: 20px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 3px 12px rgba(0,0,0,.05);
            display: flex;
            align-items: center;
            padding: 0 13px;
            gap: 9px;
        }

            .search-box i {
                color: #6B7280;
                font-size: 13px;
            }

            .search-box input {
                width: 100%;
                border: none;
                outline: none;
                font-size: 11px;
                color: #374151;
                background: transparent;
                font-weight: 400;
            }

                .search-box input::placeholder {
                    color: #9CA3AF;
                }

        .upload-btn {
            height: 36px;
            border: none;
            border-radius: 6px;
            background: #B91C1C;
            color: #FFFFFF;
            padding: 0 16px;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
            transition: all .2s ease;
            text-decoration: none;
            white-space: nowrap;
        }

            .upload-btn:hover {
                background: #991B1B;
                color: #FFFFFF;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(185,28,28,.20);
            }

            .upload-btn i {
                font-size: 13px;
            }

        /* TABLE */

        .table-container {
            background: #FFFFFF;
            border: 1px solid #D9DDE3;
            border-radius: 8px;
            overflow-x: auto;
            overflow-y: hidden;
            box-shadow: 0 1px 2px rgba(0,0,0,.02);
        }

            .table-container::-webkit-scrollbar {
                height: 6px;
            }

            .table-container::-webkit-scrollbar-thumb {
                background: #C7CBD1;
                border-radius: 10px;
            }

            .table-container::-webkit-scrollbar-track {
                background: transparent;
            }

        .records-table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
            margin: 0;
            table-layout: fixed;
        }

            .records-table th:nth-child(1),
            .records-table td:nth-child(1) {
                width: 10%;
            }

            .records-table th:nth-child(2),
            .records-table td:nth-child(2) {
                width: 21%;
            }

            .records-table th:nth-child(3),
            .records-table td:nth-child(3) {
                width: 23%;
            }

            .records-table th:nth-child(4),
            .records-table td:nth-child(4) {
                width: 15%;
            }

            .records-table th:nth-child(5),
            .records-table td:nth-child(5) {
                width: 31%;
            }

            .records-table thead {
                background: #111111;
            }

            .records-table th {
                height: 40px;
                padding: 0 12px;
                font-size: 10px;
                font-weight: 700;
                color: #FFFFFF;
                background: #111111;
                border-bottom: 1px solid #111111;
                white-space: nowrap;
                letter-spacing: .15px;
                vertical-align: middle;
            }

                .records-table th:nth-child(1) {
                    text-align: center;
                }

                .records-table th:nth-child(2),
                .records-table th:nth-child(3) {
                    text-align: left;
                }

                .records-table th:nth-child(4),
                .records-table th:nth-child(5) {
                    text-align: center;
                }

            .records-table td {
                height: 42px;
                padding: 0 12px;
                font-size: 10px;
                font-weight: 500;
                color: #374151;
                background: #FFFFFF;
                border-bottom: 1px solid #E5E7EB;
                white-space: nowrap;
                vertical-align: middle;
            }

                .records-table td:nth-child(1) {
                    text-align: center;
                    font-weight: 600;
                    color: #4B5563;
                }

                .records-table td:nth-child(2),
                .records-table td:nth-child(3) {
                    text-align: left;
                }

                .records-table td:nth-child(4),
                .records-table td:nth-child(5) {
                    text-align: center;
                }

            .records-table tbody tr:hover td {
                background: #FEF2F2;
            }

            .records-table tbody tr:last-child td {
                border-bottom: none;
            }

        /* STATUS BADGES — matches RequestManagement's status palette */

        .category-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 70px;
            padding: 5px 9px;
            border-radius: 5px;
            font-size: 9px;
            font-weight: 600;
            line-height: 1;
        }

        .status-completed {
            background: #DCFCE7;
            color: #15803D;
        }

        .status-pending {
            background: #FEF3C7;
            color: #D97706;
        }

        .status-rejected {
            background: #FEE2E2;
            color: #B91C1C;
        }

        .status-archived {
            background: #E5E7EB;
            color: #4B5563;
        }

        /* ACTION ICONS */

        .record-actions {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            width: 100%;
        }

        .record-action {
            width: 28px;
            height: 28px;
            border: none;
            border-radius: 5px;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s ease;
        }

            .record-action i {
                font-size: 12px;
            }

        .download-action {
            color: #374151;
        }

            .download-action:hover {
                background: #FEE2E2;
                color: #B91C1C;
            }

        .archive-action {
            color: #374151;
        }

            .archive-action:hover {
                background: #FEF3C7;
                color: #D97706;
            }

        /* EMPTY STATE */

        .empty-row td {
            text-align: center;
            padding: 34px 14px !important;
            color: #9CA3AF;
            font-size: 12px;
        }

        /* PAGINATION */

        .pagination-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 18px;
            width: 100%;
        }

        .showing-text {
            font-size: 10px;
            color: #374151;
            font-weight: 500;
        }

        .pagination-buttons {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pagination-btn {
            height: 28px;
            padding: 0 12px;
            border: 1px solid #E5E7EB;
            background: #FFFFFF;
            border-radius: 5px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #6B7280;
            font-size: 9px;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s ease;
            text-decoration: none;
        }

            .pagination-btn:hover {
                background: #FEE2E2;
                color: #B91C1C;
                border-color: #FECACA;
            }

            .pagination-btn.disabled {
                background: #F3F4F6;
                color: #9CA3AF;
                pointer-events: none;
            }

            .pagination-btn.next-btn {
                background: #B91C1C;
                color: #FFFFFF;
                border-color: #B91C1C;
            }

                .pagination-btn.next-btn:hover {
                    background: #991B1B;
                    color: #FFFFFF;
                }

        /* RESPONSIVE */

        @@media (max-width: 1000px) {

            .action-bar {
                flex-wrap: wrap;
            }

            .search-filter {
                width: 100%;
            }

            .search-box {
                max-width: none;
            }

            .upload-btn {
                margin-left: auto;
            }
        }

        @@media (max-width: 768px) {

            body {
                overflow-y: auto;
            }

            .sidebar {
                width: 78px;
                min-width: 78px;
            }

            .system-name,
            .menu a span,
            .logout a span {
                display: none;
            }

            .logo-section {
                padding: 15px 8px;
            }

            .logo-circle {
                width: 40px;
                height: 40px;
            }

            .menu {
                padding: 15px 8px;
            }

                .menu a {
                    justify-content: center;
                    padding: 10px;
                }

            .logout a {
                justify-content: center;
            }

            .content-area {
                padding: 16px;
            }

            .page-title {
                font-size: 21px;
            }

            .page-description {
                font-size: 12px;
            }

            .page-header {
                margin-bottom: 16px;
            }

            .action-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-filter {
                width: 100%;
                flex-direction: column;
            }

            .search-box {
                width: 100%;
                max-width: none;
            }

            .upload-btn {
                width: 100%;
                justify-content: center;
                margin-left: 0;
            }

            .table-container {
                overflow-x: auto;
            }

            .records-table {
                min-width: 900px;
            }

            .pagination-section {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .pagination-buttons {
                align-self: flex-end;
            }
        }

        @@media (max-width: 500px) {

            .profile-info {
                display: none;
            }

            .profile {
                border-left: none;
            }

            .content-area {
                padding: 12px;
            }
        }

    </style>

</head>


<body>

    <div class="dashboard-container">


        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="logo-section">

                <div class="logo-circle">
                    <img src="~/Images/newlogo.png" class="logo-img" alt="SORS Logo" />
                </div>

                <div class="system-name">SORS</div>

            </div>

            <div class="menu">

                <a href="@Url.Action("Dashboard", "Admin")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("RequestManagement", "Admin")">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Request</span>
                </a>

                <a href="@Url.Action("RecordsManagement", "Admin")" class="active">
                    <i class="bi bi-folder2-open"></i>
                    <span>Records</span>
                </a>

                <a href="@Url.Action("ReportsManagement", "Admin")">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>
                </a>

                <a href="@Url.Action("AuditLogs", "Admin")">
                    <i class="bi bi-clock-history"></i>
                    <span>Audit Logs</span>
                </a>

                <a href="@Url.Action("UsersManagement", "Admin")">
                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>
                </a>

            </div>

            <div class="logout">

                <a href="@Url.Action("Settings", "Admin")" class="settings-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>

                <a href="@Url.Action("Login", "Admin")" class="logout-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>

            </div>

        </aside>


        <!-- MAIN CONTENT -->

        <div class="main-content">

            <div class="topbar">

                <div class="topbar-left">
                    <button class="menu-toggle" id="menuToggle" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="topbar-right">

                    <i class="bi bi-bell notification-icon"></i>

                    <div class="profile">
                        <img src="~/Images/adminpic.jpg" alt="Profile" />
                        <div class="profile-info">
                            <h5>@(Context.Session.GetString("AdminName") ?? "Admin")</h5>
                            <span>Administrator</span>
                        </div>
                        <i class="bi bi-chevron-down profile-arrow"></i>
                    </div>

                </div>

            </div>


            <div class="content-area">

                @{
                    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
                    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
                    int totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : (ViewBag.Records != null ? ViewBag.Records.Count : 0);
                    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 5;

                    int startItem = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
                    int endItem = Math.Min(currentPage * pageSize, totalCount);
                }

                <!-- PAGE HEADER -->

                <div class="page-header">
                    <div>
                        <h2 class="page-title">Records</h2>
                        <p class="page-description">Manage, organize, and keep office records up to date.</p>
                    </div>
                </div>


                <!-- ACTION BAR -->

                @using (Html.BeginForm("RecordsManagement", "Admin", FormMethod.Get))
                {
                    <div class="action-bar">

                        <div class="search-filter">
                            <div class="search-box">
                                <i class="bi bi-search"></i>
                                <input type="text"
                                       name="search"
                                       value="@ViewBag.SearchTerm"
                                       placeholder="Search here..."
                                       onchange="this.form.submit()" />
                            </div>
                        </div>

                        <a href="@Url.Action("UploadFiles", "Admin")" class="upload-btn">
                            <i class="bi bi-plus-lg"></i>
                            Upload Records
                        </a>

                    </div>
                }


                <!-- TABLE -->

                <div class="table-container">

                    <table class="records-table">

                        <thead>
                            <tr>
                                <th>RECORDS ID</th>
                                <th>NAME</th>
                                <th>STATUS</th>
                                <th>DATE APPLIED</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>

                        <tbody id="recordsTableBody">

                            @if (ViewBag.Records == null || ViewBag.Records.Count == 0)
                            {
                                <tr class="empty-row">
                                    <td colspan="5">No completed records yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var record in ViewBag.Records)
                                {
                                    string statusText = record.Status != null ? record.Status.ToString() : "";
                                    string statusKey = statusText.ToLower();
                                    string statusClass = statusKey.Contains("pending") ? "status-pending"
                                                        : (statusKey.Contains("reject") || statusKey.Contains("declin")) ? "status-rejected"
                                                        : statusKey.Contains("archiv") ? "status-archived"
                                                        : "status-completed";

                                    <tr>

                                        <td>@record.RecordId</td>
                                        <td>@record.ApplicantName</td>

                                        <td>
                                            <span class="category-badge @statusClass">@statusText</span>
                                        </td>

                                        <td>@record.AppointmentDateFormatted</td>

                                        <td>
                                            <div class="record-actions">

                                                <button class="record-action download-action" title="Download" type="button">
                                                    <i class="bi bi-download"></i>
                                                </button>

                                                <button class="record-action archive-action" title="Archive" type="button">
                                                    <i class="bi bi-archive"></i>
                                                </button>

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>


                <!-- PAGINATION -->

                <div class="pagination-section">

                    <div class="showing-text" id="showingText">
                        Showing @startItem to @endItem of @totalCount records
                    </div>

                    <div class="pagination-buttons">

                        @if (currentPage <= 1)
                        {
                            <span class="pagination-btn disabled">Previous</span>
                        }
                        else
                        {
                            <a href="@Url.Action("RecordsManagement", "Admin", new { search = ViewBag.SearchTerm, page = currentPage - 1 })" class="pagination-btn">Previous</a>
                        }

                        @if (currentPage >= totalPages)
                        {
                            <span class="pagination-btn next-btn disabled">Next</span>
                        }
                        else
                        {
                            <a href="@Url.Action("RecordsManagement", "Admin", new { search = ViewBag.SearchTerm, page = currentPage + 1 })" class="pagination-btn next-btn">Next</a>
                        }

                    </div>

                </div>


            </div>

        </div>

    </div>


    <!-- JAVASCRIPT -->

    <script>

        const sidebar = document.querySelector('.sidebar');
        const menuToggle = document.getElementById('menuToggle');

        menuToggle.addEventListener('click', function () {
            sidebar.classList.toggle('collapsed');
        });

    </script>


</body>
</html>
