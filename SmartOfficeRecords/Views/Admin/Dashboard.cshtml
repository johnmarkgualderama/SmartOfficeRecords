@{
    ViewBag.Title = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: #F5F6F8;
            overflow: hidden;
            color: #111827;
        }


        /* =========================================================
                   MAIN CONTAINER
                ========================================================= */

        .dashboard-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar {
            width: 158px;
            min-width: 158px;
            height: 100vh;
            background: #1F2933;
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            transition: all .3s ease;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar {
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.25) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }


            /* =========================================================
                   COLLAPSED SIDEBAR
                ========================================================= */

            .sidebar.collapsed {
                width: 78px;
                min-width: 78px;
            }

                .sidebar.collapsed .system-name {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    margin-top: 8px;
                    letter-spacing: .2px;
                }

                .sidebar.collapsed .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .sidebar.collapsed .logo-section {
                    padding: 18px 10px;
                }

                .sidebar.collapsed .menu a span,
                .sidebar.collapsed .logout a span {
                    display: none;
                }

                .sidebar.collapsed .menu {
                    padding: 16px 10px;
                }

                    .sidebar.collapsed .menu a {
                        width: 44px;
                        height: 44px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                        .sidebar.collapsed .menu a.active {
                            background: #B91C1C;
                            box-shadow: 0 4px 10px rgba(0,0,0,.15);
                        }

                        .sidebar.collapsed .menu a i,
                        .sidebar.collapsed .logout a i {
                            margin: 0;
                            font-size: 17px;
                        }

                .sidebar.collapsed .logout {
                    padding-bottom: 15px;
                    gap: 8px;
                }

                    .sidebar.collapsed .logout a {
                        width: 44px;
                        height: 44px;
                        margin: 0 auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }


        /* =========================================================
                   LOGO SECTION
                ========================================================= */

        .logo-section {
            text-align: center;
            padding: 18px 10px;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .logo-circle {
            width: 42px;
            height: 42px;
            background: #FFFFFF;
            border-radius: 50%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .system-name {
            margin-top: 9px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .3px;
            color: #FFFFFF;
        }


        /* =========================================================
                   MENU
                ========================================================= */

        .menu {
            padding: 16px 9px;
        }

            .menu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 10px 11px;
                margin-bottom: 5px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                line-height: 1.2;
                transition: all .2s ease;
            }

                .menu a i {
                    font-size: 16px;
                    min-width: 16px;
                }

                .menu a:hover {
                    background: rgba(185, 28, 28, .18);
                    color: #FFFFFF;
                }

                .menu a.active {
                    background: #B91C1C;
                    color: #FFFFFF;
                    box-shadow: 0 3px 8px rgba(185,28,28,.22);
                }


        /* =========================================================
                   SETTINGS + LOGOUT
                ========================================================= */

        .logout {
            margin-top: auto;
            padding: 12px 9px 15px 9px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .logout a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                gap: 11px;
                align-items: center;
                padding: 10px 11px;
                font-size: 13px;
                font-weight: 500;
                border-radius: 6px;
                transition: all .2s ease;
            }

                .logout a i {
                    font-size: 16px;
                    min-width: 16px;
                }

        .settings-link:hover {
            background: rgba(185, 28, 28, .18);
            color: #FFFFFF;
        }

        .logout-link:hover {
            background: rgba(185,28,28,.25);
            color: #FFFFFF;
        }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            flex: 1;
            background: #F5F6F8;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }


        /* =========================================================
                   TOPBAR
                ========================================================= */

        .topbar {
            height: 56px;
            min-height: 56px;
            flex-shrink: 0;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            background: #FFFFFF;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: #B91C1C;
            font-size: 19px;
            cursor: pointer;
            padding: 5px;
        }


        /* =========================================================
                   TOPBAR RIGHT
                ========================================================= */

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-left: auto;
        }

        .notification-icon {
            font-size: 19px;
            color: #374151;
            cursor: pointer;
            transition: color .2s ease;
        }

            .notification-icon:hover {
                color: #B91C1C;
            }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding-left: 12px;
            border-left: 1px solid #E5E7EB;
        }

            .profile img {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                object-fit: cover;
            }

        .profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.25;
        }

            .profile-info h5 {
                margin: 0;
                font-size: 12px;
                font-weight: 600;
                color: #111827;
            }

            .profile-info span {
                font-size: 10px;
                color: #6B7280;
                margin-top: 2px;
            }

        .profile-arrow {
            color: #6B7280;
            font-size: 10px;
            margin-left: 3px;
        }


        /* =========================================================
                   CONTENT AREA
                ========================================================= */

        .content-area {
            flex: 1;
            padding: 22px 30px;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* =========================================================
                   WELCOME SECTION
                ========================================================= */

        .welcome-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 18px;
        }

        .welcome-text h2 {
            font-size: 24px;
            font-weight: 700;
            color: #B91C1C;
            margin: 0 0 5px 0;
            line-height: 1.2;
        }

        .welcome-text p {
            font-size: 13px;
            color: #64748B;
            font-weight: 400;
            margin: 0;
            line-height: 1.5;
        }


        /* =========================================================
                   CURRENT DATE
                ========================================================= */

        .dashboard-date {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-top: 5px;
            margin-right: 12px;
        }

            .dashboard-date .date-value {
                font-size: 12px;
                font-weight: 600;
                color: #374151;
            }


        /* =========================================================
                   DASHBOARD CARDS
                ========================================================= */

        .cards-container {
            display: flex;
            gap: 14px;
            width: 100%;
            margin-bottom: 22px;
        }

        .dashboard-card {
            flex: 1;
            min-width: 150px;
            height: 94px;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            display: flex;
            align-items: center;
            padding: 15px;
            gap: 13px;
            transition: all .2s ease;
        }

            .dashboard-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,.06);
            }

        .card-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #FFFFFF;
            font-size: 19px;
        }

        .purple {
            background: #7C3AED;
        }

        .orange {
            background: #F59E0B;
        }

        .green {
            background: #10B981;
        }

        .blue {
            background: #3B82F6;
        }

        .red {
            background: #EF4444;
        }

        .card-info h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: #111827;
            line-height: 1.1;
        }

        .card-info span {
            font-size: 12px;
            font-weight: 600;
            display: block;
            margin-top: 5px;
        }


        /* =========================================================
                   LOWER CONTENT
                ========================================================= */

        .lower-content {
            display: grid;
            grid-template-columns: 1.65fr .95fr;
            gap: 16px;
        }

        .dashboard-panel {
            background: #FFFFFF;
            border: 1px solid #D9DDE3;
            border-radius: 8px;
            overflow: hidden;
        }


        /* =========================================================
                   PANEL HEADER
                ========================================================= */

        .panel-header {
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 17px;
        }

            .panel-header h4 {
                font-size: 14px;
                font-weight: 700;
                color: #111827;
                margin: 0;
            }


        /* =========================================================
                   FILTER BUTTON
                ========================================================= */

        .filter-btn {
            height: 30px;
            min-width: 120px;
            border: 1px solid #D1D5DB;
            background: #FFFFFF;
            padding: 0 11px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #374151;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

            .filter-btn:hover {
                border-color: #B91C1C;
                color: #B91C1C;
            }


        /* =========================================================
                   GRAPH
                ========================================================= */

        .graph-panel {
            height: 270px;
            padding: 0 17px 17px 17px;
        }

        .graph-area {
            height: 180px;
            margin-left: 42px;
            border-left: 2px solid #9CA3AF;
            border-bottom: 2px solid #9CA3AF;
            position: relative;
        }

        .graph-y-labels {
            position: absolute;
            left: -35px;
            top: 0;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            font-size: 10px;
            font-weight: 600;
            color: #374151;
        }

        .days {
            position: absolute;
            bottom: -27px;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: space-around;
            font-size: 10px;
            font-weight: 600;
            color: #374151;
        }


        /* =========================================================
                   GRAPH FILTER SELECTS
                ========================================================= */

        .filter-select {
            height: 30px;
            min-width: 115px;
            border: 1px solid #D1D5DB;
            background: #FFFFFF;
            padding: 0 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #374151;
        }

            .filter-select:hover {
                border-color: #B91C1C;
            }

            .filter-select:focus {
                outline: none;
                border-color: #B91C1C;
            }

        .graph-panel-body {
            height: 210px;
            padding: 0 17px 17px 17px;
        }


        /* =========================================================
                   STAT SUMMARY CARD POPUPS
                ========================================================= */

        .dashboard-card {
            cursor: pointer;
        }

        .stat-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 20, 22, 0.55);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 20px;
        }

            .stat-modal-overlay.show {
                display: flex;
            }

        .stat-modal-card {
            width: 100%;
            max-width: 560px;
            max-height: 85vh;
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0 25px 60px rgba(0,0,0,.28);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .stat-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid #E5E7EB;
        }

        .stat-modal-title-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stat-modal-title {
            font-size: 14px;
            font-weight: 700;
            color: #111827;
        }

        .stat-modal-badge {
            background: #B91C1C;
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 10px;
        }

        .stat-modal-close {
            background: none;
            border: none;
            font-size: 18px;
            color: #6B7280;
            cursor: pointer;
            line-height: 1;
        }

            .stat-modal-close:hover {
                color: #B91C1C;
            }

        .stat-modal-date {
            padding: 10px 20px 0;
            font-size: 10px;
            font-weight: 600;
            color: #B91C1C;
        }

        .stat-modal-search {
            padding: 12px 20px;
        }

            .stat-modal-search .table-search {
                margin-bottom: 0;
            }

        .stat-modal-table-wrap {
            flex: 1;
            overflow-y: auto;
            padding: 0 20px 16px;
        }

        .stat-modal-table {
            width: 100%;
            border-collapse: collapse;
        }

            .stat-modal-table thead th {
                position: sticky;
                top: 0;
                background: #111111;
                font-size: 10px;
                font-weight: 700;
                color: #FFFFFF;
                padding: 8px 10px;
                text-align: left;
                white-space: nowrap;
                z-index: 1;
            }

            .stat-modal-table td {
                padding: 9px 10px;
                font-size: 10px;
                color: #374151;
                border-bottom: 1px solid #E5E7EB;
                vertical-align: middle;
                white-space: nowrap;
            }

            .stat-modal-table tbody tr:hover {
                background: #FEF2F2;
            }

        .stat-avatar-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stat-avatar {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 9px;
            font-weight: 700;
            flex-shrink: 0;
        }


        /* =========================================================
                   RECENT APPLICANTS
                ========================================================= */

        .table-panel {
            height: 270px;
            padding: 13px 12px 0 12px;
            overflow: hidden;
        }

            .table-panel .panel-title {
                font-size: 14px;
                font-weight: 700;
                color: #111827;
                margin-bottom: 10px;
            }


        /* =========================================================
                   TABLE SEARCH
                ========================================================= */

        .table-search {
            width: 100%;
            height: 36px;
            background: #FFFFFF;
            border-radius: 18px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 3px 12px rgba(0,0,0,.05);
            display: flex;
            align-items: center;
            padding: 0 13px;
            gap: 9px;
            margin-bottom: 10px;
            flex-shrink: 0;
        }

            .table-search i {
                color: #6B7280;
                font-size: 13px;
            }

            .table-search input {
                width: 100%;
                border: none;
                outline: none;
                font-size: 11px;
                color: #374151;
                background: transparent;
            }

                .table-search input::placeholder {
                    color: #9CA3AF;
                }


        /* =========================================================
                   TABLE SCROLL
                ========================================================= */

        .table-scroll {
            height: 185px;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: #C7CBD1 transparent;
        }

            .table-scroll::-webkit-scrollbar {
                width: 5px;
            }

            .table-scroll::-webkit-scrollbar-thumb {
                background: #C7CBD1;
                border-radius: 10px;
            }

            .table-scroll::-webkit-scrollbar-track {
                background: transparent;
            }


        /* =========================================================
                   APPLICANT TABLE
                ========================================================= */

        .applicant-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

            .applicant-table thead {
                background: #111111;
            }

            .applicant-table th {
                height: 36px;
                padding: 0 9px;
                font-size: 10px;
                font-weight: 700;
                color: #FFFFFF;
                border-bottom: 1px solid #D1D5DB;
                white-space: nowrap;
                letter-spacing: .2px;
            }

            .applicant-table td {
                height: 35px;
                padding: 0 9px;
                font-size: 10px;
                font-weight: 500;
                color: #374151;
                border-bottom: 1px solid #E5E7EB;
                white-space: nowrap;
            }

            .applicant-table tbody tr:hover {
                background: #FEF2F2;
            }


        /* =========================================================
                   STATUS
                ========================================================= */

        .status-completed,
        .status-pending {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: 600;
        }

        .status-completed {
            background: #DBEAFE;
            color: #2563EB;
        }

        .status-pending {
            background: #FEF3C7;
            color: #D97706;
        }

        .status-pill-approved {
            background: #DCFCE7;
            color: #15803D;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: 600;
            display: inline-block;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1000px) {

            .cards-container {
                flex-wrap: wrap;
            }

            .dashboard-card {
                min-width: 180px;
            }

            .lower-content {
                grid-template-columns: 1fr;
            }
        }


        @@media (max-width: 768px) {

            body {
                overflow-y: auto;
            }

            .sidebar {
                width: 70px;
                min-width: 70px;
            }

            .system-name,
            .menu a span,
            .logout a span {
                display: none;
            }

            .logo-section {
                padding: 15px 8px;
            }

            .logo-circle {
                width: 40px;
                height: 40px;
            }

            .menu {
                padding: 15px 8px;
            }

                .menu a {
                    justify-content: center;
                    padding: 10px;
                }

            .logout a {
                justify-content: center;
            }

            .content-area {
                padding: 16px;
            }

            .welcome-text h2 {
                font-size: 21px;
            }

            .welcome-text p {
                font-size: 12px;
            }

            .cards-container {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
            }

            .dashboard-card {
                width: 100%;
            }
        }


        @@media (max-width: 500px) {

            .cards-container {
                grid-template-columns: 1fr;
            }

            .profile-info {
                display: none;
            }

            .lower-content {
                display: block;
            }

            .dashboard-panel {
                margin-bottom: 15px;
            }

            .dashboard-date {
                margin-top: 5px;
            }
        }

    </style>

</head>


<body>

    <div class="dashboard-container">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/newlogo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>


            <!-- MAIN MENU -->

            <div class="menu">

                <a href="@Url.Action("Dashboard", "Admin")"
                   class="active">

                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>

                </a>


                <a href="@Url.Action("RequestManagement", "Admin")">

                    <i class="bi bi-file-earmark-text"></i>
                    <span>Request</span>

                </a>


                <a href="@Url.Action("RecordsManagement", "Admin")">

                    <i class="bi bi-folder2-open"></i>
                    <span>Records</span>

                </a>


                <a href="@Url.Action("ReportsManagement", "Admin")">

                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>

                </a>


                <a href="@Url.Action("AuditLogs", "Admin")">

                    <i class="bi bi-clock-history"></i>
                    <span>Audit Logs</span>

                </a>


                <a href="@Url.Action("UsersManagement", "Admin")">

                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>

                </a>

            </div>


            <!-- SETTINGS + LOGOUT AT THE BOTTOM -->

            <div class="logout">

                <!-- SETTINGS -->

                <a href="@Url.Action("Settings", "Admin")"
                   class="settings-link">

                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>

                </a>


                <!-- LOGOUT -->

                <a href="@Url.Action("Logout", "Admin")"
                   class="logout-link">

                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>

                </a>

            </div>

        </aside>


        <!-- MAIN CONTENT -->

        <div class="main-content">

            <!-- TOPBAR -->

            <div class="topbar">

