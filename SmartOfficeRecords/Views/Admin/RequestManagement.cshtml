@{
    ViewBag.Title = "Request Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Request Management - SORS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter', sans-serif;
            }

            body {
                background: #F5F6F8;
                overflow: hidden;
                color: #111827;
            }

            .dashboard-container {
                display: flex;
                height: 100vh;
                width: 100%;
            }

            /* SIDEBAR */
            .sidebar {
                width: 158px;
                min-width: 158px;
                height: 100vh;
                background: #1F2933;
                color: #FFFFFF;
                display: flex;
                flex-direction: column;
                transition: all .3s ease;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.25) transparent;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.25);
                    border-radius: 10px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .sidebar.collapsed {
                    width: 78px;
                    min-width: 78px;
                }

                    .sidebar.collapsed .system-name {
                        display: block;
                        font-size: 11px;
                        font-weight: 700;
                        margin-top: 8px;
                        letter-spacing: .2px;
                    }

                    .sidebar.collapsed .logo-circle {
                        width: 42px;
                        height: 42px;
                    }

                    .sidebar.collapsed .logo-section {
                        padding: 18px 10px;
                    }

                    .sidebar.collapsed .menu a span,
                    .sidebar.collapsed .logout a span {
                        display: none;
                    }

                    .sidebar.collapsed .menu {
                        padding: 16px 10px;
                    }

                        .sidebar.collapsed .menu a {
                            width: 44px;
                            height: 44px;
                            margin: 0 auto 10px auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            border-radius: 6px;
                        }

                            .sidebar.collapsed .menu a.active {
                                background: #B91C1C;
                                box-shadow: 0 4px 10px rgba(0,0,0,.15);
                            }

                            .sidebar.collapsed .menu a i,
                            .sidebar.collapsed .logout a i {
                                margin: 0;
                                font-size: 17px;
                            }

                    .sidebar.collapsed .logout {
                        padding-bottom: 15px;
                    }

                        .sidebar.collapsed .logout a {
                            width: 44px;
                            height: 44px;
                            margin: 0 auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                        }

            .logo-section {
                text-align: center;
                padding: 18px 10px;
                border-bottom: 1px solid rgba(255,255,255,.18);
            }

            .logo-circle {
                width: 42px;
                height: 42px;
                background: #FFFFFF;
                border-radius: 50%;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            .system-name {
                margin-top: 9px;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: .3px;
                color: #FFFFFF;
            }

            .menu {
                padding: 16px 9px;
            }

                .menu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 10px 11px;
                    margin-bottom: 5px;
                    border-radius: 6px;
                    font-size: 13px;
                    font-weight: 500;
                    line-height: 1.2;
                    transition: all .2s ease;
                }

                    .menu a i {
                        font-size: 16px;
                        min-width: 16px;
                    }

                    .menu a:hover {
                        background: rgba(185, 28, 28, .18);
                        color: #FFFFFF;
                    }

                    .menu a.active {
                        background: #B91C1C;
                        color: #FFFFFF;
                        box-shadow: 0 3px 8px rgba(185,28,28,.22);
                    }

            .logout {
                margin-top: auto;
                padding: 12px 9px 15px 9px;
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

                .logout a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    gap: 11px;
                    align-items: center;
                    padding: 10px 11px;
                    font-size: 13px;
                    font-weight: 500;
                    border-radius: 6px;
                    transition: all .2s ease;
                }

                    .logout a i {
                        font-size: 16px;
                        min-width: 16px;
                    }

            .settings-link:hover {
                background: rgba(185, 28, 28, .18);
                color: #FFFFFF;
            }

            .logout-link:hover {
                background: rgba(185,28,28,.25);
                color: #FFFFFF;
            }

            /* MAIN CONTENT */
            .main-content {
                flex: 1;
                background: #F5F6F8;
                display: flex;
                flex-direction: column;
                height: 100vh;
                overflow: hidden;
            }

            .topbar {
                height: 56px;
                min-height: 56px;
                flex-shrink: 0;
                border-bottom: 1px solid #E5E7EB;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 20px;
                background: #FFFFFF;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .menu-toggle {
                background: none;
                border: none;
                color: #B91C1C;
                font-size: 19px;
                cursor: pointer;
                padding: 5px;
            }

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
                margin-left: auto;
            }

            .notification-icon {
                font-size: 19px;
                color: #374151;
                cursor: pointer;
                transition: color .2s ease;
            }

                .notification-icon:hover {
                    color: #B91C1C;
                }

            .profile {
                display: flex;
                align-items: center;
                gap: 9px;
                padding-left: 12px;
                border-left: 1px solid #E5E7EB;
            }

                .profile img {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    object-fit: cover;
                }

            .profile-info {
                display: flex;
                flex-direction: column;
                line-height: 1.25;
            }

                .profile-info h5 {
                    margin: 0;
                    font-size: 12px;
                    font-weight: 600;
                    color: #111827;
                }

                .profile-info span {
                    font-size: 10px;
                    color: #6B7280;
                    margin-top: 2px;
                }

            .profile-arrow {
                color: #6B7280;
                font-size: 10px;
                margin-left: 3px;
            }

            .content-area {
                flex: 1;
                padding: 22px 30px;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: thin;
                scrollbar-color: #C7CBD1 transparent;
            }

                .content-area::-webkit-scrollbar {
                    width: 6px;
                }

                .content-area::-webkit-scrollbar-thumb {
                    background: #C7CBD1;
                    border-radius: 10px;
                }

                .content-area::-webkit-scrollbar-track {
                    background: transparent;
                }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 18px;
            }

            .page-title {
                color: #B91C1C;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: -0.2px;
                margin: 0 0 5px 0;
                line-height: 1.2;
            }

            .page-subtitle {
                color: #64748B;
                font-size: 13px;
                font-weight: 400;
                margin: 0;
                line-height: 1.5;
            }

            .action-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                margin-bottom: 16px;
            }

            .search-filter {
                display: flex;
                align-items: center;
                gap: 12px;
                flex: 1;
            }

            .search-box {
                height: 36px;
                flex: 1;
                max-width: 540px;
                background: #FFFFFF;
                border-radius: 20px;
                border: 1px solid #E5E7EB;
                box-shadow: 0 3px 12px rgba(0,0,0,.05);
                display: flex;
                align-items: center;
                padding: 0 13px;
                gap: 9px;
            }

                .search-box i {
                    color: #6B7280;
                    font-size: 13px;
                }

                .search-box input {
                    width: 100%;
                    border: none;
                    outline: none;
                    font-size: 11px;
                    color: #374151;
                    background: transparent;
                    font-weight: 400;
                }

                    .search-box input::placeholder {
                        color: #9CA3AF;
                    }

            .status-filter {
                width: 190px;
                height: 36px;
                background: #FFFFFF;
                border: 1px solid #D1D5DB;
                border-radius: 6px;
                padding: 0 11px;
                font-size: 11px;
                font-weight: 600;
                color: #374151;
                outline: none;
            }

                .status-filter:focus {
                    border-color: #B91C1C;
                    box-shadow: 0 0 0 2px rgba(185,28,28,.08);
                }

            .create-btn {
                height: 36px;
                border: none;
                border-radius: 6px;
                background: #B91C1C;
                color: #FFFFFF;
                padding: 0 16px;
                font-size: 11px;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 7px;
                cursor: pointer;
                transition: all .2s ease;
                text-decoration: none;
                white-space: nowrap;
            }

                .create-btn:hover {
                    background: #991B1B;
                    color: #FFFFFF;
                    transform: translateY(-1px);
                    box-shadow: 0 4px 10px rgba(185,28,28,.20);
                }

                .create-btn i {
                    font-size: 13px;
                }

            .table-container {
                background: #FFFFFF;
                border: 1px solid #D9DDE3;
                border-radius: 8px;
                overflow-x: auto;
                overflow-y: hidden;
                box-shadow: 0 1px 2px rgba(0,0,0,.02);
            }

                .table-container::-webkit-scrollbar {
                    height: 6px;
                }

                .table-container::-webkit-scrollbar-thumb {
                    background: #C7CBD1;
                    border-radius: 10px;
                }

            .request-table {
                width: 100%;
                min-width: 900px;
                border-collapse: collapse;
                margin: 0;
                table-layout: fixed;
            }

                .request-table th:nth-child(1), .request-table td:nth-child(1) {
                    width: 10%;
                }

                .request-table th:nth-child(2), .request-table td:nth-child(2) {
                    width: 21%;
                }

                .request-table th:nth-child(3), .request-table td:nth-child(3) {
                    width: 23%;
                }

                .request-table th:nth-child(4), .request-table td:nth-child(4) {
                    width: 15%;
                }

                .request-table th:nth-child(5), .request-table td:nth-child(5) {
                    width: 12%;
                }

                .request-table th:nth-child(6), .request-table td:nth-child(6) {
                    width: 19%;
                }

                .request-table thead {
                    background: #111111;
                }

                    .request-table thead th {
                        height: 40px;
                        padding: 0 12px;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: .15px;
                        color: #FFFFFF;
                        background: #111111;
                        border-bottom: 1px solid #111111;
                        white-space: nowrap;
                        vertical-align: middle;
                    }

                        .request-table thead th:nth-child(1) {
                            text-align: center;
                        }

                        .request-table thead th:nth-child(2), .request-table thead th:nth-child(3) {
                            text-align: left;
                        }

                        .request-table thead th:nth-child(4), .request-table thead th:nth-child(5), .request-table thead th:nth-child(6) {
                            text-align: center;
                        }

                .request-table tbody td {
                    height: 42px;
                    padding: 0 12px;
                    font-size: 10px;
                    font-weight: 500;
                    color: #374151;
                    background: #FFFFFF;
                    border-bottom: 1px solid #E5E7EB;
                    white-space: nowrap;
                    vertical-align: middle;
                }

                    .request-table tbody td:nth-child(1) {
                        text-align: center;
                        font-weight: 600;
                        color: #4B5563;
                    }

                    .request-table tbody td:nth-child(2), .request-table tbody td:nth-child(3) {
                        text-align: left;
                    }

                    .request-table tbody td:nth-child(4), .request-table tbody td:nth-child(5), .request-table tbody td:nth-child(6) {
                        text-align: center;
                    }

                .request-table tbody tr:hover td {
                    background: #FEF2F2;
                }

                .request-table tbody tr:last-child td {
                    border-bottom: none;
                }

            .status-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 70px;
                padding: 5px 9px;
                border-radius: 5px;
                font-size: 9px;
                font-weight: 600;
                line-height: 1;
            }

            .status-pending {
                background: #FEF3C7;
                color: #D97706;
            }

            .status-approved {
                background: #DCFCE7;
                color: #15803D;
            }

            .status-rejected {
                background: #FEE2E2;
                color: #B91C1C;
            }

            .status-completed {
                background: #DBEAFE;
                color: #2563EB;
            }

            .action-icons {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                width: 100%;
                flex-wrap: wrap;
            }

            .action-btn {
                height: 28px;
                border: none;
                border-radius: 5px;
                padding: 0 9px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all .2s ease;
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                font-weight: 600;
                gap: 4px;
                white-space: nowrap;
            }

                .action-btn i {
                    font-size: 11px;
                }

            .view-action {
                background: #2563EB;
                color: #FFFFFF;
            }

                .view-action:hover {
                    background: #1D4ED8;
                    color: #FFFFFF;
                    transform: translateY(-1px);
                }

            .approve-action {
                background: #16A34A;
                color: #FFFFFF;
            }

                .approve-action:hover {
                    background: #15803D;
                    color: #FFFFFF;
                    transform: translateY(-1px);
                }

            .reject-action {
                background: #B91C1C;
                color: #FFFFFF;
            }

                .reject-action:hover {
                    background: #991B1B;
                    color: #FFFFFF;
                    transform: translateY(-1px);
                }

            /* PAGINATION */
            .pagination-section {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 18px;
                width: 100%;
            }

            .showing-text {
                font-size: 10px;
                color: #374151;
                font-weight: 500;
            }

            .pagination-buttons {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .pill-btn {
                height: 28px;
                padding: 0 12px;
                border: 1px solid #E5E7EB;
                background: #FFFFFF;
                border-radius: 5px;
                display: flex;
                justify-content: center;
                align-items: center;
                color: #6B7280;
                font-size: 9px;
                font-weight: 500;
                cursor: pointer;
                transition: all .2s ease;
                text-decoration: none;
            }

                .pill-btn:hover {
                    background: #FEE2E2;
                    color: #B91C1C;
                    border-color: #FECACA;
                }

                .pill-btn.disabled {
                    background: #F3F4F6;
                    color: #9CA3AF;
                    pointer-events: none;
                }

            /* VIEW APPLICANT MODAL */
            .view-modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .view-modal-overlay.show {
                    display: flex;
                }

            .view-modal-card {
                width: 100%;
                max-width: 380px;
                max-height: 88vh;
                background: #FFFFFF;
                border-radius: 12px;
                box-shadow: 0 25px 60px rgba(0,0,0,.3);
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .view-modal-header {
                position: relative;
                background: #1A1F24;
                color: #FFFFFF;
                padding: 16px 18px;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .view-modal-close {
                position: absolute;
                top: 10px;
                right: 10px;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                background: #FFFFFF;
                border: none;
                color: #374151;
                font-size: 13px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 6px rgba(0,0,0,.2);
            }

            .view-modal-avatar {
                width: 38px;
                height: 38px;
                min-width: 38px;
                border-radius: 50%;
                background: #B91C1C;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #FFFFFF;
                font-weight: 700;
                font-size: 13px;
            }

            .view-modal-name {
                font-size: 14px;
                font-weight: 700;
                flex: 1;
            }

            .view-modal-status {
                margin-left: auto;
            }

            .view-modal-body {
                padding: 18px 20px 20px;
                overflow-y: auto;
            }

            .view-modal-section-title {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .6px;
                color: #9CA3AF;
                text-transform: uppercase;
                padding-bottom: 6px;
                border-bottom: 1px solid #E5E7EB;
                margin-bottom: 12px;
                margin-top: 16px;
            }

                .view-modal-section-title:first-child {
                    margin-top: 0;
                }

            .view-modal-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .view-modal-field-label {
                font-size: 8.5px;
                font-weight: 700;
                color: #9CA3AF;
                letter-spacing: .4px;
                text-transform: uppercase;
                margin-bottom: 3px;
            }

            .view-modal-field-value {
                font-size: 11px;
                font-weight: 600;
                color: #1F2933;
            }

                .view-modal-field-value.link {
                    color: #2563EB;
                }

            .view-modal-notes-box {
                background: #F3F4F6;
                border-radius: 6px;
                padding: 10px 12px;
                font-size: 10.5px;
                color: #6B7280;
            }

            .view-modal-docs {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .view-modal-doc-btn {
                border: 1px solid #E5E7EB;
                border-radius: 6px;
                padding: 10px;
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                color: #1F2933;
                transition: all .2s ease;
            }

                .view-modal-doc-btn:hover {
                    border-color: #B91C1C;
                    background: #FEF2F2;
                }

                .view-modal-doc-btn.disabled {
                    opacity: .5;
                    pointer-events: none;
                }

            .view-modal-doc-icon {
                font-size: 15px;
                color: #6B7280;
            }

            .view-modal-doc-text {
                display: flex;
                flex-direction: column;
                line-height: 1.3;
            }

            .view-modal-doc-title {
                font-size: 10px;
                font-weight: 700;
            }

            .view-modal-doc-sub {
                font-size: 8px;
                color: #9CA3AF;
            }

            /* APPROVE / REJECT CONFIRM MODALS */
            .confirm-modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 3000;
                padding: 20px;
            }

                .confirm-modal-overlay.show {
                    display: flex;
                }

            .confirm-modal-card {
                width: 100%;
                max-width: 320px;
                background: #ffffff;
                border-radius: 12px;
                padding: 30px 26px 24px;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0,0,0,.28);
                opacity: 0;
                transform: translateY(16px);
                animation: confirmSlideIn .25s ease forwards;
            }

            @@keyframes confirmSlideIn {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .confirm-modal-icon {
                width: 62px;
                height: 62px;
                border-radius: 50%;
                background: #FEE2E2;
                color: #E32626;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
                margin: 0 auto 16px;
            }

            .confirm-modal-title {
                color: #111827;
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .confirm-modal-text {
                color: #6B7280;
                font-size: 12px;
                line-height: 1.5;
                margin-bottom: 22px;
            }

            .confirm-modal-actions {
                display: flex;
                gap: 10px;
            }

            .confirm-modal-btn-yes {
                flex: 1;
                height: 40px;
                border: none;
                background: #E32626;
                color: #ffffff;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
            }

                .confirm-modal-btn-yes:hover {
                    background: #B91C1C;
                }

            .confirm-modal-btn-cancel {
                flex: 1;
                height: 40px;
                border: 1px solid #D1D5DB;
                background: #ffffff;
                color: #374151;
                border-radius: 7px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
            }

                .confirm-modal-btn-cancel:hover {
                    background: #F3F4F6;
                }

            /* RESPONSIVE */
            @@media (max-width: 1000px) {
                .action-bar {
                    flex-wrap: wrap;
                }

                .search-filter {
                    width: 100%;
                }

                .search-box {
                    max-width: none;
                }

                .create-btn {
                    margin-left: auto;
                }
            }

            @@media (max-width: 768px) {
                body {
                    overflow-y: auto;
                }

                .sidebar {
                    width: 78px;
                    min-width: 78px;
                }

                .system-name, .menu a span, .logout a span {
                    display: none;
                }

                .logo-section {
                    padding: 15px 8px;
                }

                .logo-circle {
                    width: 40px;
                    height: 40px;
                }

                .menu {
                    padding: 15px 8px;
                }

                    .menu a {
                        justify-content: center;
                        padding: 10px;
                    }

                .logout a {
                    justify-content: center;
                }

                .content-area {
                    padding: 16px;
                }

                .page-title {
                    font-size: 21px;
                }

                .page-subtitle {
                    font-size: 12px;
                }

                .page-header {
                    margin-bottom: 16px;
                }

                .action-bar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search-filter {
                    width: 100%;
                    flex-direction: column;
                }

                .search-box {
                    width: 100%;
                    max-width: none;
                }

                .status-filter {
                    width: 100%;
                }

                .create-btn {
                    width: 100%;
                    justify-content: center;
                    margin-left: 0;
                }

                .table-container {
                    overflow-x: auto;
                }

                .request-table {
                    min-width: 900px;
                }

                .pagination-section {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 10px;
                }

                .pagination-buttons {
                    align-self: flex-end;
                }
            }

            @@media (max-width: 500px) {
                .profile-info {
                    display: none;
                }

                .profile {
                    border-left: none;
                }

                .content-area {
                    padding: 12px;
                }
            }
    </style>

</head>

<body>

    <div class="dashboard-container">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="logo-section">
                <div class="logo-circle">
                    <img src="~/Images/logo.png" class="logo-img" alt="SORS Logo" />
                </div>
                <div class="system-name">SORS</div>
            </div>

            <div class="menu">

                <a href="@Url.Action("Dashboard", "Admin")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a href="@Url.Action("RequestManagement", "Admin")" class="active">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Request</span>
                </a>

                <a href="@Url.Action("RecordsManagement", "Admin")">
                    <i class="bi bi-folder2-open"></i>
                    <span>Records</span>
                </a>

                <a href="@Url.Action("ReportsManagement", "Admin")">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Reports</span>
                </a>

                <a href="@Url.Action("AuditLogs", "Admin")">
                    <i class="bi bi-clock-history"></i>
                    <span>Audit Logs</span>
                </a>

                <a href="@Url.Action("UsersManagement", "Admin")">
                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>
                </a>

            </div>

            <div class="logout">
                <a href="@Url.Action("Settings", "Admin")" class="settings-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>

                <a href="@Url.Action("Logout", "Admin")" class="logout-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>

        </aside>


        <!-- MAIN CONTENT -->
        <div class="main-content">

            <div class="topbar">

                <div class="topbar-left">
                    <button class="menu-toggle" id="menuToggle" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="topbar-right">

                    <i class="bi bi-bell notification-icon"></i>

                    <div class="profile">
                        <img src="~/Images/adminpic.jpg" alt="Profile" />
                        <div class="profile-info">
                            <h5>@(Context.Session.GetString("AdminName") ?? "Admin")</h5>
                            <span>Administrator</span>
                        </div>
                        <i class="bi bi-chevron-down profile-arrow"></i>
                    </div>

                </div>

            </div>


            <div class="content-area">

                <div class="page-header">
                    <div>
                        <h2 class="page-title">Request</h2>
                        <p class="page-subtitle">Manage and track submitted requests efficiently.</p>
                    </div>
                </div>

                <!--
                    No <form> here on purpose: search/status filtering is done
                    live via JS (fetchRequests) below, never by submitting a
                    page GET. A <form> around a lone text input can still
                    implicitly submit on Enter in some browsers, which would
                    reload the page and defeat the live search.
                -->
                <div class="action-bar">

                    <div class="search-filter">

                        <div class="search-box">
                            <i class="bi bi-search"></i>
                            <input type="text" id="searchInput" name="search" value="@ViewBag.SearchTerm" placeholder="Search here..." autocomplete="off" />
                        </div>

                        <select name="status" id="statusFilter" class="status-filter">
                            <option value="All Status" selected="@(ViewBag.SelectedStatus == null || ViewBag.SelectedStatus == "All Status")">All Status</option>
                            <option value="Pending" selected="@(ViewBag.SelectedStatus == "Pending")">Pending</option>
                            <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved")">Approved</option>
                            <option value="Rejected" selected="@(ViewBag.SelectedStatus == "Rejected")">Rejected</option>
                            <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed")">Completed</option>
                        </select>
                    </div>

                    <a href="@Url.Action("RCreateRequest", "Admin")" class="create-btn">
                        <i class="bi bi-plus-lg"></i>
                        Create Request
                    </a>

                </div>

                <div class="table-container">

                    <table class="request-table">

                        <thead>
                            <tr>
                                <th>REQUEST ID</th>
                                <th>APPLICANT NAME</th>
                                <th>EMAIL ADDRESS</th>
                                <th>DATE APPLIED</th>
                                <th>STATUS</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>

                        <tbody id="requestsTableBody">

                            @if (ViewBag.Requests == null || ViewBag.Requests.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No requests found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var request in ViewBag.Requests)
                                {
                                    string statusClass = request.Status switch
                                    {
                                        "Pending" => "status-pending",
                                        "Approved" => "status-approved",
                                        "Completed" => "status-completed",
                                        "Rejected" => "status-rejected",
                                        _ => "status-pending"
                                    };

                                    <tr>

                                        <td>@request.DisplayId</td>
                                        <td>@request.ApplicantName</td>
                                        <td>@request.ApplicantEmail</td>
                                        <td>@request.DateAppliedFormatted</td>

                                        <td>
                                            <span class="status-badge @statusClass">@request.Status</span>
                                        </td>

                                        <td>
                                            <div class="action-icons">

                                                <button type="button"
                                                        class="action-btn view-action"
                                                        onclick="openViewModal(this)"
                                                        data-id="@request.DisplayId"
                                                        data-name="@request.ApplicantName"
                                                        data-initials="@request.Initials"
                                                        data-status="@request.Status"
                                                        data-statusclass="status-badge @statusClass"
                                                        data-email="@request.Email"
                                                        data-contact="@request.ContactNumber"
                                                        data-appdate="@request.AppointmentDateFormatted"
                                                        data-apptime="@request.AppointmentTimeFormatted"
                                                        data-submitted="@request.DateSubmittedFormatted"
                                                        data-notes="@request.AdditionalNotes"
                                                        data-resume="@request.ResumeUrl"
                                                        data-validid="@request.ValidIdUrl">
                                                    <i class="bi bi-eye"></i> View
                                                </button>

                                                @if (request.Status == "Pending")
                                                {
                                                    <button type="button" class="action-btn approve-action" onclick="openConfirmModal('approve', @request.AppointmentId)">
                                                        <i class="bi bi-check-lg"></i> Approve
                                                    </button>

                                                    <button type="button" class="action-btn reject-action" onclick="openConfirmModal('reject', @request.AppointmentId)">
                                                        <i class="bi bi-x-lg"></i> Reject
                                                    </button>
                                                }

                                            </div>
                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

                <div class="pagination-section">

                    <div class="showing-text" id="showingText">
                        Showing @ViewBag.StartItem to @ViewBag.EndItem of @ViewBag.TotalCount requests
                    </div>

                    <!--
                        Left empty on purpose: renderPagination() (called at
                        the bottom of the script, using the same ViewBag
                        values) fills this in with correctly-ordered
                        Previous/Next buttons on page load, and again after
                        every live search/filter/page change.
                    -->
                    <div class="pagination-buttons" id="paginationButtons"></div>

                </div>

                <!-- VIEW APPLICANT MODAL -->
                <div class="view-modal-overlay" id="viewApplicantModal">
                    <div class="view-modal-card">

                        <div class="view-modal-header">
                            <button type="button" class="view-modal-close" onclick="closeViewModal()">&times;</button>
                            <div class="view-modal-avatar" id="vmAvatar"></div>
                            <div class="view-modal-name" id="vmName"></div>
                            <span class="view-modal-status" id="vmStatus"></span>
                        </div>

                        <div class="view-modal-body">

                            <div class="view-modal-section-title">Contact Information</div>
                            <div class="view-modal-grid">
                                <div>
                                    <div class="view-modal-field-label">Email</div>
                                    <div class="view-modal-field-value" id="vmEmail"></div>
                                </div>
                                <div>
                                    <div class="view-modal-field-label">Contact Number</div>
                                    <div class="view-modal-field-value link" id="vmContact"></div>
                                </div>
                            </div>

                            <div class="view-modal-section-title">Interview Details</div>
                            <div class="view-modal-grid">
                                <div>
                                    <div class="view-modal-field-label">Appointment Date</div>
                                    <div class="view-modal-field-value" id="vmAppDate"></div>
                                </div>
                                <div>
                                    <div class="view-modal-field-label">Date Submitted</div>
                                    <div class="view-modal-field-value" id="vmSubmitted"></div>
                                </div>
                                <div>
                                    <div class="view-modal-field-label">Appointment Time</div>
                                    <div class="view-modal-field-value" id="vmAppTime"></div>
                                </div>
                            </div>

                            <div class="view-modal-section-title">Additional Notes</div>
                            <div class="view-modal-notes-box" id="vmNotes"></div>

                            <div class="view-modal-section-title">Submitted Documents</div>
                            <div class="view-modal-docs">
                                <a href="#" target="_blank" class="view-modal-doc-btn" id="vmResumeLink">
                                    <i class="bi bi-eye view-modal-doc-icon"></i>
                                    <div class="view-modal-doc-text">
                                        <span class="view-modal-doc-title">View Resume</span>
                                        <span class="view-modal-doc-sub">PDF DOCUMENT</span>
                                    </div>
                                </a>
                                <a href="#" target="_blank" class="view-modal-doc-btn" id="vmValidIdLink">
                                    <i class="bi bi-eye view-modal-doc-icon"></i>
                                    <div class="view-modal-doc-text">
                                        <span class="view-modal-doc-title">View Valid ID</span>
                                        <span class="view-modal-doc-sub">IMAGE / PDF</span>
                                    </div>
                                </a>
                            </div>

                        </div>

                    </div>
                </div>

                <!-- CONFIRM MODAL: APPROVE -->
                <div class="confirm-modal-overlay" id="approveConfirmModal">
                    <div class="confirm-modal-card">

                        <div class="confirm-modal-icon">
                            <i class="bi bi-patch-check-fill"></i>
                        </div>

                        <div class="confirm-modal-title">Approve Applicant?</div>
                        <div class="confirm-modal-text">Are you sure you want to approve this applicant?</div>

                        <div class="confirm-modal-actions">
                            <form id="approveForm" action="@Url.Action("ApproveAppointment", "Admin")" method="post" style="flex:1;">
                                <input type="hidden" name="AppointmentId" id="approveAppointmentId" />
                                <button type="submit" class="confirm-modal-btn-yes" style="width:100%;">Yes</button>
                            </form>
                            <button type="button" class="confirm-modal-btn-cancel" onclick="closeConfirmModal('approveConfirmModal')">Cancel</button>
                        </div>

                    </div>
                </div>

                <!-- CONFIRM MODAL: REJECT -->
                <div class="confirm-modal-overlay" id="rejectConfirmModal">
                    <div class="confirm-modal-card">

                        <div class="confirm-modal-icon">
                            <i class="bi bi-file-earmark-x-fill"></i>
                        </div>

                        <div class="confirm-modal-title">Reject Applicant?</div>
                        <div class="confirm-modal-text">Are you sure you want to reject this applicant?</div>

                        <div class="confirm-modal-actions">
                            <form id="rejectForm" action="@Url.Action("RejectAppointment", "Admin")" method="post" style="flex:1;">
                                <input type="hidden" name="AppointmentId" id="rejectAppointmentId" />
                                <button type="submit" class="confirm-modal-btn-yes" style="width:100%;">Yes</button>
                            </form>
                            <button type="button" class="confirm-modal-btn-cancel" onclick="closeConfirmModal('rejectConfirmModal')">Cancel</button>
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>


    <script>

            // ---------- SIDEBAR TOGGLE ----------
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.querySelector('.sidebar');
            if (menuToggle && sidebar) {
                menuToggle.addEventListener('click', () => sidebar.classList.toggle('collapsed'));
            }

            // ---------- LIVE SEARCH / FILTER ----------
            let searchDebounceTimer;
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');

            searchInput.addEventListener('input', function () {
                clearTimeout(searchDebounceTimer);
                searchDebounceTimer = setTimeout(() => fetchRequests(1), 350);
            });

            // Belt-and-suspenders: since there's no <form> anymore Enter
            // has nothing to submit, but stop it explicitly anyway so a
            // future markup change can't silently reintroduce a reload.
            searchInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') e.preventDefault();
            });

            statusFilter.addEventListener('change', function () {
                fetchRequests(1);
            });

            function fetchRequests(page) {
                const search = searchInput.value;
                const status = statusFilter.value;

                fetch(`/Admin/SearchRequests?search=${encodeURIComponent(search)}&status=${encodeURIComponent(status)}&page=${page}`)
                    .then(res => res.json())
                    .then(data => {
                        renderRows(data.requests);
                        renderPagination(data);
                    })
                    .catch(err => console.error('Search request failed:', err));
            }

            function statusClassFor(status) {
                switch (status) {
                    case "Pending": return "status-pending";
                    case "Approved": return "status-approved";
                    case "Completed": return "status-completed";
                    case "Rejected": return "status-rejected";
                    default: return "status-pending";
                }
            }

            function renderRows(requests) {
                const tbody = document.getElementById('requestsTableBody');

                if (!requests || requests.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">No requests found.</td></tr>`;
                    return;
                }

                tbody.innerHTML = requests.map(r => {
                    const cls = statusClassFor(r.status);
                    const actions = r.status === "Pending"
                        ? `<button type="button" class="action-btn approve-action" onclick="openConfirmModal('approve', ${r.appointmentId})">
                               <i class="bi bi-check-lg"></i> Approve
                           </button>
                           <button type="button" class="action-btn reject-action" onclick="openConfirmModal('reject', ${r.appointmentId})">
                               <i class="bi bi-x-lg"></i> Reject
                           </button>`
                        : '';

                    return `
                        <tr>
                            <td>${r.displayId}</td>
                            <td>${r.applicantName}</td>
                            <td>${r.applicantEmail}</td>
                            <td>${r.dateAppliedFormatted}</td>
                            <td><span class="status-badge ${cls}">${r.status}</span></td>
                            <td>
                                <div class="action-icons">
                                    <button type="button" class="action-btn view-action"
                                        onclick="openViewModal(this)"
                                        data-id="${r.displayId}" data-name="${r.applicantName}"
                                        data-initials="${r.initials}" data-status="${r.status}"
                                        data-statusclass="status-badge ${cls}"
                                        data-email="${r.email ?? ''}" data-contact="${r.contactNumber ?? ''}"
                                        data-appdate="${r.appointmentDateFormatted}" data-apptime="${r.appointmentTimeFormatted}"
                                        data-submitted="${r.dateSubmittedFormatted}" data-notes="${r.additionalNotes}"
                                        data-resume="${r.resumeUrl}" data-validid="${r.validIdUrl}">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                    ${actions}
                                </div>
                            </td>
                        </tr>`;
                }).join('');
            }

            function renderPagination(data) {
                document.getElementById('showingText').textContent =
                    `Showing ${data.startItem} to ${data.endItem} of ${data.totalCount} requests`;

                const container = document.getElementById('paginationButtons');
                const prevDisabled = data.currentPage <= 1;
                const nextDisabled = data.currentPage >= data.totalPages;

                container.innerHTML = `
                    ${prevDisabled
                        ? `<span class="pill-btn disabled">Previous</span>`
                        : `<a href="#" class="pill-btn" onclick="fetchRequests(${data.currentPage - 1}); return false;">Previous</a>`}
                    ${nextDisabled
                        ? `<span class="pill-btn disabled">Next</span>`
                        : `<a href="#" class="pill-btn" onclick="fetchRequests(${data.currentPage + 1}); return false;">Next</a>`}
                `;
            }

            // Build the initial pagination buttons from server-rendered ViewBag values on page load
            renderPagination({
                currentPage: @ViewBag.CurrentPage,
                totalPages: @ViewBag.TotalPages,
                startItem: @ViewBag.StartItem,
                endItem: @ViewBag.EndItem,
                totalCount: @ViewBag.TotalCount
            });
   
            // ---------- VIEW APPLICANT MODAL ----------
            const viewModal = document.getElementById('viewApplicantModal');

            function openViewModal(btn) {
                const d = btn.dataset;

                document.getElementById('vmAvatar').textContent = d.initials || '?';
                document.getElementById('vmName').textContent = d.name || '';

                const statusEl = document.getElementById('vmStatus');
                statusEl.className = d.statusclass || 'status-badge status-pending';
                statusEl.textContent = d.status || '';

                document.getElementById('vmEmail').textContent = d.email || '—';
                document.getElementById('vmContact').textContent = d.contact || '—';
                document.getElementById('vmAppDate').textContent = d.appdate || '—';
                document.getElementById('vmSubmitted').textContent = d.submitted || '—';
                document.getElementById('vmAppTime').textContent = d.apptime || '—';
                document.getElementById('vmNotes').textContent = d.notes || 'No additional notes.';

                setDocLink('vmResumeLink', d.resume);
                setDocLink('vmValidIdLink', d.validid);

                viewModal.classList.add('show');
            }

            function setDocLink(linkId, url) {
                const link = document.getElementById(linkId);
                if (url) {
                    link.href = url;
                    link.classList.remove('disabled');
                } else {
                    link.href = '#';
                    link.classList.add('disabled');
                }
            }

            function closeViewModal() {
                viewModal.classList.remove('show');
            }

            viewModal.addEventListener('click', function (e) {
                if (e.target === viewModal) closeViewModal();
            });

            // ---------- APPROVE / REJECT CONFIRM MODALS ----------
            function openConfirmModal(action, appointmentId) {
                if (action === 'approve') {
                    document.getElementById('approveAppointmentId').value = appointmentId;
                    document.getElementById('approveConfirmModal').classList.add('show');
                } else if (action === 'reject') {
                    document.getElementById('rejectAppointmentId').value = appointmentId;
                    document.getElementById('rejectConfirmModal').classList.add('show');
                }
            }

            function closeConfirmModal(modalId) {
                document.getElementById(modalId).classList.remove('show');
            }

            document.querySelectorAll('.confirm-modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) overlay.classList.remove('show');
                });
            });
         
    </script>
</body>
</html>
