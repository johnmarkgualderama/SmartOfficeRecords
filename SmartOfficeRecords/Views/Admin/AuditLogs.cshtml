﻿@{
ViewBag.Title = "Audit Logs";
Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Audit Logs - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            /* =========================================================
                               GLOBAL
                            ========================================================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter', sans-serif;
            }

            body {
                background: #F5F6F8;
                overflow: hidden;
                color: #111827;
            }


            /* =========================================================
                               MAIN CONTAINER
                            ========================================================= */

            .dashboard-container {
                display: flex;
                width: 100%;
                height: 100vh;
            }


            /* =========================================================
                               SIDEBAR
                            ========================================================= */

            .sidebar {
                width: 158px;
                min-width: 158px;
                height: 100vh;
                background: #1F2933;
                color: #FFFFFF;
                display: flex;
                flex-direction: column;
                transition: all .3s ease;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: thin;
                scrollbar-color: rgba(255,255,255,.25) transparent;
            }

                .sidebar::-webkit-scrollbar {
                    width: 5px;
                }

                .sidebar::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.25);
                    border-radius: 10px;
                }

                .sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }


                /* =========================================================
                               COLLAPSED SIDEBAR
                            ========================================================= */

                .sidebar.collapsed {
                    width: 78px;
                    min-width: 78px;
                }

                    .sidebar.collapsed .system-name {
                        display: block;
                        font-size: 11px;
                        font-weight: 700;
                        margin-top: 8px;
                        letter-spacing: .2px;
                    }

                    .sidebar.collapsed .logo-circle {
                        width: 42px;
                        height: 42px;
                    }

                    .sidebar.collapsed .logo-section {
                        padding: 18px 10px;
                    }

                    .sidebar.collapsed .menu a span,
                    .sidebar.collapsed .logout a span {
                        display: none;
                    }

                    .sidebar.collapsed .menu {
                        padding: 16px 10px;
                    }

                        .sidebar.collapsed .menu a {
                            width: 44px;
                            height: 44px;
                            margin: 0 auto 10px auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            border-radius: 6px;
                        }

                            .sidebar.collapsed .menu a.active {
                                background: #B91C1C;
                                box-shadow: 0 4px 10px rgba(0,0,0,.15);
                            }

                            .sidebar.collapsed .menu a i,
                            .sidebar.collapsed .logout a i {
                                margin: 0;
                                font-size: 17px;
                            }

                    .sidebar.collapsed .logout {
                        padding-bottom: 15px;
                    }

                        .sidebar.collapsed .logout a {
                            width: 44px;
                            height: 44px;
                            margin: 0 auto;
                            padding: 0;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                        }


            /* =========================================================
                               LOGO
                            ========================================================= */

            .logo-section {
                text-align: center;
                padding: 18px 10px;
                border-bottom: 1px solid rgba(255,255,255,.18);
            }

            .logo-circle {
                width: 42px;
                height: 42px;
                background: #FFFFFF;
                border-radius: 50%;
                margin: auto;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .logo-img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

            .system-name {
                margin-top: 9px;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: .3px;
                color: #FFFFFF;
            }


            /* =========================================================
                               MENU
                            ========================================================= */

            .menu {
                padding: 16px 9px;
            }

                .menu a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 10px 11px;
                    margin-bottom: 5px;
                    border-radius: 6px;
                    font-size: 13px;
                    font-weight: 500;
                    line-height: 1.2;
                    transition: all .2s ease;
                }

                    .menu a i {
                        font-size: 16px;
                        min-width: 16px;
                    }

                    .menu a:hover {
                        background: rgba(185, 28, 28, .18);
                        color: #FFFFFF;
                    }

                    .menu a.active {
                        background: #B91C1C;
                        color: #FFFFFF;
                        box-shadow: 0 3px 8px rgba(185,28,28,.22);
                    }


            /* =========================================================
                               LOGOUT
                            ========================================================= */

            .logout {
                margin-top: auto;
                padding: 12px 9px 15px 9px;
            }

                .logout a {
                    color: #FFFFFF;
                    text-decoration: none;
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 10px 11px;
                    font-size: 13px;
                    font-weight: 500;
                    border-radius: 6px;
                    transition: all .2s ease;
                }

                    .logout a i {
                        font-size: 16px;
                    }

                    .logout a:hover {
                        background: rgba(185,28,28,.18);
                    }


            /* =========================================================
                               MAIN CONTENT
                            ========================================================= */

            .main-content {
                flex: 1;
                background: #F5F6F8;
                display: flex;
                flex-direction: column;
                height: 100vh;
                overflow: hidden;
            }


            /* =========================================================
                               TOPBAR
                            ========================================================= */

            .topbar {
                height: 56px;
                min-height: 56px;
                flex-shrink: 0;
                border-bottom: 1px solid #E5E7EB;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 20px;
                background: #FFFFFF;
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .menu-toggle {
                background: none;
                border: none;
                color: #B91C1C;
                font-size: 19px;
                cursor: pointer;
                padding: 5px;
            }


            /* =========================================================
                               TOPBAR RIGHT
                            ========================================================= */

            .topbar-right {
                display: flex;
                align-items: center;
                gap: 16px;
                margin-left: auto;
            }

            .notification-icon {
                font-size: 19px;
                color: #374151;
                cursor: pointer;
                transition: color .2s ease;
            }

                .notification-icon:hover {
                    color: #B91C1C;
                }


            /* =========================================================
                               PROFILE
                            ========================================================= */

            .profile {
                display: flex;
                align-items: center;
                gap: 9px;
                padding-left: 12px;
                border-left: 1px solid #E5E7EB;
            }

                .profile img {
                    width: 34px;
                    height: 34px;
                    border-radius: 50%;
                    object-fit: cover;
                }

            .profile-info {
                display: flex;
                flex-direction: column;
                line-height: 1.25;
            }

                .profile-info h5 {
                    margin: 0;
                    font-size: 12px;
                    font-weight: 600;
                    color: #111827;
                }

                .profile-info span {
                    font-size: 10px;
                    color: #6B7280;
                    margin-top: 2px;
                }

            .profile-arrow {
                color: #6B7280;
                font-size: 10px;
                margin-left: 3px;
            }


            /* =========================================================
                               CONTENT AREA
                            ========================================================= */

            .content-area {
                flex: 1;
                padding: 22px 30px;
                overflow-y: auto;
                overflow-x: hidden;
                scrollbar-width: thin;
                scrollbar-color: #C7CBD1 transparent;
            }

                .content-area::-webkit-scrollbar {
                    width: 6px;
                }

                .content-area::-webkit-scrollbar-thumb {
                    background: #C7CBD1;
                    border-radius: 10px;
                }

                .content-area::-webkit-scrollbar-track {
                    background: transparent;
                }


            /* =========================================================
                               PAGE HEADER
                            ========================================================= */

            .page-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 18px;
            }

            .page-title {
                color: #B91C1C;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: -0.2px;
                margin: 0 0 5px 0;
                line-height: 1.2;
            }

            .page-description {
                color: #64748B;
                font-size: 13px;
                font-weight: 400;
                margin: 0;
                line-height: 1.5;
            }


            /* =========================================================
                               ACTION BAR
                            ========================================================= */

            .action-bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 16px;
            }

            .search-filter {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
            }


            /* =========================================================
                               SEARCH
                            ========================================================= */

            .search-box {
                height: 36px;
                flex: 1;
                max-width: 540px;
                background: #FFFFFF;
                border-radius: 20px;
                border: 1px solid #E5E7EB;
                box-shadow: 0 3px 12px rgba(0,0,0,.05);
                display: flex;
                align-items: center;
                padding: 0 13px;
                gap: 9px;
            }

                .search-box i {
                    color: #6B7280;
                    font-size: 13px;
                }

                .search-box input {
                    width: 100%;
                    border: none;
                    outline: none;
                    background: transparent;
                    font-size: 11px;
                    font-weight: 400;
                    color: #374151;
                }

                    .search-box input::placeholder {
                        color: #9CA3AF;
                    }


            /* =========================================================
                               FILTERS
                            ========================================================= */

            .audit-filter {
                width: 120px;
                height: 36px;
                background: #FFFFFF;
                border: 1px solid #E5E7EB;
                border-radius: 6px;
                padding: 0 10px;
                font-size: 11px;
                font-weight: 500;
                color: #374151;
                outline: none;
                cursor: pointer;
            }

                .audit-filter:focus {
                    border-color: #B91C1C;
                    box-shadow: 0 0 0 2px rgba(185,28,28,.08);
                }


            /* =========================================================
                               TABLE CONTAINER
                            ========================================================= */

            .table-container {
                width: 100%;
                background: #FFFFFF;
                border: 1px solid #D9DDE3;
                border-radius: 8px;
                overflow-x: auto;
                overflow-y: hidden;
                box-shadow: 0 1px 2px rgba(0,0,0,.02);
            }

                .table-container::-webkit-scrollbar {
                    height: 6px;
                }

                .table-container::-webkit-scrollbar-thumb {
                    background: #C7CBD1;
                    border-radius: 10px;
                }

                .table-container::-webkit-scrollbar-track {
                    background: transparent;
                }


            /* =========================================================
                               AUDIT TABLE
                            ========================================================= */

            .audit-table {
                width: 100%;
                min-width: 1000px;
                border-collapse: collapse;
                border-spacing: 0;
                margin: 0;
                table-layout: fixed;
            }


                /* =========================================================
                               COLUMN WIDTHS
                            ========================================================= */

                /* DATE & TIME */
                .audit-table th:nth-child(1),
                .audit-table td:nth-child(1) {
                    width: 18%;
                }

                /* USERS */
                .audit-table th:nth-child(2),
                .audit-table td:nth-child(2) {
                    width: 15%;
                }

                /* ROLE */
                .audit-table th:nth-child(3),
                .audit-table td:nth-child(3) {
                    width: 12%;
                }

                /* ACTIVITY */
                .audit-table th:nth-child(4),
                .audit-table td:nth-child(4) {
                    width: 27%;
                }

                /* MODULE */
                .audit-table th:nth-child(5),
                .audit-table td:nth-child(5) {
                    width: 13%;
                }

                /* STATUS */
                .audit-table th:nth-child(6),
                .audit-table td:nth-child(6) {
                    width: 15%;
                }


                /* =========================================================
                               TABLE HEADER
                            ========================================================= */

                .audit-table thead {
                    background: #111111;
                }

                .audit-table th {
                    height: 40px;
                    padding: 0 14px;
                    background: #111111;
                    color: #FFFFFF;
                    border-bottom: 1px solid #111111;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: .15px;
                    vertical-align: middle;
                    white-space: nowrap;
                }


                    /* =========================================================
                               HEADER ALIGNMENT
                               DATE & TIME SAME AS REPORTS DATE GENERATED
                            ========================================================= */

                    .audit-table th:nth-child(1) {
                        text-align: center;
                    }

                    .audit-table th:nth-child(2),
                    .audit-table th:nth-child(3),
                    .audit-table th:nth-child(4) {
                        text-align: left;
                    }

                    .audit-table th:nth-child(5),
                    .audit-table th:nth-child(6) {
                        text-align: center;
                    }


                /* =========================================================
                               TABLE BODY
                            ========================================================= */

                .audit-table td {
                    height: 42px;
                    padding: 0 14px;
                    background: #FFFFFF;
                    color: #374151;
                    border-bottom: 1px solid #E5E7EB;
                    font-size: 10px;
                    font-weight: 500;
                    vertical-align: middle;
                    white-space: nowrap;
                }


                    /* =========================================================
                               BODY ALIGNMENT
                               DATE & TIME SAME AS REPORTS DATE GENERATED
                            ========================================================= */

                    .audit-table td:nth-child(1) {
                        text-align: center;
                        color: #4B5563;
                        font-weight: 500;
                    }

                    .audit-table td:nth-child(2),
                    .audit-table td:nth-child(3),
                    .audit-table td:nth-child(4) {
                        text-align: left;
                    }

                    .audit-table td:nth-child(5),
                    .audit-table td:nth-child(6) {
                        text-align: center;
                    }


            /* =========================================================
                               DATE & TIME COLUMN
                            ========================================================= */

            .date-column {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                width: 100%;
                min-height: 42px;
                line-height: 1.25;
                text-align: center;
            }

                .date-column > span:first-child {
                    display: block;
                    text-align: center;
                }

                .date-column .time {
                    display: block;
                    margin-top: 3px;
                    color: #6B7280;
                    font-size: 9px;
                    font-weight: 400;
                    text-align: center;
                }


            /* =========================================================
                               ROLE COLUMN
                            ========================================================= */

            .audit-table td:nth-child(3) {
                vertical-align: middle;
            }

            .role-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 70px;
                min-width: 70px;
                height: 23px;
                padding: 0 9px;
                border-radius: 5px;
                font-size: 9px;
                font-weight: 600;
                line-height: 1;
                white-space: nowrap;
            }

            .role-admin {
                background: #FEE2E2;
                color: #B91C1C;
            }

            .role-staff {
                background: #F3F4F6;
                color: #374151;
            }


            /* =========================================================
                               STATUS COLUMN
                            ========================================================= */

            .audit-table td:nth-child(6) {
                vertical-align: middle;
            }

            .success-badge,
            .failed-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 5px;
                width: 70px;
                min-width: 70px;
                height: 23px;
                padding: 0 9px;
                border-radius: 5px;
                font-size: 9px;
                font-weight: 600;
                line-height: 1;
                white-space: nowrap;
            }


            /* =========================================================
                               SUCCESS
                            ========================================================= */

            .success-badge {
                background: #DCFCE7;
                color: #15803D;
            }

                .success-badge::before {
                    content: "";
                    width: 5px;
                    height: 5px;
                    background: #15803D;
                    border-radius: 50%;
                }


            /* =========================================================
                               FAILED
                            ========================================================= */

            .failed-badge {
                background: #FEE2E2;
                color: #B91C1C;
            }

                .failed-badge::before {
                    content: "";
                    width: 5px;
                    height: 5px;
                    background: #B91C1C;
                    border-radius: 50%;
                }


            /* =========================================================
                               ACTIVITY COLUMN
                            ========================================================= */

            .audit-table td:nth-child(4) {
                overflow: hidden;
                text-overflow: ellipsis;
            }


            /* =========================================================
                               HOVER
                            ========================================================= */

            .audit-table tbody tr:hover td {
                background: #FEF2F2;
            }

            .audit-table tbody tr:last-child td {
                border-bottom: none;
            }


            /* =========================================================
                               PAGINATION
                            ========================================================= */

            .pagination-section {
                display: flex;
                align-items: center;
                justify-content: space-between;
                width: 100%;
                margin-top: 18px;
            }

            .showing-text {
                font-size: 10px;
                color: #374151;
                font-weight: 500;
            }

            .pagination-buttons {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .pagination-btn {
                height: 28px;
                padding: 0 12px;
                border: 1px solid #E5E7EB;
                background: #FFFFFF;
                border-radius: 5px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #6B7280;
                font-size: 9px;
                font-weight: 500;
                cursor: pointer;
                transition: all .2s ease;
            }

                .pagination-btn:hover {
                    background: #FEE2E2;
                    color: #B91C1C;
                    border-color: #FECACA;
                }

                .pagination-btn.next-btn {
                    background: #B91C1C;
                    color: #FFFFFF;
                    border-color: #B91C1C;
                }

                    .pagination-btn.next-btn:hover {
                        background: #991B1B;
                        color: #FFFFFF;
                    }


            /* =========================================================
                               RESPONSIVE
                            ========================================================= */

            @@media (max-width: 1000px) {

                .action-bar {
                    flex-wrap: wrap;
                }

                .search-filter {
                    width: 100%;
                }

                .search-box {
                    max-width: none;
                }

                .audit-filter {
                    width: 160px;
                }
            }


            @@media (max-width: 768px) {

                body {
                    overflow-y: auto;
                }

                .sidebar {
                    width: 78px;
                    min-width: 78px;
                }

                .system-name,
                .menu a span,
                .logout a span {
                    display: none;
                }

                .logo-section {
                    padding: 15px 8px;
                }

                .logo-circle {
                    width: 40px;
                    height: 40px;
                }

                .menu {
                    padding: 15px 8px;
                }

                    .menu a {
                        justify-content: center;
                        padding: 10px;
                    }

                .logout a {
                    justify-content: center;
                }

                .content-area {
                    padding: 16px;
                }

                .page-title {
                    font-size: 21px;
                }

                .page-description {
                    font-size: 12px;
                }

                .page-header {
                    margin-bottom: 16px;
                }

                .action-bar {
                    flex-direction: column;
                    align-items: stretch;
                }

                .search-filter {
                    width: 100%;
                    flex-direction: column;
                }

                .search-box {
                    width: 100%;
                    max-width: none;
                }

                .audit-filter {
                    width: 100%;
                }

                .table-container {
                    width: 100%;
                    overflow-x: auto;
                }

                .audit-table {
                    min-width: 1000px;
                }

                .pagination-section {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 10px;
                }

                .pagination-buttons {
                    align-self: flex-end;
                }
            }


            @@media (max-width: 500px) {

                .profile-info {
                    display: none;
                }

                .profile {
                    border-left: none;
                }

                .content-area {
                    padding: 12px;
                }
            }

    </style>

</head>

<body>

    <div class="dashboard-container">

        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/newlogo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>


            <div class="menu">

                <a href="@Url.Action("Dashboard", "Admin")">

                    <i class="bi bi-grid-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a href="@Url.Action("RequestManagement", "Admin")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Request
                    </span>

                </a>


                <a href="@Url.Action("RecordsManagement", "Admin")">

                    <i class="bi bi-folder2-open"></i>

                    <span>
                        Records
                    </span>

                </a>


                <a href="@Url.Action("ReportsManagement", "Admin")">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <a href="@Url.Action("AuditLogs", "Admin")"
                   class="active">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                <a href="@Url.Action("UsersManagement", "Admin")">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <a href="@Url.Action("Settings", "Admin")">

                    <i class="bi bi-gear-fill"></i>

                    <span>
                        Settings
                    </span>

                </a>

            </div>


            <div class="logout">

                <a href="@Url.Action("Login", "Admin")">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <div class="main-content">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <div class="topbar">

                <div class="topbar-left">

                    <button class="menu-toggle"
                            id="menuToggle"
                            type="button">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <div class="topbar-right">

                    <i class="bi bi-bell notification-icon"></i>


                    <div class="profile">

                        <img src="~/Images/adminpic.jpg"
                             alt="Profile" />

                        <div class="profile-info">

                            <h5>
                                John Cruz
                            </h5>

                            <span>
                                Administrator
                            </span>

                        </div>

                        <i class="bi bi-chevron-down profile-arrow"></i>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 CONTENT AREA
            ================================================== -->

            <div class="content-area">


                <!-- PAGE HEADER -->

                <div class="page-header">

