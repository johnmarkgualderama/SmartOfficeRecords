﻿@{
ViewBag.Title = "Profile";
Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - Smart Office Records System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background-color: #eaf6ed; /* Light mint background */
                min-height: 100vh;
                color: #334155;
                padding-top: 70px; /* Offset fixed navbar */
            }

            /* --- NAVBAR STYLING --- */
            .navbar-custom {
                background-color: #ffffff;
                border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                padding: 12px 24px;
            }

            .navbar-brand-custom {
                display: flex;
                align-items: center;
                text-decoration: none;
                gap: 10px;
            }

                .navbar-brand-custom img {
                    width: 40px;
                    height: 40px;
                    object-fit: contain;
                }

            .brand-text {
                color: #0f6328;
                font-weight: 700;
                line-height: 1.1;
                font-size: 14px;
                letter-spacing: 0.5px;
            }

                .brand-text span {
                    color: #1e293b;
                    font-weight: 500;
                    font-size: 12px;
                }

            .nav-links-custom {
                display: flex;
                gap: 30px;
                list-style: none;
                margin: 0;
                padding: 0;
                align-items: center;
            }

            .nav-link-custom {
                text-decoration: none;
                color: #64748b;
                font-weight: 500;
                font-size: 15px;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
            }

                .nav-link-custom:hover {
                    color: #16a34a;
                }

                .nav-link-custom.active {
                    color: #16a34a;
                    border-bottom: 2px solid #16a34a;
                    padding-bottom: 4px;
                    font-weight: 600;
                }

            .navbar-profile {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .notification-btn {
                background: none;
                border: none;
                color: #64748b;
                font-size: 20px;
                position: relative;
                cursor: pointer;
            }

            .profile-widget {
                display: flex;
                align-items: center;
                gap: 10px;
                background: #f8fafc;
                padding: 6px 12px;
                border-radius: 30px;
                border: 1px solid #e2e8f0;
                cursor: pointer;
            }

            .profile-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background-color: #ffb74d;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: 600;
                font-size: 13px;
            }

            .profile-info {
                text-align: left;
                line-height: 1.2;
            }

            .profile-name {
                font-size: 12px;
                font-weight: 600;
                color: #1e293b;
                display: block;
            }

            .profile-email {
                font-size: 10px;
                color: #64748b;
                display: block;
            }

            .profile-dropdown {
                min-width: 220px;
                border-radius: 16px;
                border: 1px solid #dbe4dc;
                padding: 10px 0;
                margin-top: 12px;
            }

                .profile-dropdown .dropdown-item {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 12px 18px;
                    font-size: 15px;
                    font-weight: 500;
                    color: #374151;
                }

                    .profile-dropdown .dropdown-item:hover {
                        background: #f0fdf4;
                        color: #16a34a;
                    }

            /* --- ACCOUNT MAIN CONTAINER STYLING --- */
            .page-container {
                max-width: 1300px;
                margin: 0 auto;
                padding: 40px 20px;
            }

            .heading-section {
                margin-bottom: 35px;
            }

            .page-title {
                color: #16a34a;
                font-size: 26px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .page-subtitle {
                color: #64748b;
                font-size: 14px;
                font-weight: 500;
                margin: 0;
            }

            .account-card {
                background-color: #ffffff;
                border-radius: 12px;
                padding: 40px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
                height: 100%;
            }

            .section-title-custom {
                font-size: 18px;
                font-weight: 700;
                color: #475569;
                margin-bottom: 30px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .section-title-custom i {
                    color: #16a34a;
                }

            /* --- IMAGE MATCHED LIST DISPLAY --- */
            .profile-info-table {
                display: flex;
                flex-direction: column;
                gap: 20px;
                margin-bottom: 35px;
            }

            .profile-info-row {
                display: flex;
                align-items: flex-start;
            }

            .profile-info-label-block {
                display: flex;
                align-items: center;
                gap: 14px;
                width: 200px;
                flex-shrink: 0;
                color: #64748b;
            }

                .profile-info-label-block i {
                    font-size: 22px;
                    color: #64748b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: 24px;
                }

            .profile-info-label-text {
                font-size: 15px;
                font-weight: 500;
            }

            .profile-info-value {
                font-size: 15px;
                font-weight: 500;
                color: #475569;
                line-height: 1.5;
            }

            /* Image Matched Status Pill */
            .status-pill-active {
                background-color: #6ee7b7; /* Bright soft green from image */
                color: #000000;
                font-weight: 700;
                font-size: 13px;
                padding: 4px 20px;
                border-radius: 8px;
                display: inline-block;
            }

            /* Image Matched Button Style */
            .btn-edit-profile-outline {
                background: transparent;
                color: #16a34a;
                font-weight: 700;
                font-size: 18px;
                padding: 12px;
                border-radius: 10px;
                border: 2px solid #16a34a;
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                transition: all 0.2s ease;
            }

                .btn-edit-profile-outline:hover {
                    background-color: #f0fdf4;
                    transform: translateY(-1px);
                }

            /* --- SIDEBAR PANEL STYLING --- */
            .sidebar-panel {
                background-color: #ffffff;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
                margin-bottom: 24px;
            }

            .sidebar-header {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 15px;
                font-weight: 700;
                color: #1e293b;
                margin-bottom: 12px;
            }

                .sidebar-header i {
                    color: #16a34a;
                    font-size: 18px;
                }

            .sidebar-body {
                font-size: 13px;
                color: #64748b;
                line-height: 1.6;
            }

            @@media (max-width: 991px) {
                .nav-links-custom {
                    display: none;
                }

                .profile-info-row {
                    flex-direction: column;
                    gap: 4px;
                }

                .profile-info-label-block {
                    width: 100%;
                }
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- Left: Brand Logo -->
            <a class="navbar-brand-custom" href="@Url.Action("ApplicantDash", "Applicant")">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text">
                    SMART OFFICE<br />
                    <span>RECORDS SYSTEM</span>
                </div>
            </a>

            <!-- Center: Navigation Links -->
            <ul class="nav-links-custom">
                <li>
                    <a href="@Url.Action("ApplicantDash", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-house-door-fill"></i> Home
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("BookInterview", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i> Book Interview
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("MyAppointment", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-person-bounding-box"></i> My Appointment
                    </a>
                </li>
            </ul>

            <!-- Right: Notifications & Profile -->
            <div class="navbar-profile">
                <button class="notification-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <div class="dropdown">
                    <div class="profile-widget" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="profile-avatar">JD</div>
                        <div class="profile-info">
                            <span class="profile-name">Juan Dela Cruz</span>
                            <span class="profile-email">juandelacruz@gmail.com</span>
                        </div>
                        <i class="bi bi-chevron-down text-muted ms-2"></i>
                    </div>

                    <ul class="dropdown-menu dropdown-menu-end profile-dropdown shadow">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Profile", "Applicant")">
                                <i class="bi bi-person-circle"></i> My Account
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("ApplicantLogin", "Applicant")">
                                <i class="bi bi-box-arrow-right"></i> Sign out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="page-container">

        <div class="heading-section">
            <h1 class="page-title">My Account</h1>
            <p class="page-subtitle">View and update your registered system records.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" id="errorAlert">@ViewBag.Error</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success" id="successAlert">@ViewBag.Success</div>
        }

    <div class="row g-4">
        <!-- Left Column: Profile View Box (Col-8) -->
        <div class="col-lg-8">
            <div class="account-card">

                <!-- ================= VIEW MODE ================= -->
                <div id="viewMode">

                    <h5 class="section-title-custom"><i class="bi bi-person-lines-fill"></i> Profile Details</h5>

                    <div class="profile-info-table">

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-person"></i>
                                <span class="profile-info-label-text">Full Name</span>
                            </div>
                            <div class="profile-info-value">@Model.FullName</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-person-badge"></i>
                                <span class="profile-info-label-text">Username</span>
                            </div>
                            <div class="profile-info-value">@Model.Username</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-envelope"></i>
                                <span class="profile-info-label-text">Email Address</span>
                            </div>
                            <div class="profile-info-value">@Model.Email</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-telephone"></i>
                                <span class="profile-info-label-text">Phone Number</span>
                            </div>
                            <div class="profile-info-value">@Model.ContactNumber</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-calendar3"></i>
                                <span class="profile-info-label-text">Birthdate</span>
                            </div>
                            <div class="profile-info-value">@Model.Birthdate.ToString("MMMM dd, yyyy")</div>
                        </div>

                        <div class="profile-info-row align-items-center">
                            <div class="profile-info-label-block">
                                <i class="bi bi-person-check"></i>
                                <span class="profile-info-label-text">Status</span>
                            </div>
                            <div class="profile-info-value">
                                <span class="status-pill-active">Active</span>
                            </div>
                        </div>

                    </div>

                    <button type="button" class="btn-edit-profile-outline" onclick="toggleEdit(true)">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </button>
                </div>
                    <script>
                                            function toggleEdit(showEdit) {
                                                document.getElementById('viewMode').style.display = showEdit ? 'none' : 'block';
                                                document.getElementById('editMode').style.display = showEdit ? 'block' : 'none';
                                            }
                    </script>
                    <script>
                                            // Auto-hide the success message after 10 seconds
                                            const successAlert = document.getElementById('successAlert');
                                            if (successAlert) {
                                                setTimeout(function () {
                                                    successAlert.style.transition = "opacity 0.5s ease";
                                                    successAlert.style.opacity = "0";
                                                    setTimeout(function () {
                                                        successAlert.remove(); // fully remove it from the page after the fade-out
                                                    }, 500);
                                                }, 3000); // 3,000 ms = 3 seconds
                                            }
                                            // Auto-hide the error message after 3 seconds
                                            const errorAlert = document.getElementById('errorAlert');
                                            if (errorAlert) {
                                                setTimeout(function () {
                                                    errorAlert.style.transition = "opacity 0.5s ease";
                                                    errorAlert.style.opacity = "0";
                                                    setTimeout(function () {
                                                        errorAlert.remove();
                                                    }, 500);
                                                }, 3000);
                                            }
                    </script>

                <!-- ================= EDIT MODE ================= -->
                <div id="editMode" style="display:none;">

                    <h5 class="section-title-custom"><i class="bi bi-pencil-square"></i> Edit Profile</h5>

                    @using (Html.BeginForm("Profile", "Applicant", FormMethod.Post))
                    {
                        <div class="profile-info-table">

                            <div class="profile-info-row">
                                <div class="profile-info-label-block">
                                    <i class="bi bi-person-badge"></i>
                                    <span class="profile-info-label-text">Username</span>
                                </div>
                                <div class="profile-info-value">
                                    <input type="text" name="Username" class="form-control" value="@Model.Username" required />
                                </div>
                            </div>

                            <div class="profile-info-row">
                                <div class="profile-info-label-block">
                                    <i class="bi bi-envelope"></i>
                                    <span class="profile-info-label-text">Email Address</span>
                                </div>
                                <div class="profile-info-value">
                                    <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                                </div>
                            </div>

                            <div class="profile-info-row">
                                <div class="profile-info-label-block">
                                    <i class="bi bi-telephone"></i>
                                    <span class="profile-info-label-text">Phone Number</span>
                                </div>
                                <div class="profile-info-value">
                                    <input type="text" name="ContactNumber" class="form-control" value="@Model.ContactNumber" required />
                                </div>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn-edit-profile-outline" onclick="toggleEdit(false)">Cancel</button>
                            <button type="submit" class="btn-edit-profile-outline">Save Changes</button>
                        </div>
                    }
                </div>

            </div>
        </div>

            <!-- Right Column: Sidebar Panels (Col-4) -->
            <div class="col-lg-4">

                <div class="sidebar-panel">
                    <div class="sidebar-header">
                        <i class="bi bi-shield-lock-fill"></i> Security Tip
                    </div>
                    <div class="sidebar-body">
                        Please keep your phone number and email information updated to avoid losing access to account announcements and verification documents.
                    </div>
                </div>

                <div class="sidebar-panel">
                    <div class="sidebar-header">
                        <i class="bi bi-info-circle-fill"></i> Help & Support
                    </div>
                    <div class="sidebar-body">
                        Need to change critical verification details? Get in touch with the main administration branch office.
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>