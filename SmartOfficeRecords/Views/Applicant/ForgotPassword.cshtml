@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password</title>


    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


    <!-- POPPINS FONT -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }


            html,
            body {
                width: 100%;
                height: 100%;
            }


            body {
                background: #F4F6F8;
                min-height: 100vh;
                overflow: hidden;
            }


            /* MAIN CONTAINER */
            .main-container {
                width: 100%;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            /* MAIN WRAPPER */
            .login-wrapper {
                width: 100%;
                height: 100vh;
                display: flex;
                overflow: hidden;
                background: #FFFFFF;
            }


            /* LEFT SIDE */
            .left-side {
                width: 40%;
                height: 100vh;
                background: linear-gradient( 145deg, #242D32 0%, #1A2024 45%, #101214 100% );
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }


                .left-side::before {
                    content: "";
                    position: absolute;
                    width: 500px;
                    height: 500px;
                    top: -250px;
                    left: -250px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.025);
                }


                .left-side::after {
                    content: "";
                    position: absolute;
                    width: 600px;
                    height: 600px;
                    right: -350px;
                    bottom: -350px;
                    border-radius: 50%;
                    background: rgba(237, 28, 36, 0.025);
                }


            .top-content {
                width: 100%;
                text-align: center;
                padding: 40px;
                position: relative;
                z-index: 2;
            }


                .top-content img {
                    width: 135px;
                    height: 135px;
                    object-fit: contain;
                    background: #FFFFFF;
                    padding: 10px;
                    border-radius: 50%;
                    margin-bottom: 32px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
                    transition: transform 0.3s ease;
                }


                    .top-content img:hover {
                        transform: scale(1.03);
                    }


                .top-content h1 {
                    color: #FFFFFF;
                    font-size: 31px;
                    font-weight: 700;
                    line-height: 1.55;
                    letter-spacing: 0.5px;
                    margin: 0;
                    text-align: center;
                    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
                }


            /* RIGHT SIDE */
            .right-side {
                width: 60%;
                height: 100vh;
                background: #F5F7F9;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }


            /* FORGOT PASSWORD CARD */
            .forgot-card {
                width: 100%;
                max-width: 494px;
                background: #FFFFFF;
                border: 1px solid #DCE2E7;
                border-radius: 7px;
                padding: 43px 46px 40px;
                text-align: center;
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.035);
                opacity: 0;
                animation: slideInCard 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }


            /* ICON */
            .forgot-icon {
                display: flex;
                justify-content: center;
                margin-bottom: 17px;
            }


            .icon-circle {
                width: 82px;
                height: 82px;
                border-radius: 50%;
                background: #FFF0F1;
                display: flex;
                align-items: center;
                justify-content: center;
            }


                .icon-circle i {
                    color: #ED1C24;
                    font-size: 38px;
                    line-height: 1;
                }


            /* TITLE */
            .forgot-card h2 {
                color: #20252A;
                font-size: 23px;
                font-weight: 700;
                line-height: 1.3;
                margin-bottom: 18px;
            }


            /* DESCRIPTION */
            .forgot-subtitle {
                max-width: 345px;
                margin: 0 auto 38px;
                color: #66727C;
                font-size: 13px;
                font-weight: 500;
                line-height: 1.65;
            }


            /* EMAIL INPUT */
            .input-group-custom {
                width: 100%;
                position: relative;
                margin-bottom: 35px;
            }


                .input-group-custom .left-icon {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #7F8A94;
                    font-size: 16px;
                    z-index: 2;
                    transition: color 0.2s ease;
                }


            .form-control-custom {
                width: 100%;
                height: 48px;
                border: 1px solid #E2DADB;
                border-radius: 7px;
                background: #FFFFFF;
                color: #30343A;
                outline: none;
                font-size: 13px;
                padding-left: 40px;
                padding-right: 15px;
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }


                .form-control-custom::placeholder {
                    color: #B0B5BC;
                    font-size: 13px;
                }


                .form-control-custom:hover {
                    border-color: #D6C8CA;
                }


                .form-control-custom:focus {
                    border-color: #ED1C24;
                    background: #FFFFFF;
                    box-shadow: 0 0 0 3px rgba(237, 28, 36, 0.09);
                }


            .input-group-custom:focus-within .left-icon {
                color: #ED1C24;
            }


            /* SEND CODE BUTTON */
            .btn-send-code {
                width: 100%;
                height: 50px;
                border: none;
                border-radius: 7px;
                background: #ED1C24;
                color: #FFFFFF;
                font-size: 16px;
                font-weight: 600;
                letter-spacing: 0.1px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
                box-shadow: 0 5px 14px rgba(237, 28, 36, 0.20);
            }


                .btn-send-code:hover {
                    background: #D8171F;
                    transform: translateY(-1px);
                    box-shadow: 0 8px 18px rgba(237, 28, 36, 0.28);
                }


                .btn-send-code:active {
                    background: #C9151C;
                    transform: translateY(0);
                    box-shadow: 0 4px 10px rgba(237, 28, 36, 0.20);
                }


                .btn-send-code i {
                    font-size: 18px;
                    margin-right: 8px;
                }


            /* DIVIDER */
            .divider {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 31px 0 18px;
            }


            .divider-line {
                flex: 1;
                height: 1px;
                background: #BFC3C7;
            }


            .divider span {
                color: #8D9297;
                font-size: 13px;
                font-weight: 400;
                padding: 0 2px;
            }


            /* BACK TO LOGIN */
            .back-login {
                margin-top: 0;
                margin-bottom: 34px;
            }


                .back-login a {
                    color: #ED1C24;
                    text-decoration: none;
                    font-size: 10px;
                    font-weight: 600;
                    transition: color 0.2s ease;
                }


                    .back-login a:hover {
                        color: #C9151C;
                        text-decoration: underline;
                    }


                .back-login i {
                    font-size: 10px;
                    margin-right: 4px;
                }


            /* SECURITY NOTE */
            .security-note {
                color: #B1B5BA;
                font-size: 9px;
                font-weight: 400;
                line-height: 1.5;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 4px;
            }


                .security-note i {
                    color: #8C969E;
                    font-size: 13px;
                }


                .security-note strong {
                    color: #ED1C24;
                    font-weight: 600;
                }


            /* ERROR MESSAGE */
            .error-message {
                background: #FFF1F2;
                border: 1px solid #FECDD3;
                color: #C9151C;
                text-align: center;
                padding: 10px;
                border-radius: 7px;
                margin-bottom: 18px;
                font-size: 11px;
                font-weight: 500;
            }


            /* SUCCESS MESSAGE */
            .success-message {
                background: #F5F6F7;
                border: 1px solid #DDE1E5;
                color: #46515A;
                text-align: center;
                padding: 10px;
                border-radius: 7px;
                margin-bottom: 18px;
                font-size: 11px;
                font-weight: 500;
            }


            /* ANIMATION */
            @@keyframes slideInCard {

                from {
                    opacity: 0;
                    transform: translateY(25px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }


            /* TABLET */
            @@media (max-width: 991px) {

                body {
                    overflow-y: auto;
                }


                .login-wrapper {
                    height: auto;
                    min-height: 100vh;
                    flex-direction: column;
                    overflow-y: auto;
                }


                .left-side {
                    width: 100%;
                    height: auto;
                    min-height: 300px;
                }


                .right-side {
                    width: 100%;
                    height: auto;
                    min-height: 600px;
                    padding: 40px 20px;
                }


                .top-content {
                    padding: 40px 20px;
                }


                    .top-content img {
                        width: 105px;
                        height: 105px;
                        margin-bottom: 20px;
                    }


                    .top-content h1 {
                        font-size: 25px;
                    }


                .forgot-card {
                    max-width: 500px;
                    padding: 40px 35px;
                }
            }


            /* MOBILE */
            @@media (max-width: 576px) {

                .left-side {
                    min-height: 270px;
                }


                .top-content {
                    padding: 30px 15px;
                }


                    .top-content img {
                        width: 90px;
                        height: 90px;
                    }


                    .top-content h1 {
                        font-size: 21px;
                    }


                .right-side {
                    padding: 25px 15px;
                }


                .forgot-card {
                    padding: 35px 24px;
                }


                .icon-circle {
                    width: 72px;
                    height: 72px;
                }


                    .icon-circle i {
                        font-size: 33px;
                    }


                .forgot-card h2 {
                    font-size: 21px;
                }


                .forgot-subtitle {
                    font-size: 12px;
                    margin-bottom: 30px;
                }


                .security-note {
                    font-size: 8px;
                }
            }

    </style>

</head>


<body>


    <div class="main-container">

        <div class="login-wrapper">


            <!-- LEFT SIDE -->
            <div class="left-side">

                <div class="top-content">

                    <img src="~/Images/logo.png"
                         alt="Smart Office Records System Logo" />

                    <h1>
                        SMART OFFICE
                        <br />
                        RECORDS SYSTEM
                    </h1>

                </div>

            </div>


            <!-- RIGHT SIDE -->
            <div class="right-side">

                <div class="forgot-card">

                    <div class="forgot-icon">
                        <div class="icon-circle">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                    </div>

                    <h2>Forgot Password?</h2>

                    <p class="forgot-subtitle">
                        Enter your registered email address and
                        <br />
                        we'll send you a code.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="error-message">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="success-message">
                            <i class="bi bi-check-circle me-1"></i>
                            @ViewBag.Success
                        </div>
                    }

                    @using (Html.BeginForm("ForgotPassword", "Applicant", FormMethod.Post))
                    {
                        <div class="input-group-custom">
                            <i class="bi bi-envelope left-icon"></i>

                            <input type="email"
                                   name="Email"
                                   class="form-control-custom"
                                   placeholder="Enter your email address"
                                   autocomplete="email"
                                   required />
                        </div>

                        <button type="submit" class="btn-send-code">
                            <i class="bi bi-send"></i>
                            Send Code
                        </button>
                    }

                    <div class="divider">
                        <div class="divider-line"></div>
                        <span>OR</span>
                        <div class="divider-line"></div>
                    </div>

                    <div class="back-login">
                        <a href="@Url.Action("ApplicantLogin", "Applicant")">
                            <i class="bi bi-arrow-left"></i>
                            Back to Login
                        </a>
                    </div>

                    <div class="security-note">
                        <i class="bi bi-shield-lock"></i>
                        <span>
                            For your security, the reset code will expire in
                            <strong>5 minutes.</strong>
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </div>


</body>
</html>