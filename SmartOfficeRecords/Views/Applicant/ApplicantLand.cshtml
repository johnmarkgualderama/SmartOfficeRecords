@{
    ViewBag.Title = "Applicant Land";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Office Records System - Work Avenue</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
            :root {
                --primary-red: #E11D2E;
                --dark-red: #C41425;
                --light-red: #FFF1F2;
                --black: #111111;
                --dark-black: #0B0B0B;
                --white: #FFFFFF;
                --light-gray: #F5F5F5;
                --medium-gray: #E5E5E5;
                --border-gray: #D9D9D9;
                --text-dark: #222222;
                --text-gray: #666666;
                --text-light: #888888;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--white);
                color: var(--text-dark);
                min-height: 100vh;
            }

            /* HEADER */
            .top-header {
                width: 100%;
                height: 72px;
                background-color: var(--black);
                position: sticky;
                top: 0;
                z-index: 1000;
                display: flex;
                align-items: center;
            }

            .header-container {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand-wrapper {
                display: flex;
                align-items: center;
                gap: 11px;
                height: 100%;
            }

            .brand-logo {
                width: 36px;
                height: 36px;
                object-fit: contain;
                display: block;
            }

            .brand-name {
                color: var(--white);
                font-size: 15px;
                font-weight: 600;
                line-height: 1;
                margin: 0;
                white-space: nowrap;
            }

            .nav-menu {
                display: flex;
                align-items: center;
                gap: 7px;
            }

                .nav-menu a {
                    color: #E5E5E5;
                    text-decoration: none;
                    font-size: 12px;
                    font-weight: 500;
                    padding: 10px 14px;
                    border-radius: 4px;
                    transition: all 0.25s ease;
                }

                    .nav-menu a:hover {
                        background-color: #2D2D2D;
                        color: var(--white);
                    }

                    .nav-menu a.active {
                        background-color: #383838;
                        color: var(--white);
                    }

            /* HERO */
            .hero {
                background-color: var(--light-gray);
                min-height: 310px;
                display: flex;
                align-items: center;
                border-bottom: 1px solid #E8E8E8;
                overflow: hidden;
            }

            .hero-container {
                padding-top: 42px;
                padding-bottom: 42px;
            }

            .hero-content {
                padding-left: 35px;
            }

            .hero h1 {
                color: var(--black);
                font-size: 34px;
                font-weight: 700;
                line-height: 1.3;
                letter-spacing: -0.8px;
                margin-bottom: 10px;
            }

                .hero h1 span {
                    color: var(--primary-red);
                }

            .hero-description {
                max-width: 550px;
                color: #68707A;
                font-size: 13px;
                font-weight: 400;
                line-height: 1.7;
                margin-bottom: 23px;
            }

            .hero-buttons {
                display: flex;
                align-items: center;
                gap: 24px;
            }

            .btn-signup,
            .btn-signin {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 145px;
                padding: 11px 28px;
                border-radius: 4px;
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.25s ease;
            }

            .btn-signup {
                background-color: var(--primary-red);
                border: 1px solid var(--primary-red);
                color: var(--white);
                box-shadow: 0 4px 10px rgba(225, 29, 46, 0.18);
            }

                .btn-signup:hover {
                    background-color: var(--dark-red);
                    border-color: var(--dark-red);
                    color: var(--white);
                    transform: translateY(-2px);
                    box-shadow: 0 7px 15px rgba(225, 29, 46, 0.25);
                }

            .btn-signin {
                background-color: var(--white);
                border: 1px solid var(--primary-red);
                color: var(--primary-red);
            }

                .btn-signin:hover {
                    background-color: var(--light-red);
                    border-color: var(--dark-red);
                    color: var(--dark-red);
                    transform: translateY(-2px);
                }

            /* HERO ILLUSTRATION */
            .hero-art {
                position: relative;
                width: 270px;
                height: 180px;
                margin: auto;
            }

            .document {
                position: absolute;
                width: 140px;
                height: 130px;
                background-color: var(--white);
                border: 5px solid #2D3236;
                border-radius: 9px;
                top: 2px;
                left: 45px;
                box-shadow: 0 5px 14px rgba(0, 0, 0, 0.08);
            }

            .document-circle {
                position: absolute;
                top: 12px;
                left: 11px;
                width: 14px;
                height: 14px;
                background-color: var(--primary-red);
                border-radius: 50%;
            }

                .document-circle::after {
                    content: "";
                    position: absolute;
                    width: 5px;
                    height: 5px;
                    background-color: var(--white);
                    border-radius: 50%;
                    top: 4px;
                    left: 4px;
                }

            .document-line {
                position: absolute;
                height: 3px;
                background-color: #D6D6D6;
                border-radius: 5px;
            }

            .line-one {
                width: 38px;
                top: 16px;
                left: 33px;
            }

            .line-two {
                width: 87px;
                top: 35px;
                left: 15px;
            }

            .line-three {
                width: 65px;
                top: 53px;
                left: 15px;
            }

            .line-four {
                width: 91px;
                top: 71px;
                left: 15px;
            }

            .line-five {
                width: 75px;
                top: 89px;
                left: 15px;
            }

            .calendar {
                position: absolute;
                width: 72px;
                height: 69px;
                background-color: var(--white);
                border-radius: 8px;
                left: 20px;
                bottom: 3px;
                overflow: hidden;
                box-shadow: 0 5px 14px rgba(0, 0, 0, 0.10);
            }

            .calendar-top {
                width: 100%;
                height: 20px;
                background-color: var(--primary-red);
            }

            .calendar-hook {
                position: absolute;
                width: 5px;
                height: 14px;
                background-color: #999999;
                top: -5px;
                border-radius: 3px;
                z-index: 2;
            }

            .hook-one {
                left: 16px;
            }

            .hook-two {
                right: 16px;
            }

            .calendar-grid {
                padding: 9px;
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 4px;
            }

                .calendar-grid span {
                    width: 7px;
                    height: 7px;
                    display: block;
                    background-color: #9AA4A9;
                    border-radius: 1px;
                }

            .folder {
                position: absolute;
                width: 80px;
                height: 61px;
                background-color: var(--dark-red);
                right: 13px;
                bottom: 3px;
                border-radius: 8px;
                box-shadow: 0 5px 14px rgba(0, 0, 0, 0.10);
            }

                .folder::before {
                    content: "";
                    position: absolute;
                    width: 35px;
                    height: 10px;
                    background-color: var(--dark-red);
                    top: -7px;
                    left: 9px;
                    border-radius: 5px 5px 0 0;
                }

            /* GUIDELINE */
            .guideline-section {
                background-color: var(--white);
                padding-top: 43px;
                padding-bottom: 38px;
            }

            .section-heading {
                text-align: center;
                margin-bottom: 29px;
            }

                .section-heading h2 {
                    color: var(--black);
                    font-size: 27px;
                    font-weight: 700;
                    line-height: 1.3;
                    margin-bottom: 7px;
                }

                .section-heading p {
                    max-width: 680px;
                    margin: 0 auto;
                    color: #777777;
                    font-size: 12px;
                    font-weight: 400;
                    line-height: 1.6;
                }

            .guideline-card {
                background-color: var(--white);
                border: 1px solid #E0E0E0;
                border-radius: 6px;
                min-height: 125px;
                padding: 17px 18px;
                box-shadow: 0 4px 13px rgba(0, 0, 0, 0.08);
                transition: all 0.25s ease;
            }

                .guideline-card:hover {
                    transform: translateY(-3px);
                    border-color: #C9C9C9;
                    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.10);
                }

            .guideline-label {
                color: #333333;
                font-size: 9px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                margin-bottom: 4px;
            }

            .guideline-title {
                color: var(--primary-red);
                font-size: 13px;
                font-weight: 700;
                line-height: 1.3;
                margin-bottom: 8px;
            }

            .guideline-description {
                color: #707070;
                font-size: 10px;
                font-weight: 400;
                line-height: 1.6;
                margin: 0;
            }

            /* CORE SYSTEM */
            .core-section {
                background-color: var(--light-gray);
                padding-top: 45px;
                padding-bottom: 43px;
            }

                .core-section .section-heading {
                    margin-bottom: 29px;
                }

            .core-card {
                background-color: var(--white);
                border: 1px solid #DFDFDF;
                border-radius: 6px;
                min-height: 135px;
                padding: 20px;
                box-shadow: 0 4px 13px rgba(0, 0, 0, 0.07);
                transition: all 0.25s ease;
            }

                .core-card:hover {
                    transform: translateY(-3px);
                    border-color: var(--primary-red);
                    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.10);
                }

            .core-icon {
                color: var(--primary-red);
                font-size: 18px;
                margin-bottom: 7px;
            }

            .core-card h5 {
                color: var(--primary-red);
                font-size: 13px;
                font-weight: 700;
                line-height: 1.3;
                margin-bottom: 8px;
            }

            .core-card p {
                color: #666666;
                font-size: 10px;
                font-weight: 400;
                line-height: 1.6;
                margin: 0;
            }

            /* ABOUT */
            .about-section {
                background-color: var(--white);
                padding-top: 45px;
                padding-bottom: 45px;
                border-top: 1px solid #E8E8E8;
            }

            .about-content h2 {
                color: var(--black);
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 12px;
            }

            .about-content p {
                color: #666666;
                font-size: 12px;
                line-height: 1.7;
                margin-bottom: 12px;
            }

            .about-highlight {
                background-color: var(--light-red);
                border-left: 3px solid var(--primary-red);
                border-radius: 4px;
                padding: 14px 16px;
                font-size: 11px;
                color: var(--dark-red);
                line-height: 1.6;
            }

            /* FOOTER */
            footer {
                background-color: var(--black);
                color: var(--white);
            }

            .footer-main {
                padding-top: 32px;
                padding-bottom: 23px;
            }

            .footer-brand {
                display: flex;
                align-items: center;
                gap: 9px;
                margin-bottom: 10px;
            }

            .footer-logo {
                width: 34px;
                height: 34px;
                object-fit: contain;
            }

            .footer-brand-text {
                color: var(--white);
                font-size: 11px;
                font-weight: 700;
                line-height: 1.2;
            }

                .footer-brand-text span {
                    display: block;
                    color: var(--primary-red);
                    font-size: 9px;
                    margin-top: 2px;
                }

            .footer-main .col-lg-4 > p {
                color: #C7C7C7;
                max-width: 390px;
                font-size: 9px;
                line-height: 1.65;
                margin-bottom: 9px;
            }

            .footer-column h6 {
                color: var(--white);
                font-size: 11px;
                font-weight: 600;
                margin-bottom: 11px;
            }

            .footer-column p,
            .footer-column a {
                color: #C7C7C7;
                font-size: 9px;
                font-weight: 400;
                line-height: 1.65;
                text-decoration: none;
                margin-bottom: 5px;
                display: block;
            }

                .footer-column a:hover {
                    color: var(--white);
                }

            .footer-social {
                margin-top: 9px;
            }

                .footer-social a {
                    display: inline-block;
                    margin-right: 9px;
                    color: var(--primary-red);
                    font-size: 13px;
                }

                    .footer-social a:hover {
                        color: #FF5361;
                    }

            .footer-bottom {
                border-top: 1px solid #353535;
                padding-top: 12px;
                padding-bottom: 12px;
            }

                .footer-bottom p {
                    color: #AFAFAF;
                    font-size: 9px;
                    margin: 0;
                }

            /* RESPONSIVE */
            @@media (max-width: 991px) {
                .hero {
                    min-height: auto;
                }

                .hero-content {
                    padding-left: 15px;
                }

                .hero h1 {
                    font-size: 30px;
                }

                .hero-art {
                    margin-top: 25px;
                }

                .guideline-card {
                    min-height: 135px;
                }
            }

            @@media (max-width: 767px) {
                .top-header {
                    height: auto;
                    padding-top: 13px;
                    padding-bottom: 13px;
                }

                .header-container {
                    padding-left: 20px;
                    padding-right: 20px;
                }

                .brand-logo {
                    width: 32px;
                    height: 32px;
                }

                .brand-name {
                    font-size: 13px;
                }

                .nav-menu {
                    display: none;
                }

                .hero {
                    text-align: center;
                }

                .hero-content {
                    padding-left: 10px;
                    padding-right: 10px;
                }

                .hero h1 {
                    font-size: 27px;
                }

                .hero-description {
                    margin-left: auto;
                    margin-right: auto;
                    font-size: 12px;
                }

                .hero-buttons {
                    justify-content: center;
                    flex-wrap: wrap;
                    gap: 12px;
                }

                .hero-art {
                    transform: scale(0.90);
                    margin-top: 20px;
                }

                .section-heading h2 {
                    font-size: 23px;
                }

                .section-heading p {
                    font-size: 11px;
                }

                .guideline-section, .core-section, .about-section {
                    padding-left: 15px;
                    padding-right: 15px;
                }

                .footer-main {
                    padding-left: 15px;
                    padding-right: 15px;
                }
            }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header class="top-header">
        <div class="container header-container">

            <div class="brand-wrapper">
                <img src="~/Images/logo.png" alt="Smart Office Records Logo" class="brand-logo" />
                <p class="brand-name">Smart Office Records</p>
            </div>

            <nav class="nav-menu">
                <a href="#" class="active">Home</a>
                <a href="#about">About Us</a>
                <a href="#architecture">System Modules</a>
                <a href="#workflow">Applicant Steps</a>
            </nav>

        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="container hero-container">
            <div class="row align-items-center">

                <div class="col-lg-7">
                    <div class="hero-content">
                        <h1>Interview Booking and <br />Records <span>Portal</span></h1>

                        <p class="hero-description">
                            Welcome to the Smart Office Records System for Work Avenue and Business Solutions, Inc.
                            Applicants must create and validate an account before they are eligible to schedule and lock
                            in their official interview dates.
                        </p>

                        <div class="hero-buttons">
                            <a href="@Url.Action("ApplicantRegister", "Applicant")" class="btn-signup">SIGN UP</a>
                            <a href="@Url.Action("ApplicantLogin", "Applicant")" class="btn-signin">SIGN IN NOW</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="hero-art">
                        <div class="document">
                            <div class="document-circle"></div>
                            <div class="document-line line-one"></div>
                            <div class="document-line line-two"></div>
                            <div class="document-line line-three"></div>
                            <div class="document-line line-four"></div>
                            <div class="document-line line-five"></div>
                        </div>

                        <div class="calendar">
                            <div class="calendar-top"></div>
                            <div class="calendar-hook hook-one"></div>
                            <div class="calendar-hook hook-two"></div>
                            <div class="calendar-grid">
                                <span></span><span></span><span></span><span></span>
                                <span></span><span></span><span></span><span></span>
                                <span></span><span></span><span></span><span></span>
                            </div>
                        </div>

                        <div class="folder"></div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- BOOKING GUIDELINE -->
    <section id="workflow" class="guideline-section">
        <div class="container">

            <div class="section-heading">
                <h2>The Booking & Interview Guideline</h2>
                <p>Please follow the sequential timeline to complete your application entry successfully.</p>
            </div>

            <div class="row g-3">

                <div class="col-lg-3 col-md-6">
                    <div class="guideline-card">
                        <div class="guideline-label">REQUIRED FIRST</div>
                        <div class="guideline-title">Account Registration</div>
                        <p class="guideline-description">
                            Create your unique profile using verified personal details and upload a valid identity
                            document for administrative validation.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="guideline-card">
                        <div class="guideline-label">BOOKING ACCESS</div>
                        <div class="guideline-title">Schedule Your Interview</div>
                        <p class="guideline-description">
                            Once logged in, open the scheduling module to select an available interview schedule.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="guideline-card">
                        <div class="guideline-label">FRONT DESK CHECK</div>
                        <div class="guideline-title">Documentation Verification</div>
                        <p class="guideline-description">
                            Arrive at the office with the required documents and valid identification for verification.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="guideline-card">
                        <div class="guideline-label">LIVE UPDATE</div>
                        <div class="guideline-title">Monitoring & PDF Logs</div>
                        <p class="guideline-description">
                            Track your application progress and access official system records and reports.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CORE SYSTEM BOUNDARIES -->
    <section id="architecture" class="core-section">
        <div class="container">

            <div class="section-heading">
                <h2>Core System Boundaries</h2>
                <p>Engineered specifically to solve structural operational challenges within the Philippine Service Industry.</p>
            </div>

            <div class="row g-4 justify-content-center">

                <div class="col-lg-4 col-md-6">
                    <div class="core-card">
                        <div class="core-icon"><i class="bi bi-person-check-fill"></i></div>
                        <h5>User Account Validation</h5>
                        <p>
                            Protects office integrity boundaries by enforcing role-based authorization parameters
                            and account identity matching upon submission.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="core-card">
                        <div class="core-icon"><i class="bi bi-activity"></i></div>
                        <h5>Monitoring Feature</h5>
                        <p>
                            Tracks and updates the status of individual requests and interview sequences dynamically
                            on system dashboards.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="core-card">
                        <div class="core-icon"><i class="bi bi-file-earmark-pdf-fill"></i></div>
                        <h5>PDF Report Export</h5>
                        <p>
                            Instantly extracts transactional activity reports, scheduling records, and official
                            summary files securely.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ABOUT US -->
    <section id="about" class="about-section">
        <div class="container">
            <div class="row align-items-center g-4">

                <div class="col-lg-7">
                    <div class="about-content">
                        <h2>About Our Institutional Framework</h2>
                        <p>
                            The Smart Office Records System (SORS) is a dedicated operational engine designed to
                            enhance organizational efficiency, process visibility, and systematic consistency for
                            local enterprise operations.
                        </p>
                        <p>
                            Developed in an academic context for the College of Computer Studies, this platform
                            demonstrates the structural integration of secure user access levels with complex
                            scheduling rules.
                        </p>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="about-highlight">
                        <i class="bi bi-rocket-takeoff-fill me-1"></i>
                        By transforming archaic manual booking books into real-time metrics trackers, the system
                        brings optimal administrative stability right to the modern Philippine enterprise framework.
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>

        <div class="footer-main">
            <div class="container">
                <div class="row g-4">

                    <div class="col-lg-4 col-md-6">
                        <div class="footer-brand">
                            <img src="~/Images/logo.png" alt="SORS Logo" class="footer-logo" />
                            <div class="footer-brand-text">
                                Smart Office
                                <span>Records System</span>
                            </div>
                        </div>

                        <p>
                            A centralized interview booking and records management system designed to streamline
                            applicant registration, interview scheduling, and record monitoring.
                        </p>

                        <div class="footer-social">
                            <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                            <a href="#" aria-label="Email"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6 footer-column">
                        <h6>About Us</h6>
                        <p>
                            Smart Office Records System is a web platform designed to simplify the management of
                            applicant information, interview schedules, and office records.
                        </p>
                        <p>It helps make the hiring process more organized, accessible, and efficient.</p>
                    </div>

                    <div class="col-lg-2 col-md-6 footer-column">
                        <h6>Contact Us</h6>
                        <p><i class="bi bi-envelope me-1"></i>smart.office.records@gmail.com</p>
                        <p><i class="bi bi-telephone me-1"></i>+63 963 968 6682</p>
                        <p><i class="bi bi-clock me-1"></i>Monday - Friday</p>
