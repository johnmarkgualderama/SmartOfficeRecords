﻿@{
ViewBag.Title = "Applicant Land";
Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Office Records System - Work Avenue</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary-green: #16a34a;
                --dark-green: #166534;
                --light-mint: #dcfce7;
                --surface-white: #ffffff;
                --text-dark: #166534;
                --text-muted: #ffffff;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background-color: #f8fafc;
                color: var(--text-dark);
                min-height: 100vh;
            }

            /* HEADER */
            .top-header {
                height: 80px;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(8px);
                position: sticky;
                top: 0;
                z-index: 1000;
                border-bottom: 1px solid #e2e8f0;
            }

            .logo-text h4 {
                color: var(--primary-green);
                font-size: 20px;
                font-weight: 700;
                margin: 0;
                line-height: 1.1;
                letter-spacing: -0.5px;
            }

            .logo-text span {
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1px;
                color: var(--text-dark);
            }

            .nav-menu a {
                text-decoration: none;
                color: #475569;
                font-weight: 500;
                font-size: 14px;
                padding: 8px 16px;
                border-radius: 6px;
                transition: all 0.2s ease;
            }

                .nav-menu a:hover {
                    color: var(--primary-green);
                    background: var(--light-mint);
                }

                .nav-menu a.active {
                    background: #dcfce7;
                    color: #166534;
                    font-weight: 600;
                }

            /* HERO SECTION */
            .hero {
                min-height: 540px;
                background: linear-gradient(135deg,#dcfce7,#bbf7d0);
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
            }

                .hero::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(circle, #bbf7d0 1.5px, transparent 1.5px);
                    background-size: 40px 40px;
                    opacity: 0.6;
                    z-index: 1;
                }

            .hero-content {
                position: relative;
                z-index: 2;
            }

            .hero h1 {
                font-size: 2.85rem;
                font-weight: 700;
                color: var(--dark-green);
                line-height: 1.25;
                letter-spacing: -1px;
            }

            .hero p {
                max-width: 800px;
                margin: 1.5rem auto;
                color: #334155;
                font-size: 1.05rem;
                line-height: 1.6;
            }

            /* COMMON BUTTON EFFECT */
            .btn-green,
            .btn-book {
                position: relative;
                overflow: hidden;
                transition: all .35s ease;
            }

            /* REGISTER BUTTON */
            .btn-green {
                background: linear-gradient(135deg,#16a34a,#15803d);
                color: white;
                padding: 14px 38px;
                border-radius: 10px;
                font-weight: 600;
                border: none;
                box-shadow: 0 5px 18px rgba(22,163,74,.25);
            }

                .btn-green:hover {
                    color: white;
                    transform: translateY(-4px) scale(1.02);
                    box-shadow: 0 12px 25px rgba(22,163,74,.35), 0 0 20px rgba(34,197,94,.25);
                }

                .btn-green:active {
                    transform: translateY(-1px);
                }

            /* LOGIN BUTTON */
            .btn-book {
                background: white;
                border: 2px solid #16a34a;
                color: #166534;
                border-radius: 10px;
                padding: 14px 38px;
                font-weight: 600;
                box-shadow: 0 5px 18px rgba(0,0,0,.05);
            }

                .btn-book:hover {
                    background: white;
                    color: #166534;
                    transform: translateY(-4px) scale(1.02);
                    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15), 0 0 20px rgba(0, 0, 0, 0.08);
                }

                .btn-book:active {
                    transform: translateY(-1px);
                }

            /* SECTION TEXT HEADER */
            .section-title {
                color: #166534;
                font-weight: 700;
                position: relative;
                display: inline-block;
                margin-bottom: 10px;
            }

            /* CARDS / CONTAINERS */
            .custom-card {
                background: var(--surface-white);
                border: 1px solid #bbf7d0;
                border-radius: 16px;
                padding: 28px;
                box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
                height: 100%;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .custom-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 12px 24px -4px rgba(16, 185, 129, 0.08);
                    border-color: #16a34a;
                }

            /* ICON CIRCLE */
            .icon-circle {
                width: 52px;
                height: 52px;
                background: var(--light-mint);
                color: var(--primary-green);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                margin-bottom: 18px;
            }

            /* WORKFLOW TIMELINE STEP */
            .step-number {
                font-size: 13px;
                font-weight: 700;
                color: var(--primary-green);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 6px;
                display: block;
            }

            .workflow-box {
                background: white;
                border: 1px solid #bbf7d0;
                border-radius: 12px;
                transition: all 0.2s ease;
            }

                .workflow-box.highlighted {
                    border-color: var(--primary-green);
                    background: linear-gradient(to bottom, #ffffff, #f0fdf4);
                    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.05);
                }

            /* CONTACT FORM INPUTS */
            .contact-input {
                width: 100%;
                padding: 12px 16px;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                outline: none;
                font-size: 14px;
                transition: all 0.2s ease;
            }

                .contact-input:focus {
                    border-color: var(--primary-green);
                    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.1);
                }

            /* FOOTER */
            footer {
                background: #166534;
                color: #94a3b8;
                padding: 60px 0 30px 0;
            }

                footer h5 {
                    color: white;
                    font-size: 14px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    margin-bottom: 20px;
                }

                footer p, footer a {
                    font-size: 13.5px;
                    color: var(--text-muted);
                    text-decoration: none;
                    margin-bottom: 10px;
                    display: block;
                    transition: color 0.2s ease;
                }

                    footer a:hover {
                        color: #ffffff;
                    }

            @@media (max-width: 991px) {
                .hero h1 {
                    font-size: 2.25rem;
                }
            }
    </style>
</head>

<body>

    <!-- HEADER -->
    <div class="top-header">
        <div class="container h-100 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <img src="~/Images/logo.png" alt="SORS Logo" style="width: 40px;">
                <div class="logo-text">
                    <h4>SMART OFFICE</h4>
                    <span>RECORDS SYSTEM</span>
                </div>
            </div>

            <!-- Combined Nav Links and Header Action Buttons -->
            <div class="d-none d-md-flex align-items-center gap-4">
                <div class="nav-menu d-flex gap-2">
                    <a href="#" class="active">Home</a>
                    <a href="#architecture">System Modules</a>
                    <a href="#workflow">Applicant Steps</a>
                    <a href="#about">About Us</a>
                    <a href="#contact">Contact</a>
                </div>

                <!-- Top Action Buttons -->
                <div class="d-flex gap-2">
                    <a href="@Url.Action("ApplicantLogin", "Applicant")"
                       class="btn border border-success text-success px-3 py-1.5 fw-semibold btn-sm transition-all"
                       style="border-radius: 6px; font-size: 13.5px; text-decoration: none;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                    <a href="@Url.Action("ApplicantRegister", "Applicant")"
                       class="btn btn-success px-3 py-1.5 fw-semibold btn-sm text-white"
                       style="background: linear-gradient(135deg,#16a34a,#15803d); border-radius: 6px; font-size: 13.5px; border: none; text-decoration: none;">
                        <i class="bi bi-person-plus-fill me-1"></i> Sign Up
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- HERO SECTION -->
    <section class="hero text-center">
        <div class="container hero-content">
            <h1 class="px-3">Interview Booking & Records Portal</h1>
            <p class="px-4">
                Welcome to the <strong>Smart Office Records System</strong> for Work Avenue and Business Solutions, Inc.
                Applicants must create and validate an account before they are eligible to schedule and lock in their official interview dates.
            </p>
            <div class="gap-3 d-flex justify-content-center flex-wrap mt-3">
                <a href="@Url.Action("ApplicantRegister", "Applicant")"
                   class="btn btn-green">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    SIGN UP  & BOOK NOW!
                </a>
                <a href="@Url.Action("ApplicantLogin", "Applicant")"
                   class="btn btn-book">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    SIGN IN NOW!
                </a>
            </div>
        </div>
    </section>

    <!-- APPLICANT HIERARCHICAL WORKFLOW -->
    <section id="workflow" class="py-5 bg-light border-top border-bottom">
        <div class="container py-3">
            <div class="text-center mb-5">
                <h2 class="section-title">The Booking & Interview Guideline</h2>
                <p class="text-secondary mx-auto" style="max-width: 600px;">
                    Please follow the sequential timeline to complete your application entry successfully.
                </p>
            </div>

            <div class="row g-4 justify-content-center">
                <!-- Step 1 -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 workflow-box highlighted text-center h-100">
                        <span class="step-number"><i class="bi bi-1-circle-fill me-1"></i> Required First</span>
                        <h5 class="fw-bold text-dark small mb-2">Account Registration</h5>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            Create your unique profile using verified personal details and upload a valid identity card for administrative validation.
                        </p>
                    </div>
                </div>
                <!-- Step 2 -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 workflow-box text-center h-100">
                        <span class="step-number"><i class="bi bi-2-circle-fill me-1"></i> Booking Access</span>
                        <h5 class="fw-bold text-dark small mb-2">Schedule Your Interview</h5>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            Once logged in, open the scheduling module to select an available service time and request an official interview date slot.
                        </p>
                    </div>
                </div>
                <!-- Step 3 -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 workflow-box text-center h-100">
                        <span class="step-number"><i class="bi bi-3-circle-fill me-1"></i> Front Desk Check</span>
                        <h5 class="fw-bold text-dark small mb-2">Document Verification</h5>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            Arrive at the office to lodge required physical duplicates (resumes, valid IDs) to match your digital system record.
                        </p>
                    </div>
                </div>
                <!-- Step 4 -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-4 workflow-box text-center h-100">
                        <span class="step-number"><i class="bi bi-4-circle-fill me-1"></i> Live Update</span>
                        <h5 class="fw-bold text-dark small mb-2">Monitoring & PDF Logs</h5>
                        <p class="text-muted mb-0" style="font-size: 12px;">
                            Track queue progress via real-time monitoring dashboards and download an official summary report in PDF format upon completion.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CORE FUNCTIONAL MODULES SECTION -->
    <section id="architecture" class="container py-5 my-4">
        <div class="text-center mb-5">
            <h2 class="section-title">Core System Boundaries</h2>
            <p class="text-secondary mx-auto" style="max-width: 650px;">
                Engineered specifically to solve structural operational challenges within the Philippine Service Industry.
            </p>
        </div>

        <div class="row g-4">
            <!-- Security Module -->
            <div class="col-md-4">
                <div class="custom-card">
                    <div class="icon-circle">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h5 class="fw-bold mb-2">User Account Validation</h5>
                    <p class="text-secondary small lh-base mb-0">Protects office integrity boundaries by enforcing role-based authorization parameters and account identity matching upon submission.</p>
                </div>
            </div>
            <!-- Document Tracking Module -->
            <div class="col-md-4">
                <div class="custom-card">
                    <div class="icon-circle">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Monitoring Feature</h5>
                    <p class="text-secondary small lh-base mb-0">Tracks and updates the status of individual requests and interview sequences dynamically on structural dashboards.</p>
                </div>
            </div>
            <!-- Report Generation Module -->
            <div class="col-md-4">
                <div class="custom-card">
                    <div class="icon-circle">
                        <i class="bi bi-filetype-pdf"></i>
                    </div>
                    <h5 class="fw-bold mb-2">PDF Report Export</h5>
                    <p class="text-secondary small lh-base mb-0">Instantly extracts transactional activity reports, scheduling records histories, and official summary files securely.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT US SECTION -->
    <section id="about" class="py-5 bg-white border-top">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2 class="section-title mb-3">About Our Institutional Framework</h2>
                    <p class="text-secondary sm-lead mb-4">
                        The Smart Office Records System (SORS) is a dedicated operational engine designed to enhance organizational efficiency, process visibility, and systematic consistency for local enterprise operations.
                    </p>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 text-dark fw-semibold mb-2">
                                <i class="bi bi-check-circle-fill text-success"></i> Optimized Pipelines
                            </div>
                            <p class="text-secondary small">Eliminates application delays with automated record assignment rules.</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2 text-dark fw-semibold mb-2">
                                <i class="bi bi-check-circle-fill text-success"></i> Complete Integrity
                            </div>
                            <p class="text-secondary small">Maintains accountability structures across the recruitment lifespan.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="p-4 rounded-4" style="background-color: #f0fdf4; border: 1px dashed var(--primary-green);">
                        <h4 class="fw-bold mb-3"><i class="bi bi-rocket-takeoff-fill me-2 text-success"></i>Our Core Mission</h4>
                        <p class="text-secondary small mb-3">
                            Developed specifically in an academic context for the College of Computer Studies, this platform demonstrates the structural integration of secure user access levels with complex scheduling rules.
                        </p>
                        <p class="text-secondary small mb-0">
                            By transforming archaic manual booking books into real-time metrics trackers, the system brings optimal administrative stability right to the modern Philippine enterprise framework.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="py-5 bg-light border-top">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="section-title">Connect With Us</h2>
                <p class="text-secondary mx-auto" style="max-width: 600px;">
                    Have questions regarding your interview validation pipeline? Reach out through our direct touchpoints.
                </p>
            </div>

            <div class="row g-4 justify-content-center">
                <!-- Contact Details Info Cards -->
                <div class="col-lg-4">
                    <div class="d-flex flex-column gap-3 h-100 justify-content-between">
                        <div class="custom-card p-3 d-flex align-items-center gap-3">
                            <div class="icon-circle mb-0 flex-shrink-0">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Office Address</h6>
                                <p class="text-secondary small mb-0">
                                    Unit 3 Ground Floor Ranulfo Bldg. 206 F. Ramos St. Cebu City,
                                    Philippines
                                </p>
                            </div>
                        </div>

                        <div class="custom-card p-3 d-flex align-items-center gap-3">
                            <div class="icon-circle mb-0 flex-shrink-0">
                                <i class="bi bi-envelope-at"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Email Support</h6>
                                <p class="text-secondary small mb-0">smartOffice@gmail.com</p>
                            </div>
                        </div>

                        <div class="custom-card p-3 d-flex align-items-center gap-3">
                            <div class="icon-circle mb-0 flex-shrink-0">
                                <i class="bi bi-telephone-inbound"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Contact Number</h6>
                                <p class="text-secondary small mb-0">+63 (32) 412 8900</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Simple Contact Card Form Component -->
                <div class="col-lg-6">
                    <div class="custom-card">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-chat-left-dots-fill text-success me-2"></i>Send an Inquiry</h5>
                        <form action="#" method="post" onsubmit="event.preventDefault(); alert('Inquiry Simulation Sent.');">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <input type="text" class="contact-input" placeholder="Your Name" required />
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="contact-input" placeholder="Your Email Address" required />
                                </div>
                                <div class="col-12">
                                    <input type="text" class="contact-input" placeholder="Subject Topic" required />
                                </div>
                                <div class="col-12">
                                    <textarea class="contact-input" rows="3" placeholder="Write your context messages details here..." required></textarea>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-green w-100 py-2.5 rounded-3 font-semibold text-sm">
                                        Send Message Entry
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <img src="~/Images/logo.png" width="36" alt="SORS Footer Logo">
                        <span class="text-white fw-bold tracking-wider small">SMART OFFICE RECORDS SYSTEM</span>
                    </div>
                    <p class="small text-white pe-4">Developed as an institutional framework optimization targeting organizational accountability boundaries inside the Philippine Service Sector.</p>
                </div>
                <div class="col-lg-3 col-6">
                    <h5>Academic Context</h5>
                    <p class="small text-white mb-1">Asian College of Technology</p>
                    <p class="small text-white mb-0">College of Computer Studies</p>
                </div>
                <div class="col-lg-3 col-6">
                    <h5>System Scope</h5>
                    <p class="small text-white mb-1"><i class="bi bi-check-circle-fill text-success me-2"></i>Interview Scheduling</p>
                    <p class="small text-white mb-0"><i class="bi bi-check-circle-fill text-success me-2"></i>PDF Reporting Logs</p>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small opacity-50">
                <p class="mb-2 mb-sm-0">© 2026 Smart Office Records System. All rights reserved.</p>
                <p class="mb-0">Designed & Developed by JJJ</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>