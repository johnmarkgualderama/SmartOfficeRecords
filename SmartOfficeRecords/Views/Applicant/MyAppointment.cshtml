    <!-- =========================================================
         MAIN CONTENT
    ========================================================= -->

    <div class="page-container">


        <!-- PAGE HEADING -->
        <div class="heading-section">

            <div>

                <h1 class="page-title">
                    My Appointments
                </h1>

                <p class="page-subtitle">
                    View your schedule interview details below.
                </p>

            </div>

            <div class="date-pill-container">

                <div class="date-pill-value" id="currentDate">
                    @DateTime.Today.ToString("MMMM dd, yyyy")
                </div>

                <div class="date-pill-day" id="currentDay">
                    @DateTime.Today.ToString("dddd")
                </div>

            </div>

        </div>
        <!-- =====================================================
             MAIN SCHEDULE CARD
        ===================================================== -->

        <div class="schedules-card">


            <!-- CARD HEADER -->
            <div class="card-header-flex">

                <h2 class="card-title-custom">

                    <i class="bi bi-calendar-event-fill"></i>

                    Schedules Interviews

                </h2>


                <!-- SEARCH -->
                <div class="search-wrapper">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           class="search-input"
                           placeholder="Search here..." />

                </div>

            </div>
            <!-- =================================================
                 UPCOMING APPOINTMENT
            ================================================== -->

            <div class="mb-5">

                <h3 class="section-table-title">
                    Upcoming appointment
                </h3>

                <div class="custom-table-container">

                    <table class="custom-table">

                        <thead>
                            <tr>
                                <th style="width: 22%;">Email Address</th>
                                <th style="width: 25%;">Date & Time</th>
                                <th style="width: 15%;">Status</th>
                                <th style="width: 18%;">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                // Upcoming = not yet happened AND still Pending or Approved
                                var upcomingList = Model
                                    .Where(a => a.AppointmentDate >= DateTime.Today &&
                                                (a.Status == "Pending" || a.Status == "Approved"))
                                    .OrderBy(a => a.AppointmentDate)
                                    .ToList();
                            }

                            @if (upcomingList.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No upcoming appointment yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var appt in upcomingList)
                                {
                                    string statusClass = appt.Status == "Approved" ? "status-pill-approved" : "status-pill-pending";
                                    string statusText = appt.Status == "Approved" ? "CONFIRMED" : "Pending";

                                    <tr>

                                        <td>@appt.Email</td>

                                        <td>
                                            <div class="datetime-flex">
                                                <div class="datetime-item">
                                                    <i class="bi bi-calendar3"></i>
                                                    @appt.AppointmentDate.ToString("MMMM dd, yyyy (dddd)")
                                                </div>
                                                <div class="datetime-item">
                                                    <i class="bi bi-clock"></i>
                                                    @DateTime.Today.Add(appt.AppointmentTime).ToString("hh:mm tt")
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="@statusClass">@statusText</span>
                                        </td>
                                        <td>
                                            @if (appt.Status == "Pending")
                                            {
                                                <div class="action-wrapper">
                                                    <div class="btn-row">
                                                        <button type="button"
                                                                class="btn-action-edit"
                                                                data-id="@appt.AppointmentId"
                                                                data-email="@appt.Email"
                                                                data-date="@appt.AppointmentDate.ToString("yyyy-MM-dd")"
                                                                data-time="@DateTime.Today.Add(appt.AppointmentTime).ToString("hh:mm tt")"
                                                                onclick="openEditBookModal(this)">
                                                            <i class="bi bi-pencil"></i> Edit
                                                        </button>

                                                        <form id="cancelForm-@appt.AppointmentId"
                                                              action="@Url.Action("CancelAppointment", "Applicant")"
                                                              method="post"
                                                              style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="AppointmentId" value="@appt.AppointmentId" />
                                                            <button type="button" class="btn-action-cancel" onclick="openCancelConfirmModal('@appt.AppointmentId')">
                                                                <i class="bi bi-trash"></i> Cancel
                                                            </button>  
                                                        </form>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No actions available</span>
                                            }
                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>
                    <!-- =========================================================
                 CANCEL CONFIRM MODAL
            ========================================================= -->

                    <div class="eb-overlay" id="cancelConfirmOverlay">

                        <div class="cc-wrapper">

                            <div class="cc-label">CANCEL</div>

                            <div class="cc-card">

                                <div class="cc-icon">
                                    <i class="bi bi-file-earmark-excel"></i>
                                    <i class="bi bi-clipboard-x"></i>
                                    <i class="bi bi-file-earmark-minus"></i>
                                </div>

                                <h2 class="cc-title">Cancel Appointment?</h2>
                                <p class="cc-subtitle">
                                    Are you sure you want to cancel your appointment? This action cannot be undone.
                                </p>

                                <div class="eb-actions">
                                    <button type="button" class="eb-btn-cancel" id="cancelConfirmNoBtn">No</button>
                                    <button type="button" class="eb-btn-save" id="cancelConfirmYesBtn">Yes</button>
                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- =========================================================
                 CANCEL SUCCESS MODAL
            ========================================================= -->

                    <div class="eb-overlay" id="cancelSuccessOverlay">

                        <div class="cc-wrapper">

                            <div class="cc-label">IF YES</div>

                            <div class="cc-card">

                                <div class="cc-icon">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <h2 class="cc-title">Appointment Cancelled</h2>
                                <p class="cc-subtitle">
                                    Your appointment has been cancelled. You can book a new one anytime.
                                </p>

                                <button type="button" class="eb-btn-ok" id="cancelSuccessDoneBtn">Done</button>

                            </div>

                        </div>
                    </div> 
            </div>

            </div>
            <!-- =================================================
                 APPOINTMENT HISTORY
            ================================================== -->
            <div>

                <h3 class="section-table-title">
                    Appointment History
                </h3>

                <div class="custom-table-container">

                    <table class="custom-table">

                        <thead>
                            <tr>
                                <th style="width: 25%;">Email address</th>
                                <th style="width: 30%;">Date & Time</th>
                                <th style="width: 25%;">Office</th>
                                <th style="width: 20%;">Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                // History = date already passed, OR status is Rejected/Completed regardless of date
                                var historyList = Model
                                    .Where(a => a.AppointmentDate < DateTime.Today ||
                                                a.Status == "Rejected" || a.Status == "Completed")
                                    .OrderByDescending(a => a.AppointmentDate)
                                    .ToList();
                            }

                            @if (historyList.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No appointment history yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var appt in historyList)
                                {
                                    string statusClass = appt.Status switch
                                    {
                                        "Pending" => "status-pill-pending",
                                        "Approved" => "status-pill-approved",
                                        "Completed" => "status-pill-completed",
                                        "Rejected" => "status-pill-rejected",
                                        _ => "status-pill-pending"
                                    };
                                    <tr>
                                        <td>@appt.Email</td>
                                        <td>
                                            <div class="datetime-flex">
                                                <div class="datetime-item">
                                                    <i class="bi bi-calendar3"></i>
                                                    @appt.AppointmentDate.ToString("MMMM dd, yyyy (dddd)")
                                                </div>
                                                <div class="datetime-item">
                                                    <i class="bi bi-clock"></i>
                                                    @DateTime.Today.Add(appt.AppointmentTime).ToString("hh:mm tt")
                                                </div>
                                            </div>
                                        </td>
                                        <td>Work Avenue and Business Solutions Inc.</td>
                                        <td>
                                            <span class="@statusClass">@appt.Status</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- =========================================================
         EDIT BOOK INTERVIEW MODAL
    ========================================================= -->

            <div class="eb-overlay" id="editBookOverlay">

                <div class="eb-card">

                    <span class="eb-badge">
                        <i class="bi bi-pencil-square"></i>
                        EDIT BOOK INTERVIEW
                    </span>

                    <h2 class="eb-title">Schedule your interview</h2>
                    <p class="eb-subtitle">
                        Tell us how to reach you and when you're free — we'll confirm shortly after.
                    </p>

                    <div class="eb-error-text" id="editBookError">Something went wrong. Please try again.</div>

                    <div class="eb-group">
                        <label class="eb-label">Email Address</label>
                        <div class="eb-input-wrap">
                            <i class="bi bi-envelope"></i>
                            <input type="email" class="eb-input" id="editEmail" placeholder="name@gmail.com" required />
                        </div>
                    </div>

                    <div class="eb-group">
                        <label class="eb-label">Preferred Interview Date</label>
                        <div class="eb-input-wrap">
                            <i class="bi bi-calendar3"></i>
                            <input type="date" class="eb-input" id="editDate" required />
                        </div>
                    </div>

                    <div class="eb-group">
                        <label class="eb-label">Preferred Time</label>
                        <div class="eb-input-wrap">
                            <i class="bi bi-clock"></i>
                            <select class="eb-input" id="editTime" required>
                                <option value="" disabled selected>Select Time</option>
                                <option value="09:00 AM">09:00 AM</option>
                                <option value="10:00 AM">10:00 AM</option>
                                <option value="11:00 AM">11:00 AM</option>
                                <option value="01:00 PM">01:00 PM</option>
                                <option value="02:00 PM">02:00 PM</option>
                                <option value="03:00 PM">03:00 PM</option>
                                <option value="04:00 PM">04:00 PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="eb-actions">
                        <button type="button" class="eb-btn-cancel" id="editBookCancelBtn">Cancel</button>
                        <button type="button" class="eb-btn-save" id="editBookSaveBtn">Save</button>
                    </div>

                </div>

            </div>
            <!-- =========================================================
         SAVE SUCCESS MODAL
    ========================================================= -->

            <div class="eb-overlay" id="editSuccessOverlay">

                <div class="eb-success-card">

                    <div class="eb-success-label">Save Edit Book Interview</div>

                    <div class="eb-success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <h2 class="eb-success-title">Changes saved</h2>
                    <p class="eb-success-text">Your interview details were updated successfully.</p>

                    <button type="button" class="eb-btn-ok" id="editSuccessOkBtn">OK</button>

                </div>

            </div>

        </div>

    </div>

    <!-- =========================================================
         JAVASCRIPT
    ========================================================= -->

    <script>

            /* =====================================================
               SIDEBAR TOGGLE
            ===================================================== */

            document.getElementById('toggleSidebar').addEventListener('click', function () {
                document.body.classList.toggle('sidebar-collapsed');
            });



            /* =====================================================
               SETTINGS DROPDOWN
            ===================================================== */

            const settingsToggle = document.getElementById("settingsToggle");
            const settingsParent = document.querySelector(".settings-toggle");
            const settingsGroup = document.querySelector(".sidebar-settings");
            const settingsLink = document.getElementById("settingsLink");

            settingsToggle.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                settingsGroup.classList.toggle("open");
                settingsParent.classList.add("active");
            });

            settingsLink.addEventListener("click", function () {
                settingsParent.classList.add("active");
                settingsLink.classList.add("active");
            });



            /* =====================================================
               PROFILE DROPDOWN
            ===================================================== */

            const profileContainer = document.querySelector(".profile-container");
            const profileToggle = document.getElementById("profileToggle");

            profileToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                profileContainer.classList.toggle("open");
            });

            document.addEventListener("click", function (e) {
                if (!profileContainer.contains(e.target)) {
                    profileContainer.classList.remove("open");
                }
            });
            /* =====================================================
               NOTIFICATION DROPDOWN
            ===================================================== */

            const notificationContainer = document.querySelector(".notification-container");
            const notificationToggle = document.getElementById("notificationToggle");

            notificationToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                profileContainer.classList.remove("open");
                notificationContainer.classList.toggle("open");
            });

            document.addEventListener("click", function (e) {
                if (!notificationContainer.contains(e.target)) {
                    notificationContainer.classList.remove("open");
                }
            });
                /* =====================================================
               EDIT BOOK INTERVIEW MODAL
            ===================================================== */

            const editBookOverlay    = document.getElementById("editBookOverlay");
            const editSuccessOverlay = document.getElementById("editSuccessOverlay");

            const editEmailInput  = document.getElementById("editEmail");
            const editDateInput   = document.getElementById("editDate");
            const editTimeSelect  = document.getElementById("editTime");
            const editBookError   = document.getElementById("editBookError");
            const editBookSaveBtn = document.getElementById("editBookSaveBtn");

            let currentEditAppointmentId = null;

            function openEditBookModal(btn) {

                currentEditAppointmentId = btn.dataset.id;

                editEmailInput.value = btn.dataset.email || "";
                editDateInput.value  = btn.dataset.date || "";

                // Normalize the stored time (e.g. "02:00 PM") to match a <select> option value
                editTimeSelect.value = btn.dataset.time || "";

                editBookError.style.display = "none";
                editBookOverlay.classList.add("show");
            }

            function closeEditBookModal() {
                editBookOverlay.classList.remove("show");
                currentEditAppointmentId = null;
            }

            document.getElementById("editBookCancelBtn").addEventListener("click", closeEditBookModal);

            editBookOverlay.addEventListener("click", function (e) {
                if (e.target === editBookOverlay) {
                    closeEditBookModal();
                }
            });

            editBookSaveBtn.addEventListener("click", function () {

                if (!editEmailInput.value || !editDateInput.value || !editTimeSelect.value) {
                    editBookError.textContent = "Please fill out all fields.";
                    editBookError.style.display = "block";
                    return;
                }

                editBookSaveBtn.disabled = true;
                editBookSaveBtn.textContent = "Saving...";
                editBookError.style.display = "none";

                fetch('@Url.Action("EditAppointment", "Applicant")', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        AppointmentId: currentEditAppointmentId,
                        EmailAddress: editEmailInput.value,
                        PreferredDate: editDateInput.value,
                        PreferredTime: editTimeSelect.value
                    })
                })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error("Request failed");
                    }
                    return response.json();
                })
                .then(function (data) {

                    editBookSaveBtn.disabled = false;
                    editBookSaveBtn.textContent = "Save";

                    if (data && data.success) {
                        closeEditBookModal();
                        editSuccessOverlay.classList.add("show");
                    } else {
                        editBookError.textContent = (data && data.message) ? data.message : "Unable to save changes.";
                        editBookError.style.display = "block";
                    }
                })
                .catch(function () {
                    editBookSaveBtn.disabled = false;
                    editBookSaveBtn.textContent = "Save";
                    editBookError.textContent = "Something went wrong. Please try again.";
                    editBookError.style.display = "block";
                });

            });

            document.getElementById("editSuccessOkBtn").addEventListener("click", function () {
                editSuccessOverlay.classList.remove("show");
                window.location.reload(); // refresh the table so the updated row shows
            });
            /* =====================================================
               CANCEL APPOINTMENT MODAL
            ===================================================== */

            const cancelConfirmOverlay = document.getElementById("cancelConfirmOverlay");
            const cancelSuccessOverlay = document.getElementById("cancelSuccessOverlay");
            const cancelConfirmYesBtn  = document.getElementById("cancelConfirmYesBtn");
            const cancelConfirmNoBtn   = document.getElementById("cancelConfirmNoBtn");
            const cancelSuccessDoneBtn = document.getElementById("cancelSuccessDoneBtn");

            let currentCancelAppointmentId = null;

            function openCancelConfirmModal(appointmentId) {
                currentCancelAppointmentId = appointmentId;
                cancelConfirmOverlay.classList.add("show");
            }

            function closeCancelConfirmModal() {
                cancelConfirmOverlay.classList.remove("show");
                currentCancelAppointmentId = null;
            }

            cancelConfirmNoBtn.addEventListener("click", closeCancelConfirmModal);

            cancelConfirmOverlay.addEventListener("click", function (e) {
                if (e.target === cancelConfirmOverlay) {
                    closeCancelConfirmModal();
                }
            });

            cancelConfirmYesBtn.addEventListener("click", function () {
                if (currentCancelAppointmentId) {
                    document.getElementById("cancelForm-" + currentCancelAppointmentId).submit();
                }
            });

            cancelSuccessDoneBtn.addEventListener("click", function () {
                cancelSuccessOverlay.classList.remove("show");
                window.location.href = '@Url.Action("MyAppointment", "Applicant")';
            });

            @if (ViewBag.CancelSuccess == true)
            {
                    <text>
                        cancelSuccessOverlay.classList.add("show");
                    </text>
            }

    </script>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>