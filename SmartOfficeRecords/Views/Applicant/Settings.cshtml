﻿@{
ViewBag.Title = "Settings";
Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Settings - SORS</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- POPPINS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <style>

            /* =========================================================
                               GLOBAL
                            ========================================================== */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #f1f1f1;
                color: #263238;
                min-height: 100vh;
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

            :root {
                --red: #ed1c24;
                --red-dark: #c9151c;
                --red-light: #fff1f1;
                --sidebar: #222b30;
                --sidebar-hover: #2d373d;
                --white: #ffffff;
                --black-gray: #263238;
                --dark-gray: #455a64;
                --gray: #78909c;
                --light-gray: #eceff1;
                --border: #e1e5e8;
                --page-bg: #f1f1f1;
            }


            /* =========================================================
                               TOP NAVBAR
                               SAME AS BOOK INTERVIEW
                            ========================================================== */

            .navbar-custom {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 56px;
                background: var(--white);
                border-bottom: 1px solid #e0e0e0;
                display: flex;
                align-items: center;
                z-index: 1030;
                padding: 0;
            }


            /* =========================================================
                               LEFT LOGO BOX
                            ========================================================== */

            .navbar-left-box {
                width: 155px;
                height: 56px;
                background: var(--sidebar);
                display: flex;
                align-items: center;
                padding: 0 15px;
                border-right: 1px solid #39434a;
                transition: all .3s ease;
            }

            .navbar-brand-custom {
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
            }

                .navbar-brand-custom img {
                    width: 34px;
                    height: 34px;
                    object-fit: contain;
                    border-radius: 50%;
                }

            .brand-text {
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: .4px;
            }


            /* =========================================================
                               HAMBURGER
                            ========================================================== */

            .toggle-zone-box {
                height: 56px;
                width: 55px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #ffffff;
            }

            .sidebar-toggle-btn {
                border: none;
                background: transparent;
                color: var(--red);
                font-size: 18px;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: .2s ease;
            }

                .sidebar-toggle-btn:hover {
                    color: var(--red-dark);
                }


            /* =========================================================
                               NAVBAR RIGHT
                            ========================================================== */

            .navbar-profile {
                margin-left: auto;
                height: 56px;
                display: flex;
                align-items: center;
                gap: 15px;
                padding-right: 15px;
            }


            /* =========================================================
                               NOTIFICATION
                            ========================================================== */

            .notification-container {
                position: relative;
            }

            .notification-btn {
                width: 40px;
                height: 40px;
                border: none;
                background: transparent;
                color: var(--dark-gray);
                font-size: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: .2s ease;
            }

                .notification-btn:hover {
                    color: var(--red);
                }

            .notification-badge-count {
                position: absolute;
                top: 2px;
                right: 2px;
                min-width: 16px;
                height: 16px;
                padding: 0 4px;
                background: var(--red);
                border-radius: 999px;
                border: 1.5px solid white;
                color: white;
                font-size: 9px;
                font-weight: 700;
                line-height: 1;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            /* =========================================================
                               NOTIFICATION DROPDOWN
                               SAME AS BOOK INTERVIEW
                            ========================================================== */

            .notification-dropdown-custom {
                position: absolute;
                right: 0;
                top: 48px;
                width: 330px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
                overflow: hidden;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all .25s ease;
                z-index: 1050;
            }

            .notification-container.open .notification-dropdown-custom {
                max-height: 450px;
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .notif-header {
                padding: 14px 16px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #eeeeee;
            }

            .notif-header-title {
                color: var(--black-gray);
                font-size: 13px;
                font-weight: 700;
            }

            .notif-mark-read {
                color: var(--red);
                font-size: 10px;
                font-weight: 600;
            }

                .notif-mark-read:hover {
                    color: var(--red-dark);
                }

            .notif-body {
                max-height: 300px;
                overflow-y: auto;
            }

            .notif-item {
                display: flex;
                gap: 10px;
                padding: 12px 15px;
                border-bottom: 1px solid #f1f1f1;
                color: inherit;
                transition: .2s ease;
            }

                .notif-item:hover {
                    background: var(--red-light);
                }

            .notif-icon-box {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .notif-icon-success {
                background: #e8f5e9;
                color: #43a047;
            }

            .notif-icon-warning {
                background: #fff3e0;
                color: #fb8c00;
            }
            .notif-icon-danger {
                background: #ffebee;
                color: #e53935;
            }

            .notif-icon-info {
                background: #e3f2fd;
                color: #1e88e5;
            }

            .notif-text {
                color: var(--dark-gray);
                font-size: 11px;
                line-height: 1.4;
            }

            .notif-time {
                color: #9e9e9e;
                font-size: 9px;
                margin-top: 3px;
            }

            .notif-footer {
                padding: 10px;
                text-align: center;
                background: #fafafa;
                border-top: 1px solid #eeeeee;
            }

            .notif-footer-btn {
                color: var(--red);
                font-size: 11px;
                font-weight: 600;
            }


            /* =========================================================
                               PROFILE
                               SAME AS BOOK INTERVIEW
                            ========================================================== */

            .profile-container {
                position: relative;
            }

            .profile-widget {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 4px 8px;
                border-radius: 20px;
                background: #f5f5f5;
                border: 1px solid #e3e3e3;
                cursor: pointer;
                transition: .2s ease;
            }

                .profile-widget:hover {
                    background: #eeeeee;
                }

            .profile-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: #ffb52e;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
            }

            .profile-info {
                line-height: 1.1;
            }

            .profile-name {
                display: block;
                color: var(--black-gray);
                font-size: 10px;
                font-weight: 700;
            }

            .profile-email {
                display: block;
                color: #78909c;
                font-size: 8px;
            }

            .profile-arrow {
                color: #546e7a;
                font-size: 11px;
                transition: .3s;
            }


            /* =========================================================
                               PROFILE DROPDOWN
                            ========================================================== */

            .profile-dropdown-custom {
                position: absolute;
                right: 0;
                top: 48px;
                width: 200px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
                overflow: hidden;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all .25s ease;
                z-index: 1050;
            }

            .profile-container.open .profile-dropdown-custom {
                max-height: 200px;
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .profile-container.open .profile-arrow {
                transform: rotate(180deg);
            }

            .profile-dropdown-custom a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 15px;
                color: var(--dark-gray);
                font-size: 12px;
                font-weight: 500;
                transition: .2s ease;
            }

                .profile-dropdown-custom a:hover {
                    background: var(--red-light);
                    color: var(--red);
                }

                .profile-dropdown-custom a i {
                    font-size: 16px;
                }


            /* =========================================================
                               SIDEBAR
                               EXACT STYLE FROM BOOK INTERVIEW
                            ========================================================== */

            .sidebar-menu-wrapper {
                position: fixed;
                top: 56px;
                left: 0;
                bottom: 0;
                width: 155px;
                background: var(--sidebar);
                border-right: 1px solid #39434a;
                padding: 15px 8px;
                overflow-y: auto;
                overflow-x: hidden;
                z-index: 1020;
                transition: all .3s ease;
            }

                .sidebar-menu-wrapper::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-menu-wrapper::-webkit-scrollbar-track {
                    background: var(--sidebar);
                }

                .sidebar-menu-wrapper::-webkit-scrollbar-thumb {
                    background: #45545d;
                    border-radius: 10px;
                }

            .sidebar-links {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .sidebar-link-item {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 10px;
                border-radius: 5px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 500;
                white-space: nowrap;
                transition: all .2s ease;
            }

                .sidebar-link-item i {
                    width: 17px;
                    min-width: 17px;
                    font-size: 14px;
                    display: inline-flex;
                    justify-content: center;
                }

                .sidebar-link-item:hover {
                    color: var(--red);
                    background: rgba(237, 28, 36, .08);
                }

                    .sidebar-link-item:hover i {
                        color: var(--red);
                    }

                .sidebar-link-item.active {
                    color: var(--red);
                    background: transparent;
                    font-weight: 600;
                }

                    .sidebar-link-item.active i {
                        color: var(--red);
                    }


            /* =========================================================
                               SETTINGS SIDEBAR
                            ========================================================== */

            .sidebar-settings {
                list-style: none;
            }

            .settings-toggle {
                justify-content: space-between;
                cursor: pointer;
            }

                .settings-toggle > a {
                    color: #ffffff !important;
                }

                    .settings-toggle > a:hover {
                        color: var(--red) !important;
                    }

                .settings-toggle.active {
                    color: var(--red);
                    background: rgba(237,28,36,.08);
                }

                    .settings-toggle.active > a {
                        color: var(--red) !important;
                    }

            .settings-arrow {
                color: #ffffff;
                font-size: 11px;
                transition: .3s;
            }

            .settings-toggle:hover .settings-arrow {
                color: var(--red);
            }

            .settings-submenu {
                list-style: none;
                padding: 0 0 0 12px;
                margin: 2px 0 0 0;
                max-height: 0;
                overflow: hidden;
                transition: max-height .3s ease;
            }

                .settings-submenu li {
                    margin: 2px 0;
                }

                .settings-submenu a {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 8px 9px;
                    border-radius: 5px;
                    color: #ffffff !important;
                    font-size: 11px;
                    font-weight: 500;
                    transition: .2s ease;
                }

                    .settings-submenu a:hover {
                        background: rgba(237,28,36,.10);
                        color: var(--red) !important;
                    }

                    .settings-submenu a i {
                        color: #ffffff;
                        font-size: 12px;
                    }

                    .settings-submenu a:hover i {
                        color: var(--red);
                    }

                    .settings-submenu a.active {
                        color: var(--red) !important;
                        background: rgba(237,28,36,.10);
                    }

                        .settings-submenu a.active i {
                            color: var(--red);
                        }

            .sidebar-settings.open .settings-submenu {
                max-height: 150px;
            }

            .sidebar-settings.open .settings-arrow {
                transform: rotate(90deg);
            }


            /* =========================================================
                               LOGOUT
                            ========================================================== */

            .logout-wrapper {
                position: absolute;
                bottom: 15px;
                left: 8px;
                right: 8px;
            }

            .logout-link {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 10px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 500;
                border-radius: 5px;
                transition: .2s ease;
            }

                .logout-link:hover {
                    color: var(--red);
                    background: rgba(237,28,36,.08);
                }

                .logout-link i {
                    font-size: 16px;
                }


            /* =========================================================
                               MAIN PAGE CONTAINER
                               EXACT SAME SPACE AS BOOK INTERVIEW
                            ========================================================== */

            .page-container {
                margin-left: 155px;
                padding: 78px 18px 35px 18px;
                min-height: 100vh;
                transition: margin-left .3s ease;
            }


            /* =========================================================
                               SETTINGS CONTENT
                            ========================================================== */

            .heading-section {
                margin-bottom: 18px;
            }

            .page-title {
                color: var(--black-gray);
                font-size: 21px;
                font-weight: 700;
                margin-bottom: 2px;
            }

            .page-subtitle {
                color: #607d8b;
                font-size: 10px;
                font-weight: 500;
                margin: 0;
            }


            /* =========================================================
                               SETTINGS GRID
                            ========================================================== */

            .settings-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                align-items: start;
            }

            .settings-card {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 9px;
                padding: 16px 17px 20px;
                box-shadow: 0 3px 15px rgba(0,0,0,.05);
            }

            .card-title {
                display: flex;
                align-items: center;
                gap: 9px;
                color: var(--black-gray);
                font-size: 13px;
                font-weight: 700;
                margin-bottom: 18px;
            }

                .card-title i {
                    color: #455a64;
                    font-size: 14px;
                }


            /* =========================================================
                               FORM ROW
                            ========================================================== */

            .field-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
                margin-bottom: 14px;
            }

            .setting-field label {
                display: block;
                color: #37474f;
                font-size: 10px;
                font-weight: 600;
                margin-bottom: 6px;
            }

            .setting-field select {
                width: 100%;
                height: 38px;
                border: 1px solid #d8dde0;
                border-radius: 7px;
                background: #ffffff;
                color: #455a64;
                font-size: 10px;
                padding: 0 12px;
                outline: none;
                box-shadow: 0 2px 6px rgba(0,0,0,.10);
                cursor: pointer;
                transition: all .2s ease;
            }

                .setting-field select:focus {
                    border-color: var(--red);
                    box-shadow: 0 0 0 3px rgba(237,28,36,.08);
                }


            /* =========================================================
                               ACCENT COLORS
                            ========================================================== */

            .accent-label {
                display: block;
                color: #37474f;
                font-size: 10px;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .accent-colors {
                display: flex;
                align-items: center;
                gap: 9px;
            }

            .accent-option {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                border: 1px solid #9ca3af;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: .2s;
            }

                .accent-option:hover {
                    transform: scale(1.08);
                }

                .accent-option.red {
                    background: #ed1c24;
                    border-color: #ed1c24;
                }

                .accent-option.black {
                    background: #20272d;
                    border-color: #20272d;
                }

                .accent-option.blue {
                    background: #9aa9bd;
                    border-color: #9aa9bd;
                }

                .accent-option.white {
                    background: #ffffff;
                }

                .accent-option.active::after {
                    content: "✓";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 700;
                }

                .accent-option.white.active::after {
                    color: #333333;
                }


            /* =========================================================
                               NOTIFICATION SETTINGS
                            ========================================================== */

            .notification-setting {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 14px;
            }

            .notification-left {
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .notification-left i {
                    color: #78909c;
                    font-size: 13px;
                }

                .notification-left span {
                    color: #455a64;
                    font-size: 10px;
                    font-weight: 500;
                }


            /* =========================================================
                               CUSTOM SWITCH
                            ========================================================== */

            .custom-switch {
                position: relative;
                width: 36px;
                height: 20px;
                display: inline-block;
            }

                .custom-switch input {
                    opacity: 0;
                    width: 0;
                    height: 0;
                }

            .switch-slider {
                position: absolute;
                inset: 0;
                background: #d9dee2;
                border-radius: 20px;
                cursor: pointer;
                transition: .3s;
            }

                .switch-slider::before {
                    content: "";
                    position: absolute;
                    width: 16px;
                    height: 16px;
                    left: 2px;
                    top: 2px;
                    background: #ffffff;
                    border-radius: 50%;
                    transition: .3s;
                    box-shadow: 0 1px 2px rgba(0,0,0,.15);
                }

            .custom-switch input:checked + .switch-slider {
                background: var(--red);
            }

                .custom-switch input:checked + .switch-slider::before {
                    transform: translateX(16px);
                }


            /* =========================================================
                               REMINDER
                            ========================================================== */

            .reminder-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-top: 5px;
                padding-left: 22px;
            }

            .reminder-label {
                color: #455a64;
                font-size: 10px;
                font-weight: 500;
            }

            .reminder-select {
                height: 30px;
                min-width: 105px;
                border: 1px solid #d8dde0;
                border-radius: 6px;
                padding: 3px 8px;
                font-size: 9px;
                color: #455a64;
                background: #ffffff;
                outline: none;
            }

                .reminder-select:focus {
                    border-color: var(--red);
                }


            /* =========================================================
                               SAVE BUTTON
                            ========================================================== */

            .save-container {
                margin-top: 18px;
            }

            .btn-save {
                min-width: 150px;
                height: 38px;
                border: none;
                border-radius: 7px;
                background: var(--red);
                color: #ffffff;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(237,28,36,.18);
                transition: all .2s ease;
            }

                .btn-save:hover {
                    background: var(--red-dark);
                    transform: translateY(-1px);
                    box-shadow: 0 5px 13px rgba(237,28,36,.22);
                }


            /* =========================================================
                               COLLAPSED SIDEBAR
                            ========================================================== */

            body.sidebar-collapsed .navbar-left-box {
                width: 60px;
                padding: 0;
                justify-content: center;
            }

            body.sidebar-collapsed .brand-text {
                display: none;
            }

            body.sidebar-collapsed .sidebar-menu-wrapper {
                width: 60px;
                padding-left: 6px;
                padding-right: 6px;
            }

            body.sidebar-collapsed .sidebar-link-item {
                justify-content: center;
                padding-left: 0;
                padding-right: 0;
                gap: 0;
            }

            body.sidebar-collapsed .sidebar-link-text {
                display: none;
            }

            body.sidebar-collapsed .settings-arrow {
                display: none;
            }

            body.sidebar-collapsed .settings-submenu {
                display: none !important;
            }

            body.sidebar-collapsed .logout-link {
                justify-content: center;
                padding-left: 0;
                padding-right: 0;
            }

            body.sidebar-collapsed .logout-text {
                display: none;
            }

            body.sidebar-collapsed .page-container {
                margin-left: 60px;
            }


            /* =========================================================
                               RESPONSIVE
                            ========================================================== */

            @@media (max-width: 1000px) {

                .navbar-left-box {
                    width: 210px;
                }

                .sidebar-menu-wrapper {
                    width: 210px;
                }

                .page-container {
                    margin-left: 210px;
                }

                body.sidebar-collapsed .page-container {
                    margin-left: 60px;
                }

                .settings-grid {
                    grid-template-columns: 1fr;
                }
            }


            @@media (max-width: 700px) {

                .navbar-left-box {
                    width: 60px;
                    padding: 0;
                    justify-content: center;
                }

                .brand-text {
                    display: none;
                }

                .sidebar-menu-wrapper {
                    width: 60px;
                }

                .sidebar-link-item {
                    justify-content: center;
                    padding: 11px 0;
                    gap: 0;
                }

                .sidebar-link-text {
                    display: none;
                }

                .settings-arrow {
                    display: none;
                }

                .settings-submenu {
                    display: none !important;
                }

                .page-container {
                    margin-left: 60px;
                    padding: 75px 12px 25px;
                }

                .profile-info {
                    display: none;
                }

                .profile-widget {
                    padding: 4px;
                }

                .settings-grid {
                    grid-template-columns: 1fr;
                }

                .field-row {
                    grid-template-columns: 1fr;
                }

                .notification-dropdown-custom {
                    width: 280px;
                }
            }


            @@media (max-width: 500px) {

                .navbar-profile {
                    gap: 5px;
                    padding-right: 7px;
                }

                .notification-dropdown-custom {
                    width: 280px;
                    right: -60px;
                }

                .profile-dropdown-custom {
                    right: -5px;
                }

                .page-title {
                    font-size: 18px;
                }

                .page-subtitle {
                    font-size: 9px;
                }

                .settings-card {
                    padding: 14px;
                }

                .reminder-row {
                    padding-left: 0;
                    gap: 10px;
                }

                .btn-save {
                    width: 100%;
                }
            }
    </style>

</head>


<body>


    <!-- =========================================================
         TOP NAVBAR
    ========================================================== -->

    <nav class="navbar-custom">


        <!-- LOGO -->

        <div class="navbar-left-box">

            <a class="navbar-brand-custom"
               href="@Url.Action("ApplicantDash", "Applicant")">

                <img src="~/Images/logo.png"
                     alt="SORS Logo"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />

                <span class="brand-text">
                    SORS
                </span>

            </a>

        </div>


        <!-- HAMBURGER -->

        <div class="toggle-zone-box">

            <button class="sidebar-toggle-btn"
                    id="toggleSidebar"
                    type="button"
                    title="Toggle Sidebar">

                <i class="bi bi-list"></i>

            </button>

        </div>


        <!-- RIGHT NAVIGATION -->

        <div class="navbar-profile">


            <!-- NOTIFICATION -->

            <div class="notification-container">

                <button class="notification-btn"
                        id="notificationToggle"
                        type="button"
                        title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notification-badge-dot"></span>

                </button>


                <!-- NOTIFICATION DROPDOWN -->

                <div class="notification-dropdown-custom"
                     id="notificationMenu">


                    <div class="notif-header">

                        <span class="notif-header-title">
                            Notifications
                        </span>

                        <a href="#"
                           class="notif-mark-read">
                            Mark all as read
                        </a>

                    </div>


                    <div class="notif-body">


                        <a href="#"
                           class="notif-item">

                            <div class="notif-icon-box notif-icon-success">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>

                            <div>

                                <div class="notif-text">

                                    Your interview request
                                    <strong>#RI01</strong>
                                    was approved.

                                </div>

                                <div class="notif-time">
                                    10 mins ago
                                </div>

                            </div>

                        </a>


                        <a href="#"
                           class="notif-item">

                            <div class="notif-icon-box notif-icon-warning">

                                <i class="bi bi-clock-history"></i>

                            </div>

                            <div>
                                <div class="notif-text">
                                    Reminder: Check your interview schedule.
                                </div>

                                <div class="notif-time">
                                    2 hours ago
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="notif-footer">

                        <a href="#"
                           class="notif-footer-btn">

                            View All Notifications

                        </a>

                    </div>

                </div>

            </div>


            <!-- PROFILE -->

            <div class="profile-widget" id="profileToggle">

                <div class="profile-avatar">
                    @ViewBag.Initials
                </div>

                <div class="profile-info">

                    <span class="profile-name">
                        @ViewBag.FullName
                    </span>

                    <span class="profile-email">
                        @ViewBag.Email
                    </span>

                </div>

                <i class="bi bi-chevron-down profile-arrow"></i>

            </div>


                <!-- PROFILE DROPDOWN -->

                <div class="profile-dropdown-custom"
                     id="profileMenu">


                    <a href="@Url.Action("Profile", "Applicant")">

                        <i class="bi bi-person-circle"></i>

                        My Account

                    </a>


                    <a href="@Url.Action("ApplicantLogout", "Applicant")">

                        <i class="bi bi-box-arrow-right"></i>

                        Logout

                    </a>
               </div>
            </div>
    </nav>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar-menu-wrapper"
           id="sidebarMenu">


        <ul class="sidebar-links">


            <!-- DASHBOARD -->

            <li>

                <a href="@Url.Action("ApplicantDash", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-house-door-fill"></i>

                    <span class="sidebar-link-text">
                        Dashboard
                    </span>

                </a>

            </li>


            <!-- BOOK INTERVIEW -->

            <li>

                <a href="@Url.Action("BookInterview", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                    <span class="sidebar-link-text">
                        Book Interview
                    </span>

                </a>

            </li>


            <!-- MY APPOINTMENT -->

            <li>

                <a href="@Url.Action("MyAppointment", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-person-bounding-box"></i>

                    <span class="sidebar-link-text">
                        My Appointment
                    </span>

                </a>

            </li>


            <!-- SETTINGS -->

            <li class="sidebar-settings open">


                <div class="sidebar-link-item settings-toggle active"
                     id="settingsToggle">


                    <a href="@Url.Action("Settings", "Applicant")"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none">

                        <i class="bi bi-gear-fill"></i>

                        <span class="sidebar-link-text ms-2">
                            Settings
                        </span>

                    </a>


                    <i class="bi bi-chevron-right settings-arrow"></i>

                </div>

                <!-- SETTINGS SUBMENU -->

                <ul class="settings-submenu"
                    id="settingsMenu">

                    <li>

                        <a href="@Url.Action("Settings", "Applicant")"
                           class="active">

                            <i class="bi bi-shield-lock"></i>

                            <span class="sidebar-link-text">
                                General Settings
                            </span>

                        </a>

                    </li>

                    <li>
                        <a href="@Url.Action("Profile", "Applicant")">
                            <i class="bi bi-person-circle"></i>
                            <span class="sidebar-link-text">
                                My Account
                            </span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>


        <!-- LOGOUT -->

        <div class="logout-wrapper">

            <a href="@Url.Action("ApplicantLogout", "Applicant")"
               class="logout-link">
                <i class="bi bi-box-arrow-right"></i>

                <span class="logout-text">
                    Logout
                </span>

            </a>

        </div>

    </aside>


    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->

    <main class="page-container">


        <!-- PAGE HEADING -->

        <div class="heading-section">

            <h1 class="page-title">
                General Settings
            </h1>

            <p class="page-subtitle">
                Manage your system preferences and customize your experience.
            </p>

        </div>


        <!-- =====================================================
             SETTINGS GRID
        ====================================================== -->

        <div class="settings-grid">


            <!-- =================================================
                 APPEARANCE
            ================================================== -->

            <div class="settings-card">


                <div class="card-title">

                    <i class="bi bi-palette-fill"></i>

                    Appearance

                </div>


                <div class="field-row">


                    <!-- THEME -->

                    <div class="setting-field">

                        <label>
                            Theme
                        </label>

                        <select>

                            <option selected>
                                Light
                            </option>

                            <option>
                                Dark
                            </option>

                            <option>
                                System Default
                            </option>

                        </select>

                    </div>


                    <!-- FONT STYLE -->

                    <div class="setting-field">

                        <label>
                            Font Style
                        </label>

                        <select>

                            <option selected>
                                Poppins
                            </option>

                            <option>
                                Arial
                            </option>

                            <option>
                                Roboto
                            </option>

                        </select>

                    </div>

                </div>


                <div class="field-row">


                    <!-- FONT SIZE -->

                    <div class="setting-field">

                        <label>
                            Font Size
                        </label>

                        <select>

                            <option>
                                Small
                            </option>

                            <option selected>
                                Medium
                            </option>

                            <option>
                                Large
                            </option>

                        </select>

                    </div>


                    <!-- SIDEBAR STYLE -->

                    <div class="setting-field">

                        <label>
                            Sidebar Style
                        </label>

                        <select>

                            <option selected>
                                Dark
                            </option>

                            <option>
                                Light
                            </option>

                            <option>
                                Compact
                            </option>

                        </select>

                    </div>

                </div>


                <!-- ACCENT COLOR -->

                <div>

                    <span class="accent-label">
                        Accent Color
                    </span>


                    <div class="accent-colors">

                        <div class="accent-option red active"></div>

                        <div class="accent-option black"></div>

                        <div class="accent-option blue"></div>

                        <div class="accent-option white"></div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 LANGUAGE & REGION
            ================================================== -->

            <div class="settings-card">


                <div class="card-title">

                    <i class="bi bi-globe2"></i>

                    Language & Region

                </div>


                <div class="field-row">


                    <!-- LANGUAGE -->

                    <div class="setting-field">

                        <label>
                            Language
                        </label>

                        <select>

                            <option selected>
                                English
                            </option>

                            <option>
                                Filipino
                            </option>

                        </select>

                    </div>


                    <!-- TIMEZONE -->

                    <div class="setting-field">

                        <label>
                            Time Zone
                        </label>

                        <select>

                            <option selected>
                                Asia/Manila (GMT+8)
                            </option>

                            <option>
                                Asia/Tokyo (GMT+9)
                            </option>

                        </select>

                    </div>

                </div>


                <div class="field-row">


                    <!-- TIME FORMAT -->

                    <div class="setting-field">

                        <label>
                            Time Format
                        </label>

                        <select>

                            <option selected>
                                12-Hour
                            </option>

                            <option>
                                24-Hour
                            </option>

                        </select>

                    </div>


                    <!-- DATE FORMAT -->

                    <div class="setting-field">

                        <label>
                            Date Format
                        </label>

                        <select>

                            <option selected>
                                MM/DD/YYYY
                            </option>

                            <option>
                                DD/MM/YYYY
                            </option>

                            <option>
                                YYYY-MM-DD
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 NOTIFICATIONS
            ================================================== -->

            <div class="settings-card">


                <div class="card-title">

                    <i class="bi bi-bell"></i>

                    Notifications

                </div>


                <!-- EMAIL -->

                <div class="notification-setting">

                    <div class="notification-left">

                        <i class="bi bi-envelope"></i>

                        <span>
                            Email Notifications
                        </span>

                    </div>


                    <label class="custom-switch">

                        <input type="checkbox" checked />

                        <span class="switch-slider"></span>

                    </label>

                </div>


                <!-- SMS -->

                <div class="notification-setting">

                    <div class="notification-left">

                        <i class="bi bi-chat-left-text"></i>

                        <span>
                            SMS Notifications
                        </span>

                    </div>


                    <label class="custom-switch">

                        <input type="checkbox" />

                        <span class="switch-slider"></span>

                    </label>

                </div>


                <!-- INTERVIEW REMINDER -->

                <div class="reminder-row">

                    <span class="reminder-label">
                        Interview Reminders
                    </span>


                    <select class="reminder-select">

                        <option selected>
                            1 hour before
                        </option>

                        <option>
                            2 hours before
                        </option>

                        <option>
                            1 day before
                        </option>

                    </select>

                </div>

            </div>


            <!-- =================================================
                 NOTIFICATION THEME
            ================================================== -->

            <div class="settings-card">


                <div class="card-title">

                    <i class="bi bi-display"></i>

                    Notification Theme

                </div>


                <div class="setting-field"
                     style="max-width:220px;">

                    <label>
                        Theme
                    </label>


                    <select>

                        <option selected>
                            Light
                        </option>

                        <option>
                            Dark
                        </option>

                        <option>
                            System Default
                        </option>

                    </select>

                </div>

            </div>


        </div>


        <!-- SAVE -->

        <div class="save-container">

            <button class="btn-save"
                    type="button">

                Save Changes

            </button>

        </div>


    </main>


    <!-- BOOTSTRAP -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <script>


            /* =========================================================
               SIDEBAR TOGGLE
            ========================================================== */

            document.getElementById("toggleSidebar")
                .addEventListener("click", function () {

                    document.body.classList.toggle("sidebar-collapsed");

                });


            /* =========================================================
               SETTINGS DROPDOWN
            ========================================================== */

            const settingsToggle =
                document.getElementById("settingsToggle");

            const settingsGroup =
                document.querySelector(".sidebar-settings");

            settingsToggle.addEventListener("click", function (e) {

                /*
                 * Allow the Settings text/link
                 * to navigate normally.
                 *
                 * Clicking the arrow area toggles
                 * the submenu.
                 */

                if (e.target.closest("a")) {
                    return;
                }

                e.preventDefault();
                e.stopPropagation();

                settingsGroup.classList.toggle("open");

            });


            /* =========================================================
               PROFILE DROPDOWN
            ========================================================== */

            const profileContainer =
                document.querySelector(".profile-container");

            const profileToggle =
                document.getElementById("profileToggle");


            profileToggle.addEventListener("click", function (e) {

                e.stopPropagation();

                profileContainer.classList.toggle("open");

                notificationContainer.classList.remove("open");

            });


            /* =========================================================
               NOTIFICATION DROPDOWN
            ========================================================== */

            const notificationContainer =
                document.querySelector(".notification-container");

            const notificationToggle =
                document.getElementById("notificationToggle");


            notificationToggle.addEventListener("click", function (e) {

                e.stopPropagation();

                notificationContainer.classList.toggle("open");

                profileContainer.classList.remove("open");

            });


            /* =========================================================
               CLOSE DROPDOWNS
            ========================================================== */

            document.addEventListener("click", function () {

                profileContainer.classList.remove("open");

                notificationContainer.classList.remove("open");

            });


            /* =========================================================
               ACCENT COLOR
            ========================================================== */

            const accentOptions =
                document.querySelectorAll(".accent-option");


            accentOptions.forEach(function (option) {

                option.addEventListener("click", function () {

                    accentOptions.forEach(function (item) {

                        item.classList.remove("active");

                    });

                    option.classList.add("active");

                });

            });

    </script>


</body>
</html>