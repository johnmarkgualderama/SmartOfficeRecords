@{
    ViewBag.Title = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reset Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="d-flex align-items-center justify-content-center" style="height:100vh; background:#f4f6f9;">

    <div class="card p-4" style="width:400px;">
        <h4 class="text-center mb-3">Set New Password</h4>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("ResetPassword", "Applicant", FormMethod.Post))
        {
            <div class="mb-3">
                <label>New Password</label>
                <input type="password" name="NewPassword" class="form-control" required />
            </div>
            <div class="mb-3">
                <label>Confirm Password</label>
                <input type="password" name="ConfirmPassword" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Reset Password</button>
        }
    </div>

</body>
</html>