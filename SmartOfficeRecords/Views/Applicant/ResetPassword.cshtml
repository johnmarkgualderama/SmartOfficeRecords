@{
    ViewBag.Title = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Reset Password</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Poppins Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

            /* ==============================
                               GLOBAL
                            ============================== */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                min-height: 100vh;
                background: #d9d9d9;
                overflow: hidden;
            }

            .main-container {
                width: 100%;
                height: 100vh;
                display: flex;
            }

            .reset-wrapper {
                width: 100%;
                height: 100vh;
                display: flex;
                background: #ffffff;
                overflow: hidden;
            }


            /* ==============================
                               LEFT SIDE
                            ============================== */

            .left-side {
                width: 41%;
                height: 100vh;
                background: linear-gradient( 180deg, #202a2f 0%, #171d20 45%, #0f1112 100% );
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-start;
                position: relative;
                overflow: hidden;
            }


                /* Subtle background effect */

                .left-side::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: radial-gradient( circle at 50% 20%, rgba(255,255,255,0.04), transparent 35% );
                    pointer-events: none;
                }


            /* ==============================
                               LOGO + SYSTEM NAME
                            ============================== */

            .top-content {
                width: 100%;
                text-align: center;
                padding-top: 105px;
                position: relative;
                z-index: 2;
            }

                .top-content img {
                    width: 135px;
                    height: 135px;
                    object-fit: contain;
                    background: #ffffff;
                    padding: 10px;
                    border-radius: 50%;
                    margin-bottom: 32px;
                    box-shadow: 0 8px 25px rgba(0,0,0,0.20);
                }

                .top-content h1 {
                    color: #ffffff;
                    font-size: 31px;
                    font-weight: 800;
                    line-height: 1.45;
                    letter-spacing: 0.3px;
                    text-align: center;
                    margin: 0 auto;
                    max-width: 400px;
                }


            /* ==============================
                               RIGHT SIDE
                            ============================== */

            .right-side {
                width: 59%;
                height: 100vh;
                background: #ffffff;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 40px;
            }


            /* ==============================
                               RESET CARD
                            ============================== */

            .reset-card {
                width: 100%;
                max-width: 495px;
                min-height: 590px;
                background: #ffffff;
                border: 1px solid #dce2e6;
                border-radius: 7px;
                padding: 43px 63px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.02);
                text-align: center;
                opacity: 0;
                animation: slideInCard 0.7s cubic-bezier(0.16,1,0.3,1) forwards;
            }


            /* ==============================
                               ICON
                            ============================== */

            .reset-icon {
                display: flex;
                justify-content: center;
                margin-bottom: 18px;
            }

            .icon-circle {
                width: 78px;
                height: 78px;
                border-radius: 50%;
                background: #fff0f0;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .icon-circle i {
                    font-size: 38px;
                    color: #ed1c24;
                }


            /* ==============================
                               TITLE
                            ============================== */

            .reset-card h2 {
                color: #252d32;
                font-size: 24px;
                font-weight: 800;
                margin-bottom: 10px;
            }

            .subtitle {
                color: #66757e;
                font-size: 14px;
                font-weight: 500;
                margin-bottom: 38px;
            }


            /* ==============================
                               FORM
                            ============================== */

            .form-section {
                width: 100%;
                text-align: left;
            }

            .form-label {
                display: block;
                color: #111111;
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 8px;
            }


            /* ==============================
                               INPUT
                            ============================== */

            .input-group-custom {
                position: relative;
                width: 100%;
                margin-bottom: 23px;
            }

            .form-control-custom {
                width: 100%;
                height: 49px;
                border: 1px solid #e1e1e1;
                border-radius: 7px;
                background: #ffffff;
                color: #333333;
                font-size: 14px;
                padding-left: 42px;
                padding-right: 45px;
                outline: none;
                box-shadow: 0 1px 5px rgba(237, 28, 36, 0.10);
                transition: all 0.2s ease;
            }

                .form-control-custom::placeholder {
                    color: #b8b8bd;
                    font-weight: 400;
                }

                .form-control-custom:focus {
                    border-color: #ed1c24;
                    background: #ffffff;
                    box-shadow: 0 0 0 3px rgba(237, 28, 36, 0.10);
                }


            /* LEFT INPUT ICON */

            .left-icon {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #b9bfc2;
                font-size: 17px;
                z-index: 2;
                pointer-events: none;
                transition: 0.2s ease;
            }

            .input-group-custom:focus-within .left-icon {
                color: #ed1c24;
            }


            /* RIGHT EYE ICON */

            .right-icon {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #aeb5b8;
                font-size: 17px;
                cursor: pointer;
                z-index: 3;
                transition: 0.2s ease;
            }

                .right-icon:hover {
                    color: #ed1c24;
                }


            /* ==============================
                               RESET BUTTON
                            ============================== */

            .btn-reset {
                width: 100%;
                height: 53px;
                border: none;
                border-radius: 7px;
                background: #ed1c24;
                color: #ffffff;
                font-size: 17px;
                font-weight: 700;
                letter-spacing: 0.1px;
                cursor: pointer;
                margin-top: 10px;
                box-shadow: 0 7px 16px rgba(237, 28, 36, 0.18);
                transition: all 0.2s ease;
            }

                .btn-reset:hover {
                    background: #d9161d;
                    transform: translateY(-2px);
                    box-shadow: 0 10px 22px rgba(237, 28, 36, 0.28);
                }

                .btn-reset:active {
                    transform: translateY(1px);
                    box-shadow: 0 4px 10px rgba(237, 28, 36, 0.20);
                }


            /* ==============================
                               ERROR MESSAGE
                            ============================== */

            .error-message {
                width: 100%;
                background: #fff1f1;
                border: 1px solid #ffd3d3;
                color: #dc2626;
                padding: 10px 12px;
                border-radius: 7px;
                font-size: 12px;
                font-weight: 500;
                margin-bottom: 18px;
                text-align: center;
            }


            /* ==============================
                               ANIMATION
                            ============================== */

            @@keyframes slideInCard {

                from {
                    opacity: 0;
                    transform: translateY(25px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }


            /* ==============================
                               RESPONSIVE
                            ============================== */

            @@media (max-width: 991px) {

                body {
                    overflow-y: auto;
                }

                .reset-wrapper {
                    height: auto;
                    min-height: 100vh;
                    flex-direction: column;
                }

                .left-side {
                    width: 100%;
                    height: auto;
                    min-height: 430px;
                }

                .top-content {
                    padding-top: 60px;
                    padding-bottom: 50px;
                }

                    .top-content img {
                        width: 115px;
                        height: 115px;
                        margin-bottom: 25px;
                    }

                    .top-content h1 {
                        font-size: 27px;
                    }

                .right-side {
                    width: 100%;
                    height: auto;
                    min-height: 650px;
                    padding: 35px 20px;
                }

                .reset-card {
                    max-width: 500px;
                    padding: 40px 35px;
                    min-height: auto;
                }
            }


            @@media (max-width: 576px) {

                .top-content {
                    padding-top: 45px;
                }

                    .top-content img {
                        width: 100px;
                        height: 100px;
                    }

                    .top-content h1 {
                        font-size: 23px;
                    }

                .right-side {
                    padding: 25px 15px;
                }

                .reset-card {
                    padding: 35px 25px;
                }

                    .reset-card h2 {
                        font-size: 22px;
                    }
            }

    </style>
</head>

<body>

    <div class="main-container">

        <div class="reset-wrapper">


            <!-- =====================================
                 LEFT SIDE
            ====================================== -->

            <div class="left-side">

                <div class="top-content">

                    <img src="~/Images/logo.png"
                         alt="Smart Office Records System Logo" />

                    <h1>
                        SMART OFFICE
                        <br />
                        RECORDS SYSTEM
                    </h1>

                </div>

            </div>


            <!-- =====================================
                 RIGHT SIDE
            ====================================== -->

            <div class="right-side">

                <div class="reset-card">


                    <!-- ICON -->

                    <div class="reset-icon">

                        <div class="icon-circle">

                            <i class="bi bi-key-fill"></i>

                        </div>

                    </div>


                    <!-- TITLE -->

                    <h2>
                        Reset Password
                    </h2>

                    <p class="subtitle">
                        Set your new password.
                    </p>


                    <!-- ERROR -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="error-message">

                            <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error

                        </div>
                    }


                    <!-- FORM -->
                    @using (Html.BeginForm("ResetPassword", "Applicant", FormMethod.Post))
                    {

                        <div class="form-section">


                            <!-- NEW PASSWORD -->

                            <div class="mb-3">

                                <label class="form-label">
                                    New Password
                                </label>

                                <div class="input-group-custom">

                                    <i class="bi bi-lock left-icon"></i>

                                    <input type="password"
                                           id="newPassword"
                                           name="NewPassword"
                                           class="form-control-custom"
                                           placeholder="Enter new password"
                                           required />

                                    <i class="bi bi-eye right-icon"
                                       id="toggleNewPassword"></i>

                                </div>

                            </div>


                            <!-- CONFIRM PASSWORD -->

                            <div class="mb-4">

                                <label class="form-label">
                                    Confirm Password
                                </label>

                                <div class="input-group-custom">

                                    <i class="bi bi-lock left-icon"></i>

                                    <input type="password"
                                           id="confirmPassword"
                                           name="ConfirmPassword"
                                           class="form-control-custom"
                                           placeholder="Confirm password"
                                           required />

                                    <i class="bi bi-eye right-icon"
                                       id="toggleConfirmPassword"></i>

                                </div>

                            </div>


                            <!-- RESET BUTTON -->

                            <button type="submit"
                                    class="btn-reset">

                                Reset Password

                            </button>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================
         PASSWORD VISIBILITY SCRIPT
    ====================================== -->

    <script>

            function togglePassword(toggleId, inputId) {

                const toggle = document.getElementById(toggleId);
                const input = document.getElementById(inputId);

                toggle.addEventListener("click", function () {

                    const type = input.getAttribute("type") === "password"
                        ? "text"
                        : "password";

                    input.setAttribute("type", type);

                    this.classList.toggle("bi-eye");
                    this.classList.toggle("bi-eye-slash");

                });

            }

            togglePassword("toggleNewPassword", "newPassword");
            togglePassword("toggleConfirmPassword", "confirmPassword");

    </script>

</body>
</html>