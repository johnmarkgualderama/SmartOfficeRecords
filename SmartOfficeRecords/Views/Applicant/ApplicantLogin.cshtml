@{
    ViewBag.Title = "Applicant Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Applicant Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                min-height: 100vh;
                background: #F4F6F8;
                overflow: hidden;
            }

            .main-container {
                width: 100%;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-wrapper {
                width: 100%;
                height: 100vh;
                display: flex;
                overflow: hidden;
                background: #FFFFFF;
            }

            /* LEFT SIDE */
            .left-side {
                width: 40%;
                height: 100vh;
                background: linear-gradient(145deg, #242D32 0%, #1A2024 45%, #101214 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

                .left-side::before {
                    content: "";
                    position: absolute;
                    width: 500px;
                    height: 500px;
                    top: -250px;
                    left: -250px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.025);
                }

                .left-side::after {
                    content: "";
                    position: absolute;
                    width: 600px;
                    height: 600px;
                    bottom: -350px;
                    right: -350px;
                    border-radius: 50%;
                    background: rgba(237, 28, 36, 0.025);
                }

            .top-content {
                width: 100%;
                text-align: center;
                position: relative;
                z-index: 2;
                padding: 40px;
            }

                .top-content img {
                    width: 132px;
                    height: 132px;
                    object-fit: contain;
                    background: #FFFFFF;
                    padding: 10px;
                    border-radius: 50%;
                    margin-bottom: 32px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
                    transition: transform 0.3s ease;
                }

                    .top-content img:hover {
                        transform: scale(1.03);
                    }

                .top-content h1 {
                    color: #FFFFFF;
                    font-size: 31px;
                    font-weight: 700;
                    line-height: 1.55;
                    letter-spacing: 0.5px;
                    margin: 0;
                    text-align: center;
                    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
                }

            /* RIGHT SIDE */
            .right-side {
                width: 60%;
                height: 100vh;
                background: #F5F7F9;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 40px;
            }

            .login-card {
                width: 100%;
                max-width: 432px;
                background: #FFFFFF;
                border: 1px solid #E5E7EB;
                border-radius: 7px;
                padding: 52px 42px;
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
                animation: slideInCard 0.6s ease forwards;
            }

                .login-card h2 {
                    text-align: center;
                    color: #171717;
                    font-size: 25px;
                    font-weight: 700;
                    margin-bottom: 5px;
                }

            .subtitle {
                text-align: center;
                color: #6B7280;
                font-size: 13px;
                font-weight: 400;
                margin-bottom: 46px;
            }

            .form-label {
                display: block;
                color: #272727;
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .input-group-custom {
                position: relative;
                width: 100%;
                margin-bottom: 36px;
            }

                .input-group-custom .left-icon {
                    position: absolute;
                    left: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #A9B2BD;
                    font-size: 17px;
                    z-index: 3;
                    transition: color 0.2s ease;
                }

                .input-group-custom .right-icon {
                    position: absolute;
                    right: 15px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #A9B2BD;
                    font-size: 17px;
                    cursor: pointer;
                    z-index: 3;
                    transition: color 0.2s ease;
                }

                    .input-group-custom .right-icon:hover {
                        color: #ED1C24;
                    }

            .form-control-custom {
                width: 100%;
                height: 48px;
                background: #FFFFFF;
                border: 1px solid #DDE1E6;
                border-radius: 7px;
                outline: none;
                color: #171717;
                font-size: 14px;
                padding-left: 45px;
                padding-right: 45px;
                transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            }

                .form-control-custom::placeholder {
                    color: #A8B0BC;
                    font-size: 14px;
                }

                .form-control-custom:hover {
                    border-color: #C9CED4;
                }

                .form-control-custom:focus {
                    background: #FFFFFF;
                    border-color: #ED1C24;
                    box-shadow: 0 0 0 3px rgba(237, 28, 36, 0.10);
                }

            .input-group-custom:focus-within .left-icon {
                color: #ED1C24;
            }

            .forgot-password {
                text-align: right;
                margin-top: -18px;
                margin-bottom: 43px;
            }

                .forgot-password a {
                    color: #ED1C24;
                    text-decoration: none;
                    font-size: 13px;
                    font-weight: 500;
                    transition: all 0.2s ease;
                }

                    .forgot-password a:hover {
                        color: #C9151C;
                        text-decoration: underline;
                    }

            .btn-login {
                width: 100%;
                height: 48px;
                border: none;
                border-radius: 7px;
                background: #ED1C24;
                color: #FFFFFF;
                font-size: 16px;
                font-weight: 600;
                letter-spacing: 0.2px;
                cursor: pointer;
                transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
                box-shadow: 0 5px 14px rgba(237, 28, 36, 0.20);
            }

                .btn-login:hover {
                    background: #D8171F;
                    transform: translateY(-1px);
                    box-shadow: 0 8px 18px rgba(237, 28, 36, 0.28);
                }

                .btn-login:active {
                    background: #C9151C;
                    transform: translateY(0);
                    box-shadow: 0 4px 10px rgba(237, 28, 36, 0.20);
                }

            .register-link {
                text-align: center;
                margin-top: 31px;
                color: #333333;
                font-size: 13px;
            }

                .register-link a {
                    color: #ED1C24;
                    text-decoration: underline;
                    font-size: 13px;
                    font-weight: 600;
                    margin-left: 4px;
                    transition: color 0.2s ease;
                }

                    .register-link a:hover {
                        color: #C9151C;
                    }

            .error-message {
                background: #FFF1F2;
                border: 1px solid #FECDD3;
                color: #C9151C;
                text-align: center;
                padding: 11px 12px;
                border-radius: 7px;
                margin-bottom: 22px;
                font-size: 13px;
                font-weight: 500;
            }

            @@keyframes slideInCard {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 991px) {
                body {
                    overflow-y: auto;
                }

                .login-wrapper {
                    min-height: 100vh;
                    flex-direction: column;
                    overflow-y: auto;
                }

                .left-side {
                    width: 100%;
                    height: auto;
                    min-height: 360px;
                }

                .top-content {
                    padding: 45px 20px;
                }

                    .top-content img {
                        width: 105px;
                        height: 105px;
                        margin-bottom: 22px;
                    }

                    .top-content h1 {
                        font-size: 25px;
                        line-height: 1.4;
                    }

                .right-side {
                    width: 100%;
                    height: auto;
                    min-height: 600px;
                    padding: 45px 20px;
                }

                .login-card {
                    max-width: 450px;
                    padding: 42px 30px;
                }
            }

            @@media (max-width: 576px) {
                .left-side {
                    min-height: 320px;
                }

                .top-content {
                    padding: 35px 20px;
                }

                    .top-content img {
                        width: 90px;
                        height: 90px;
                    }

                    .top-content h1 {
                        font-size: 22px;
                    }

                .right-side {
                    padding: 30px 15px;
                }

                .login-card {
                    padding: 35px 24px;
                    border-radius: 8px;
                }

                    .login-card h2 {
                        font-size: 23px;
                    }

                .subtitle {
                    margin-bottom: 35px;
                }
            }
    </style>
</head>

<body>

    <div class="main-container">
        <div class="login-wrapper">

            <div class="left-side">
                <div class="top-content">
                    <img src="~/Images/logo.png" alt="Smart Office Records System Logo" />
                    <h1>
                        SMART OFFICE
                        <br />
                        RECORDS SYSTEM
                    </h1>
                </div>
            </div>

            <div class="right-side">
                <div class="login-card">

                    <h2>Welcome Back!</h2>
                    <p class="subtitle">Please sign in to continue.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="error-message">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            @ViewBag.Error
                        </div>
                    }

                    @using (Html.BeginForm("ApplicantLogin", "Applicant", FormMethod.Post))
                    {
                        <div>
                            <label class="form-label">Username</label>
                            <div class="input-group-custom">
                                <i class="bi bi-person left-icon"></i>
                                <input type="text"
                                       name="Username"
                                       class="form-control-custom"
                                       placeholder="Enter Username"
                                       autocomplete="username"
                                       required />
                            </div>
                        </div>

                        <div>
                            <label class="form-label">Password</label>
                            <div class="input-group-custom">
                                <i class="bi bi-lock left-icon"></i>
                                <input type="password"
                                       id="password"
                                       name="Password"
                                       class="form-control-custom"
                                       placeholder="Enter Password"
                                       autocomplete="current-password"
                                       required />
                                <i class="bi bi-eye right-icon" id="togglePassword"></i>
                            </div>
                        </div>

                        <div class="forgot-password">
                            <a href="@Url.Action("ForgotPassword", "Applicant")">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn-login">Login</button>
                    }

                    <div class="register-link">
                        Don't have an account?
                        <a href="@Url.Action("ApplicantRegister", "Applicant")">Register!</a>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script>
            const togglePassword = document.querySelector("#togglePassword");
            const password = document.querySelector("#password");

            togglePassword.addEventListener("click", function () {
                const type = password.getAttribute("type") === "password" ? "text" : "password";
                password.setAttribute("type", type);
                this.classList.toggle("bi-eye");
                this.classList.toggle("bi-eye-slash");
            });
    </script>

</body>
</html>