﻿@{
ViewBag.Title = "Home";
Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Smart Office Records System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background-color: #eaf6ed; /* Light mint background */
                min-height: 100vh;
                color: #334155;
                padding-top: 70px; /* Add this line to offset the fixed navbar height */
            }

            /* --- NAVBAR STYLING --- */
            .navbar-custom {
                background-color: #ffffff;
                border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                padding: 12px 24px;
            }

            .navbar-brand-custom {
                display: flex;
                align-items: center;
                text-decoration: none;
                gap: 10px;
            }

                .navbar-brand-custom img {
                    width: 40px;
                    height: 40px;
                    object-fit: contain;
                }

            .brand-text {
                color: #0f6328;
                font-weight: 700;
                line-height: 1.1;
                font-size: 14px;
                letter-spacing: 0.5px;
            }

                .brand-text span {
                    color: #1e293b;
                    font-weight: 500;
                    font-size: 12px;
                }

            .nav-links-custom {
                display: flex;
                gap: 30px;
                list-style: none;
                margin: 0;
                padding: 0;
                align-items: center;
            }

            .nav-link-custom {
                text-decoration: none;
                color: #64748b;
                font-weight: 500;
                font-size: 15px;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s ease;
            }

                .nav-link-custom:hover {
                    color: #16a34a;
                }

                .nav-link-custom.active {
                    color: #16a34a;
                    border-bottom: 2px solid #16a34a;
                    padding-bottom: 4px;
                    font-weight: 600;
                }

            .navbar-profile {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .notification-btn {
                background: none;
                border: none;
                color: #64748b;
                font-size: 20px;
                position: relative;
                cursor: pointer;
            }

            .profile-widget {
                display: flex;
                align-items: center;
                gap: 10px;
                background: #f8fafc;
                padding: 6px 12px;
                border-radius: 30px;
                border: 1px solid #e2e8f0;
                cursor: pointer;
            }

            .profile-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background-color: #ffb74d; /* Yellow/Orange avatar placeholder */
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: 600;
                font-size: 13px;
            }

            .profile-info {
                text-align: left;
                line-height: 1.2;
            }

            .profile-name {
                font-size: 12px;
                font-weight: 600;
                color: #1e293b;
                display: block;
            }

            .profile-email {
                font-size: 10px;
                color: #64748b;
                display: block;
            }

            /* --- CONTENT BODY STYLING --- */
            .page-container {
                max-width: 1300px;
                margin: 0 auto;
                padding: 40px 20px;
            }

            .heading-section {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 35px;
            }

            .page-title {
                color: #16a34a;
                font-size: 26px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .page-subtitle {
                color: #64748b;
                font-size: 14px;
                font-weight: 500;
                margin: 0;
            }

            /* Date display pill */
            .date-pill-container {
                display: flex;
                background: white;
                border: 1px solid #e2e8f0;
                border-radius: 10px;
                overflow: hidden;
            }

            .date-pill-value {
                padding: 12px 24px;
                font-size: 15px;
                font-weight: 600;
                color: #334155;
            }

            .date-pill-day {
                padding: 12px 24px;
                background-color: #f8fafc;
                border-left: 1px solid #e2e8f0;
                font-size: 15px;
                font-weight: 600;
                color: #334155;
            }

            /* --- LEFT MAIN CONTAINER CARD --- */
            .main-dashboard-box {
                background-color: #ffffff;
                border-radius: 12px;
                padding: 40px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
                height: 100%;
            }

            .section-title-custom {
                font-size: 18px;
                font-weight: 700;
                color: #475569;
                margin-bottom: 20px;
            }

            /* --- QUICK ACTIONS STYLING (UPDATED) --- */
            .quick-actions-grid {
                display: flex;
                gap: 20px;
                margin-bottom: 45px;
                flex-wrap: wrap;
            }

            .action-card-button {
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: flex-start;
                gap: 16px;
                width: 230px;
                height: 75px;
                background-color: #ffffff;
                border: 1.5px solid #a7f3d0;
                border-radius: 8px;
                text-decoration: none;
                color: #1e293b;
                transition: all 0.2s ease;
                padding: 10px 20px;
            }

                .action-card-button:hover {
                    background-color: #f0fdf4;
                    border-color: #16a34a;
                    transform: translateY(-2px);
                    color: #16a34a;
                }

                .action-card-button i {
                    font-size: 32px;
                    color: #16a34a;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .action-card-button span {
                    font-size: 11px;
                    font-weight: 700;
                    line-height: 1.3;
                    text-align: left;
                    color: #334155;
                }

            /* --- TABLE STYLING --- */
            .recent-request-section {
                margin-top: 20px;
            }

            .custom-table-container {
                border: 1px solid #16a34a;
                border-radius: 8px;
                overflow: hidden;
            }

            .custom-table {
                width: 100%;
                border-collapse: collapse;
                margin: 0;
            }

                .custom-table th {
                    background-color: #eaf6ed;
                    color: #000000;
                    font-weight: 700;
                    font-size: 14px;
                    padding: 14px 20px;
                    text-align: left;
                    border-bottom: 1px solid #16a34a;
                }

                .custom-table td {
                    padding: 16px 20px;
                    vertical-align: middle;
                    font-size: 13px;
                    color: #334155;
                    background-color: #ffffff;
                    font-weight: 500;
                }

            /* Status Pills */
            .status-pill-pending {
                background-color: #ffe0b2;
                color: #e65100;
                font-weight: 600;
                font-size: 11px;
                padding: 4px 12px;
                border-radius: 4px;
                display: inline-block;
            }

            .status-pill-approved {
                background-color: #a7f3d0;
                color: #047857;
                font-weight: 600;
                font-size: 11px;
                padding: 4px 12px;
                border-radius: 4px;
                display: inline-block;
            }

            /* --- RIGHT COL SIDEBAR CARDS --- */
            .sidebar-panel {
                background-color: #ffffff;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
                margin-bottom: 24px;
            }

            .sidebar-header {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 15px;
                font-weight: 700;
                color: #1e293b;
                margin-bottom: 12px;
            }

                .sidebar-header i {
                    color: #16a34a;
                    font-size: 18px;
                }

            .sidebar-body {
                font-size: 12px;
                color: #64748b;
                line-height: 1.6;
            }

            .announcements-box {
                background-color: #eaf6ed; /* Slightly lighter mint tint for Announcements */
                border: none;
            }

            /* Responsive UI adjustments */
            @@media (max-width: 991px) {
                .heading-section {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }

                .date-pill-container {
                    align-self: flex-start;
                }

                .nav-links-custom {
                    display: none;
                }
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- Left: Brand Logo -->
            <a class="navbar-brand-custom" href="#">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text">
                    SMART OFFICE<br />
                    <span>RECORDS SYSTEM</span>
                </div>
            </a>

            <!-- Center: Navigation Links -->
            <ul class="nav-links-custom">
                <li>
                    <a href="@Url.Action("ApplicantDash", "Applicant")" class="nav-link-custom active">
                        <i class="bi bi-house-door-fill"></i> Home
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("BookInterview", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i> Book Interview
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("MyAppointment", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-person-bounding-box"></i> My Appointment
                    </a>
                </li>
            </ul>

            <!-- Right: Notifications & Profile -->
            <div class="navbar-profile">
                <button class="notification-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <div class="dropdown">
                    <div class="profile-widget dropdown-toggle" data-bs-toggle="dropdown" style="cursor: pointer;">
                        <div class="profile-avatar">@ViewBag.Initials</div>
                        <div class="profile-info">
                            <span class="profile-name">@ViewBag.FullName</span>
                            <span class="profile-email">@ViewBag.Email</span>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Profile", "Applicant")">
                                <i class="bi bi-person-gear me-2"></i>My Account
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("ApplicantLogout", "Applicant")">
                                <i class="bi bi-box-arrow-left me-2"></i>Sign Out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="page-container">

        <!-- Header Panel Layout -->
        <div class="heading-section">
            <div>
                <h1 class="page-title">Welcome @ViewBag.Username!</h1>
                <p class="page-subtitle">Here's what's happening with your interviews and records today.</p>
            </div>

            <!-- Header Date Pills -->
            <div class="date-pill-container">
                <div class="date-pill-value" id="currentDate">July 12, 2026</div>
                <div class="date-pill-day" id="currentDay">Monday</div>
            </div>
        </div>

        <div class="row g-4">

            <!-- Left Column: Main Dashboard Features (Col-8) -->
            <div class="col-lg-8">
                <div class="main-dashboard-box">

                    <!-- Quick Actions -->
                    <h5 class="section-title-custom">Quick Actions</h5>
                    <div class="quick-actions-grid">
                        <a href="@Url.Action("BookInterview", "Applicant")" class="action-card-button">
                            <i class="bi bi-funnel-fill"></i>
                            <span>Submit New Request</span>
                        </a>
                        <a href="@Url.Action("MyAppointment", "Applicant")" class="action-card-button">
                            <i class="bi bi-folder-fill"></i>
                            <span>My Request</span>
                        </a>
                        <a href="#" class="action-card-button">
                            <i class="bi bi-box-arrow-down"></i>
                            <span>Download Approved Documents</span>
                        </a>
                    </div>

                    <!-- Recent Request Table -->
                    <div class="recent-request-section">
                        <h5 class="section-title-custom">Recent Request</h5>

                        <div class="custom-table-container">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;">Request ID</th>
                                        <th style="width: 25%;">Service</th>
                                        <th style="width: 30%;">Date Submitted</th>
                                        <th style="width: 20%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>RI01</td>
                                        <td>RI01</td>
                                        <td>July 15, 2026</td>
                                        <td><span class="status-pill-pending">Pending</span></td>
                                    </tr>
                                    <tr>
                                        <td>RI01</td>
                                        <td>RI01</td>
                                        <td>July 15, 2026</td>
                                        <td><span class="status-pill-approved">Approved</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Column: Sidebar Panels (Col-4) -->
            <div class="col-lg-4">

                <!-- Announcements Card (Tinted Mint Background) -->
                <div class="sidebar-panel announcements-box">
                    <div class="sidebar-header">
                        <i class="bi bi-megaphone-fill"></i> Announcements
                    </div>
                    <div class="sidebar-body">
                        Office holiday schedule updated. (August 04, 2030)
                    </div>
                </div>

                <!-- Office Info Card -->
                <div class="sidebar-panel">
                    <div class="sidebar-header">
                        <i class="bi bi-info-circle-fill"></i> Office Info
                    </div>
                    <div class="sidebar-body">
                        Office holiday schedule updated. (August 04, 2030)
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Date Helper Script -->
    <script>
            const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

            const now = new Date();
            document.getElementById("currentDate").innerText = `${months[now.getMonth()]} ${now.getDate()}, ${now.getFullYear()}`;
            document.getElementById("currentDay").innerText = days[now.getDay()];
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>