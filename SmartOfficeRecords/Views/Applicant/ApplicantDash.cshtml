                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="status-box progress-box">
                        <div class="status-box-title">Overall Progress</div>
                        <div class="progress-circle">
                            <span class="progress-number">75%</span>
                        </div>
                        <div class="progress-label">Document Verification</div>
