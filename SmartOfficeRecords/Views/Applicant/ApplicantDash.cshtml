                    </div>
                    <div class="timeline-step completed">
                        <div class="timeline-dot"><i class="bi bi-check"></i></div>
                        <div class="timeline-title">Under Review</div>
                        <div class="timeline-date">July 15, 2026</div>
                    </div>
                    <div class="timeline-step current">
                        <div class="timeline-dot"><i class="bi bi-circle-fill" style="font-size:7px;"></i></div>
                        <div class="timeline-title">Interview Schedule</div>
                        <div class="timeline-date">July 15, 2026</div>
                    </div>
                    <div class="timeline-step">
                        <div class="timeline-dot"></div>
                        <div class="timeline-title">Document Verification</div>
                        <div class="timeline-date">July 15, 2026</div>
                    </div>
                    <div class="timeline-step">
                        <div class="timeline-dot"></div>
                        <div class="timeline-title">Final Approval Pending</div>
                        <div class="timeline-date">July 15, 2026</div>
                    </div>
                </div>
            </div>

            <div class="status-alert">
                <i class="bi bi-info-circle-fill"></i>
                <span>Your request is currently being verified by our office. You will be notified once approved.</span>
            </div>

            <div class="recent-activity">
                <div class="activity-title">Recent Activity</div>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-date">July 15, 2026 <span class="activity-time">Time</span></div>
                        <div class="activity-description">You submitted a request for document verification</div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-date">July 15, 2026 <span class="activity-time">Time</span></div>
                        <div class="activity-description">You submitted a request for document verification</div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-date">July 15, 2026 <span class="activity-time">Time</span></div>
                        <div class="activity-description">You submitted a request for document verification</div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-date">July 15, 2026 <span class="activity-time">Time</span></div>
                        <div class="activity-description">You submitted a request for document verification</div>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <script>
            const toggleSidebar = document.getElementById("toggleSidebar");
            toggleSidebar.addEventListener("click", function () {
                document.body.classList.toggle("sidebar-collapsed");
            });

            const profileContainer = document.querySelector(".profile-container");
            const profileToggle = document.getElementById("profileToggle");

            profileToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                profileContainer.classList.toggle("open");
                notificationContainer.classList.remove("open");
            });

            const notificationContainer = document.querySelector(".notification-container");
            const notificationToggle = document.getElementById("notificationToggle");

            notificationToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                notificationContainer.classList.toggle("open");
                profileContainer.classList.remove("open");
            });

            document.addEventListener("click", function (e) {
                if (!profileContainer.contains(e.target)) {
                    profileContainer.classList.remove("open");
                }
                if (!notificationContainer.contains(e.target)) {
                    notificationContainer.classList.remove("open");
                }
            });

            // SETTINGS DROPDOWN
            const settingsToggle = document.getElementById("settingsToggle");
            const settingsParent = document.querySelector(".settings-toggle");
            const settingsGroup = document.querySelector(".sidebar-settings");
            const settingsLink = document.getElementById("settingsLink");

            settingsToggle.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                settingsGroup.classList.toggle("open");
                settingsParent.classList.add("active");
            });

            settingsLink.addEventListener("click", function () {
                settingsParent.classList.add("active");
                settingsLink.classList.add("active");
            });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
