@{
    ViewBag.Title = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - SORS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #f1f1f1;
                color: #263238;
                min-height: 100vh;
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

            :root {
                --red: #ed1c24;
                --red-dark: #c9151c;
                --red-light: #fff1f1;
                --sidebar: #222b30;
                --sidebar-hover: #2d373d;
                --white: #ffffff;
                --black-gray: #263238;
                --dark-gray: #455a64;
                --gray: #78909c;
                --light-gray: #eceff1;
                --border: #e1e5e8;
                --page-bg: #f1f1f1;
            }

            /* NAVBAR */
            .navbar-custom {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 56px;
                background: var(--white);
                border-bottom: 1px solid #e0e0e0;
                display: flex;
                align-items: center;
                z-index: 1030;
                padding: 0;
            }

            .navbar-left-box {
                width: 155px;
                height: 56px;
                background: var(--sidebar);
                display: flex;
                align-items: center;
                padding: 0 15px;
                border-right: 1px solid #39434a;
                transition: all .3s ease;
            }

            .navbar-brand-custom {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .navbar-brand-custom img {
                    width: 34px;
                    height: 34px;
                    object-fit: contain;
                    border-radius: 50%;
                }

            .brand-text {
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: .4px;
            }

            .toggle-zone-box {
                height: 56px;
                width: 55px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #ffffff;
            }

            .sidebar-toggle-btn {
                border: none;
                background: transparent;
                color: var(--red);
                font-size: 18px;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: .2s ease;
            }

                .sidebar-toggle-btn:hover {
                    color: var(--red-dark);
                }

            .navbar-profile {
                margin-left: auto;
                height: 56px;
                display: flex;
                align-items: center;
                gap: 15px;
                padding-right: 15px;
            }

            /* NOTIFICATION */
            .notification-container {
                position: relative;
            }

            .notification-btn {
                width: 40px;
                height: 40px;
                border: none;
                background: transparent;
                color: var(--dark-gray);
                font-size: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: .2s ease;
            }

                .notification-btn:hover {
                    color: var(--red);
                }

            .notification-badge-dot {
                position: absolute;
                top: 8px;
                right: 7px;
                width: 7px;
                height: 7px;
                background: var(--red);
                border-radius: 50%;
                border: 1px solid white;
            }

            .notification-dropdown-custom {
                position: absolute;
                right: 0;
                top: 48px;
                width: 330px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
                overflow: hidden;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all .25s ease;
                z-index: 1050;
            }

            .notification-container.open .notification-dropdown-custom {
                max-height: 450px;
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .notif-header {
                padding: 14px 16px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #eeeeee;
            }

            .notif-header-title {
                color: var(--black-gray);
                font-size: 13px;
                font-weight: 700;
            }

            .notif-mark-read {
                color: var(--red);
                font-size: 10px;
                font-weight: 600;
            }

                .notif-mark-read:hover {
                    color: var(--red-dark);
                }

            .notif-body {
                max-height: 300px;
                overflow-y: auto;
            }

            .notif-item {
                display: flex;
                gap: 10px;
                padding: 12px 15px;
                border-bottom: 1px solid #f1f1f1;
                color: inherit;
                transition: .2s ease;
            }

                .notif-item:hover {
                    background: var(--red-light);
                }

            .notif-icon-box {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .notif-icon-success {
                background: #e8f5e9;
                color: #43a047;
            }

            .notif-icon-warning {
                background: #fff3e0;
                color: #fb8c00;
            }

            .notif-text {
                color: var(--dark-gray);
                font-size: 11px;
                line-height: 1.4;
            }

            .notif-time {
                color: #9e9e9e;
                font-size: 9px;
                margin-top: 3px;
            }

            .notif-footer {
                padding: 10px;
                text-align: center;
                background: #fafafa;
                border-top: 1px solid #eeeeee;
            }

            .notif-footer-btn {
                color: var(--red);
                font-size: 11px;
                font-weight: 600;
            }

            /* PROFILE */
            .profile-container {
                position: relative;
            }

            .profile-widget {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 4px 8px;
                border-radius: 20px;
                background: #f5f5f5;
                border: 1px solid #e3e3e3;
                cursor: pointer;
                transition: .2s ease;
            }

                .profile-widget:hover {
                    background: #eeeeee;
                }

            .profile-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: #ffb52e;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
            }

            .profile-info {
                line-height: 1.1;
            }

            .profile-name {
                display: block;
                color: var(--black-gray);
                font-size: 10px;
                font-weight: 700;
            }

            .profile-email {
                display: block;
                color: #78909c;
                font-size: 8px;
            }

            .profile-arrow {
                color: #546e7a;
                font-size: 11px;
                transition: .3s;
            }

            .profile-dropdown-custom {
                position: absolute;
                right: 0;
                top: 48px;
                width: 200px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
                overflow: hidden;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all .25s ease;
                z-index: 1050;
            }

            .profile-container.open .profile-dropdown-custom {
                max-height: 200px;
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .profile-container.open .profile-arrow {
                transform: rotate(180deg);
            }

            .profile-dropdown-custom a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 15px;
                color: var(--dark-gray);
                font-size: 12px;
                font-weight: 500;
                transition: .2s ease;
            }

                .profile-dropdown-custom a:hover {
                    background: var(--red-light);
                    color: var(--red);
                }

                .profile-dropdown-custom a i {
                    font-size: 16px;
                }

            /* SIDEBAR */
            .sidebar-menu-wrapper {
                position: fixed;
                top: 56px;
                left: 0;
                bottom: 0;
                width: 155px;
                background: var(--sidebar);
                border-right: 1px solid #39434a;
                padding: 15px 8px;
                overflow-y: auto;
                overflow-x: hidden;
                z-index: 1020;
                transition: all .3s ease;
            }

                .sidebar-menu-wrapper::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-menu-wrapper::-webkit-scrollbar-track {
                    background: var(--sidebar);
                }

                .sidebar-menu-wrapper::-webkit-scrollbar-thumb {
                    background: #45545d;
                    border-radius: 10px;
                }

            .sidebar-links {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .sidebar-link-item {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 10px;
                border-radius: 5px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 500;
                white-space: nowrap;
                transition: all .2s ease;
            }

                .sidebar-link-item i {
                    width: 17px;
                    min-width: 17px;
                    font-size: 14px;
                    display: inline-flex;
                    justify-content: center;
                }

                .sidebar-link-item:hover {
                    color: var(--red);
                    background: rgba(237, 28, 36, .08);
                }

                .sidebar-link-item.active {
                    color: var(--red);
                    background: transparent;
                    font-weight: 600;
                }

            .logout-wrapper {
                position: absolute;
                bottom: 15px;
                left: 8px;
                right: 8px;
            }

            .logout-link {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 10px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 500;
                border-radius: 5px;
                transition: .2s ease;
            }

                .logout-link:hover {
                    color: var(--red);
                    background: rgba(237,28,36,.08);
                }

                .logout-link i {
                    font-size: 16px;
                }

            /* MAIN CONTENT */
            .page-container {
                margin-left: 155px;
                padding: 78px 18px 35px 18px;
                min-height: 100vh;
                transition: margin-left .3s ease;
            }

            .heading-section {
                margin-bottom: 20px;
            }

            .page-title {
                color: var(--black-gray);
                font-size: 23px;
                font-weight: 700;
                margin-bottom: 2px;
            }

            .page-subtitle {
                color: #607d8b;
                font-size: 11px;
                font-weight: 500;
                margin: 0;
            }

            .dashboard-card {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 8px;
                padding: 20px;
                box-shadow: 0 3px 15px rgba(0,0,0,.04);
            }

            .status-title {
                color: var(--red);
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 15px;
            }

            .status-box {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 8px;
                min-height: 145px;
                padding: 15px;
                box-shadow: 0 3px 12px rgba(0,0,0,.04);
            }

            .status-box-title {
                color: #78909c;
                font-size: 11px;
                font-weight: 600;
                margin-bottom: 13px;
            }

            .request-status {
                color: var(--red);
                font-size: 13px;
                font-weight: 700;
                margin-bottom: 17px;
            }

            .request-details {
                display: grid;
                grid-template-columns: 1fr 1fr;
                row-gap: 9px;
            }

                .request-details span {
                    font-size: 10px;
                    font-weight: 500;
                    color: #78909c;
                }

                .request-details strong {
                    font-size: 10px;
                    font-weight: 600;
                    color: #607d8b;
                }

            .progress-box {
                text-align: center;
            }

            .progress-circle {
                width: 75px;
                height: 75px;
                margin: 0 auto 5px;
                border-radius: 50%;
                background: conic-gradient(var(--red) 0deg 270deg, #e5e7eb 270deg 360deg);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

                .progress-circle::before {
                    content: "";
                    position: absolute;
                    width: 60px;
                    height: 60px;
                    background: white;
                    border-radius: 50%;
                }

            .progress-number {
                position: relative;
                z-index: 1;
                color: #334155;
                font-size: 20px;
                font-weight: 700;
            }

            .progress-label {
                color: #64748b;
                font-size: 11px;
                font-weight: 600;
            }

            .timeline-wrapper {
                position: relative;
                margin: 25px 0 20px;
                padding: 0;
            }

            .timeline-line {
                position: absolute;
                top: 10px;
                left: 2%;
                width: 96%;
                height: 7px;
                background: #d9dcdf;
                z-index: 0;
            }

            .timeline-progress {
                position: absolute;
                top: 10px;
                left: 2%;
                width: 48%;
                height: 7px;
                background: var(--red);
                z-index: 1;
            }

            .timeline-steps {
                position: relative;
                z-index: 2;
                display: grid;
                grid-template-columns: repeat(5, 1fr);
            }

            .timeline-step {
                text-align: center;
            }

            .timeline-dot {
                width: 30px;
                height: 30px;
                margin: -1px auto 15px;
                border-radius: 50%;
                background: #d9dcdf;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 13px;
                font-weight: 700;
            }

            .timeline-step.completed .timeline-dot,
            .timeline-step.current .timeline-dot {
                background: var(--red);
            }

            .timeline-step.current .timeline-dot {
                box-shadow: 0 0 0 5px rgba(237,28,36,.12);
            }

            .timeline-title {
                color: #64748b;
                font-size: 11px;
                font-weight: 600;
                margin-bottom: 2px;
            }

            .timeline-date {
                color: #64748b;
                font-size: 9px;
                font-weight: 500;
            }

            .status-alert {
                display: flex;
                align-items: center;
                gap: 10px;
                background: #eeeeee;
                padding: 8px 10px;
                margin: 10px 8px 20px;
                color: #555;
                font-size: 10px;
                font-style: italic;
            }

                .status-alert i {
                    color: var(--red);
                    font-size: 14px;
                }

            .recent-activity {
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                padding: 10px 12px 12px;
                background: white;
            }

            .activity-title {
                color: #334155;
                font-size: 12px;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .activity-list {
                position: relative;
                padding-left: 18px;
            }

                .activity-list::before {
                    content: "";
                    position: absolute;
                    left: 4px;
                    top: 7px;
                    bottom: 7px;
                    width: 2px;
                    background: var(--red);
                }

            .activity-item {
                position: relative;
                display: grid;
                grid-template-columns: 145px 1fr;
                gap: 15px;
                padding: 4px 0;
            }

                .activity-item::before {
                    content: "";
                    position: absolute;
                    left: -18px;
                    top: 8px;
                    width: 9px;
                    height: 9px;
                    background: var(--red);
                    border-radius: 50%;
                }

            .activity-date {
                color: #475569;
                font-size: 9px;
                font-weight: 600;
            }

            .activity-time {
                display: block;
                color: #94a3b8;
                font-size: 8px;
            }

            .activity-description {
                color: #94a3b8;
                font-size: 8px;
                padding-top: 1px;
            }

            /* COLLAPSE */
            body.sidebar-collapsed .navbar-left-box {
                width: 60px;
                padding: 0;
                justify-content: center;
            }

            body.sidebar-collapsed .brand-text {
                display: none;
            }

            body.sidebar-collapsed .sidebar-menu-wrapper {
                width: 60px;
                padding-left: 6px;
                padding-right: 6px;
            }

            body.sidebar-collapsed .sidebar-link-item {
                justify-content: center;
                padding-left: 0;
                padding-right: 0;
                gap: 0;
            }

            body.sidebar-collapsed .sidebar-link-text {
                display: none;
            }

            body.sidebar-collapsed .logout-link {
                justify-content: center;
                padding-left: 0;
                padding-right: 0;
            }

            body.sidebar-collapsed .logout-text {
                display: none;
            }

            body.sidebar-collapsed .page-container {
                margin-left: 60px;
            }

            /* RESPONSIVE */
            @@media (max-width: 991px) {
                .navbar-left-box {
                    width: 210px;
                }

                .sidebar-menu-wrapper {
                    width: 210px;
                }

                .page-container {
                    margin-left: 210px;
                }

                body.sidebar-collapsed .page-container {
                    margin-left: 60px;
                }

                .timeline-steps {
                    grid-template-columns: repeat(5, 130px);
                    min-width: 650px;
                }

                .timeline-wrapper {
                    overflow-x: auto;
                    padding-bottom: 10px;
                }

                .timeline-line, .timeline-progress {
                    width: 96%;
                }

                .activity-item {
                    grid-template-columns: 110px 1fr;
                }
            }

            @@media (max-width: 700px) {
                .navbar-left-box {
                    width: 60px;
                    padding: 0;
                    justify-content: center;
                }

                .brand-text {
                    display: none;
                }

                .sidebar-menu-wrapper {
                    width: 60px;
                }

                .sidebar-link-item {
                    justify-content: center;
                    padding: 11px 0;
                    gap: 0;
                }

                .sidebar-link-text {
                    display: none;
                }

                .page-container {
                    margin-left: 60px;
                    padding: 90px 15px 25px;
                }

                .profile-info {
                    display: none;
                }

                .profile-widget {
                    padding: 4px;
                }

                .status-box {
                    margin-bottom: 12px;
                }

                .activity-item {
                    grid-template-columns: 1fr;
                    gap: 2px;
                }
            }
            /* SETTINGS DROPDOWN */
            .sidebar-settings {
                list-style: none;
            }

            .settings-toggle {
                justify-content: space-between;
                cursor: pointer;
            }

                .settings-toggle > a {
                    color: #ffffff !important;
                }

                    .settings-toggle > a:hover {
                        color: var(--red) !important;
                    }

                .settings-toggle.active {
                    color: var(--red);
                    background: rgba(237,28,36,.08);
                }

                    .settings-toggle.active > a {
                        color: var(--red) !important;
                    }

            .settings-arrow {
                color: #ffffff;
                font-size: 11px;
                transition: .3s;
            }

            .settings-toggle:hover .settings-arrow {
                color: var(--red);
            }

            .settings-submenu {
                list-style: none;
                padding: 0 0 0 12px;
                margin: 2px 0 0 0;
                max-height: 0;
                overflow: hidden;
                transition: max-height .3s ease;
            }

                .settings-submenu li {
                    margin: 2px 0;
                }

                .settings-submenu a {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 8px 9px;
                    border-radius: 5px;
                    color: #ffffff !important;
                    font-size: 11px;
                    font-weight: 500;
                    transition: .2s ease;
                }

                    .settings-submenu a:hover {
                        background: rgba(237,28,36,.10);
                        color: var(--red) !important;
                    }

                    .settings-submenu a i {
                        color: #ffffff;
                        font-size: 12px;
                    }

                    .settings-submenu a:hover i {
                        color: var(--red);
                    }

            .sidebar-settings.open .settings-submenu {
                max-height: 150px;
            }

            .sidebar-settings.open .settings-arrow {
                transform: rotate(90deg);
            }

            body.sidebar-collapsed .settings-arrow {
                display: none;
            }

            body.sidebar-collapsed .settings-submenu {
                display: none !important;
            }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar-custom">

        <div class="navbar-left-box">
            <a class="navbar-brand-custom" href="@Url.Action("ApplicantDash", "Applicant")">
                <img src="~/Images/logo.png" alt="SORS Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <span class="brand-text">SORS</span>
            </a>
        </div>

        <div class="toggle-zone-box">
            <button class="sidebar-toggle-btn" id="toggleSidebar" type="button" title="Toggle Sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="navbar-profile">

            <div class="notification-container">
                <button class="notification-btn" id="notificationToggle" type="button" title="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notification-badge-dot"></span>
                </button>

                <div class="notification-dropdown-custom" id="notificationMenu">
                    <div class="notif-header">
                        <span class="notif-header-title">Notifications</span>
                        <a href="#" class="notif-mark-read">Mark all as read</a>
                    </div>
                    <div class="notif-body">
                        <a href="#" class="notif-item">
                            <div class="notif-icon-box notif-icon-success"><i class="bi bi-check-circle-fill"></i></div>
                            <div>
                                <div class="notif-text">Your interview request has been approved.</div>
                                <div class="notif-time">10 mins ago</div>
                            </div>
                        </a>
                        <a href="#" class="notif-item">
                            <div class="notif-icon-box notif-icon-warning"><i class="bi bi-clock-history"></i></div>
                            <div>
                                <div class="notif-text">Reminder: Check your interview schedule.</div>
                                <div class="notif-time">2 hours ago</div>
                            </div>
                        </a>
                    </div>
                    <div class="notif-footer">
                        <a href="#" class="notif-footer-btn">View All Notifications</a>
                    </div>
                </div>
            </div>

            <div class="profile-container">
                <div class="profile-widget" id="profileToggle">
                    <div class="profile-avatar">@ViewBag.Initials</div>
                    <div class="profile-info">
                        <span class="profile-name">@ViewBag.FullName</span>
                        <span class="profile-email">@ViewBag.Email</span>
                    </div>
                    <i class="bi bi-chevron-down profile-arrow"></i>
                </div>

                <div class="profile-dropdown-custom" id="profileMenu">
