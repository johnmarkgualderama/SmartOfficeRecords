@{
    ViewBag.Title = "Verify Code";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Code</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Poppins Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #f4f6f9;
                min-height: 100vh;
                overflow: hidden;
            }

            /* =========================
                               MAIN CONTAINER
                            ========================== */

            .main-container {
                width: 100%;
                height: 100vh;
                display: flex;
            }

            .reset-wrapper {
                width: 100%;
                height: 100vh;
                display: flex;
                overflow: hidden;
                background: #ffffff;
            }

            /* =========================
                               LEFT SIDE
                            ========================== */

            .left-side {
                width: 41%;
                height: 100vh;
                background: linear-gradient( 145deg, #202a2f 0%, #171e22 45%, #0e1011 100% );
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
                align-items: center;
                overflow: hidden;
            }

                /* Subtle background effect */

                .left-side::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: radial-gradient( circle at 50% 20%, rgba(255,255,255,0.035), transparent 35% );
                    pointer-events: none;
                }

            /* =========================
                               LOGO + SYSTEM NAME
                            ========================== */

            .brand-section {
                width: 100%;
                text-align: center;
                padding-top: 105px;
                position: relative;
                z-index: 2;
            }

            .brand-logo {
                width: 138px;
                height: 138px;
                object-fit: contain;
                background: #ffffff;
                padding: 10px;
                border-radius: 50%;
                display: block;
                margin: 0 auto 35px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            }

            .brand-title {
                color: #ffffff;
                font-size: 34px;
                font-weight: 700;
                line-height: 1.35;
                letter-spacing: 0.3px;
                text-align: center;
                margin: 0;
            }

            /* =========================
                               RIGHT SIDE
                            ========================== */

            .right-side {
                width: 59%;
                height: 100vh;
                background: #ffffff;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 40px;
            }

            /* =========================
                               RESET CODE CARD
                            ========================== */

            .reset-card {
                width: 100%;
                max-width: 495px;
                min-height: 590px;
                background: #ffffff;
                border: 1px solid #dfe5ea;
                border-radius: 9px;
                padding: 42px 64px;
                box-shadow: 0 8px 25px rgba(15, 23, 42, 0.035);
                text-align: center;
                opacity: 0;
                animation: slideInCard 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            /* =========================
                               ICON
                            ========================== */

            .reset-icon {
                display: flex;
                justify-content: center;
                margin-bottom: 18px;
            }

            .icon-circle {
                width: 82px;
                height: 82px;
                border-radius: 50%;
                background: #fff0f0;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .icon-circle i {
                    font-size: 43px;
                    color: #ed1c24;
                }

            /* =========================
                               TITLE
                            ========================== */

            .reset-card h2 {
                color: #26323a;
                font-size: 25px;
                font-weight: 700;
                margin: 0 0 16px;
            }

            /* =========================
                               SUBTITLE
                            ========================== */

            .subtitle {
                color: #64748b;
                font-size: 15px;
                font-weight: 500;
                margin: 0 auto 38px;
                line-height: 1.5;
            }

            /* =========================
                               FORM
                            ========================== */

            .code-form {
                width: 100%;
                text-align: left;
            }

            .form-label {
                display: block;
                color: #94a3b8;
                font-size: 14px;
                font-weight: 500;
                margin-bottom: 8px;
            }

            /* =========================
                               CODE INPUT
                            ========================== */

            .code-input {
                width: 100%;
                height: 50px;
                border: 1px solid #e5d8d8;
                border-radius: 7px;
                background: #ffffff;
                outline: none;
                padding: 0 16px;
                font-size: 17px;
                font-weight: 500;
                letter-spacing: 4px;
                color: #26323a;
                text-align: center;
                transition: all 0.2s ease;
                box-shadow: 0 2px 8px rgba(239, 68, 68, 0.08);
            }

                /* Placeholder */

                .code-input::placeholder {
                    color: #b8bec5;
                    letter-spacing: 0;
                    font-size: 14px;
                    font-weight: 400;
                }

                /* Focus */

                .code-input:focus {
                    border-color: #ed1c24;
                    box-shadow: 0 0 0 4px rgba(237, 28, 36, 0.10);
                }

                /* Remove number arrows */

                .code-input::-webkit-outer-spin-button,
                .code-input::-webkit-inner-spin-button {
                    -webkit-appearance: none;
                    margin: 0;
                }

            /* =========================
                               VERIFY BUTTON
                            ========================== */

            .btn-verify {
                width: 100%;
                height: 58px;
                border: none;
                border-radius: 7px;
                background: #ed1c24;
                color: #ffffff;
                font-size: 17px;
                font-weight: 700;
                margin-top: 37px;
                cursor: pointer;
                transition: all 0.2s ease;
                box-shadow: 0 7px 15px rgba(237, 28, 36, 0.18);
            }

                .btn-verify:hover {
                    background: #d71920;
                    transform: translateY(-2px);
                    box-shadow: 0 10px 22px rgba(237, 28, 36, 0.25);
                }

                .btn-verify:active {
                    transform: translateY(1px);
                    box-shadow: 0 5px 10px rgba(237, 28, 36, 0.18);
                }

            /* =========================
                               REMAINING TIME
                            ========================== */

            .remaining-time {
                margin-top: 32px;
                text-align: center;
                color: #64748b;
                font-size: 15px;
                font-weight: 600;
            }

                .remaining-time strong {
                    color: #3478f6;
                    font-weight: 700;
                }

            /* =========================
                               ERROR MESSAGE
                            ========================== */

            .error-message {
                background-color: #fff1f2;
                border: 1px solid #fecdd3;
                color: #dc2626;
                text-align: center;
                padding: 10px 12px;
                border-radius: 7px;
                margin-bottom: 18px;
                font-size: 13px;
                font-weight: 500;
            }

            /* =========================
                               ANIMATION
                            ========================== */

            @@keyframes slideInCard {

                from {
                    opacity: 0;
                    transform: translateY(25px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* =========================
                               RESPONSIVE
                            ========================== */

            @@media (max-width: 991px) {

                body {
                    overflow-y: auto;
                }

                .reset-wrapper {
                    min-height: 100vh;
                    height: auto;
                    flex-direction: column;
                }

                .left-side {
                    width: 100%;
                    height: auto;
                    min-height: 360px;
                }

                .brand-section {
                    padding-top: 50px;
                    padding-bottom: 50px;
                }

                .brand-logo {
                    width: 110px;
                    height: 110px;
                    margin-bottom: 25px;
                }

                .brand-title {
                    font-size: 27px;
                }

                .right-side {
                    width: 100%;
                    height: auto;
                    min-height: 650px;
                    padding: 35px 20px;
                }

                .reset-card {
                    max-width: 500px;
                    min-height: auto;
                    padding: 40px 30px;
                }
            }

            /* =========================
                               MOBILE
                            ========================== */

            @@media (max-width: 576px) {

                .left-side {
                    min-height: 300px;
                }

                .brand-section {
                    padding-top: 35px;
                    padding-bottom: 35px;
                }

                .brand-logo {
                    width: 90px;
                    height: 90px;
                    margin-bottom: 20px;
                }

                .brand-title {
                    font-size: 22px;
                }

                .right-side {
                    padding: 25px 15px;
                }

                .reset-card {
                    padding: 35px 22px;
                }

                    .reset-card h2 {
                        font-size: 23px;
                    }

                .subtitle {
                    font-size: 14px;
                }

                .icon-circle {
                    width: 75px;
                    height: 75px;
                }

                    .icon-circle i {
                        font-size: 38px;
                    }

                .btn-verify {
                    height: 54px;
                }

                .code-input::placeholder {
                    font-size: 13px;
                }
            }

    </style>
</head>

<body>

    <div class="main-container">

        <div class="reset-wrapper">

            <!-- =========================
                 LEFT SIDE
            ========================== -->

            <div class="left-side">

                <div class="brand-section">

                    <img src="~/Images/logo.png"
                         alt="Smart Office Records System Logo"
                         class="brand-logo" />

                    <h1 class="brand-title">
                        SMART OFFICE
                        <br />
                        RECORDS SYSTEM
                    </h1>

                </div>

            </div>


            <!-- =========================
                 RIGHT SIDE
            ========================== -->

            <div class="right-side">

                <div class="reset-card">

                    <!-- ICON -->

                    <div class="reset-icon">

                        <div class="icon-circle">

                            <i class="bi bi-shield-lock-fill"></i>

                        </div>

                    </div>


                    <!-- TITLE -->

                    <h2>
                        Verify Code
                    </h2>


                    <!-- SUBTITLE -->

                    <p class="subtitle">
                        Check your email for the 6 digit code.
                    </p>


                    <!-- ERROR -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="error-message">

                            <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error

                        </div>
                    }


                    <!-- FORM -->
                    @using (Html.BeginForm("VerifyResetCode", "Applicant", FormMethod.Post))
                    {

                        <div class="code-form">

                            <label class="form-label">
                                Reset Code
                            </label>


                            <!-- RESET CODE INPUT -->

                            <input type="text"
                                   name="Code"
                                   maxlength="6"
                                   class="code-input"
                                   placeholder="Enter 6-digit reset code"
                                   required />


                            <!-- VERIFY BUTTON -->

                            <button type="submit"
                                    class="btn-verify">

                                Verify Code

                            </button>


                            <!-- REMAINING TIME -->

                            <div class="remaining-time">

                                Remaining time:
                                <strong id="countdown">
                                    5:00
                                </strong>

                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         TIMER SCRIPT
    ========================== -->

    <script>

            let timeLeft = 300; // 5 minutes = 300 seconds

            const countdown = document.getElementById("countdown");

            const timer = setInterval(function () {

                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;

                countdown.innerText =
                    minutes + ":" + (seconds < 10 ? "0" : "") + seconds;

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    countdown.innerText = "Expired";
                    countdown.style.color = "#dc2626";
                }

                timeLeft--;

            }, 1000);

    </script>

</body>
</html>