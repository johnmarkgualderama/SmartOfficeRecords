@{
    ViewBag.Title = "Verify Code";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Verify Code</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="d-flex align-items-center justify-content-center" style="height:100vh; background:#f4f6f9;">

    <div class="card p-4" style="width:400px;">
        <h4 class="text-center mb-3">Enter Reset Code</h4>
        <p class="text-muted text-center">Check your email for the 6-digit code.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("VerifyResetCode", "Applicant", FormMethod.Post))
        {
            <div class="mb-3">
                <label>Reset Code</label>
                <input type="text" name="Code" class="form-control" maxlength="6" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Verify Code</button>
        }
    </div>

</body>
</html>