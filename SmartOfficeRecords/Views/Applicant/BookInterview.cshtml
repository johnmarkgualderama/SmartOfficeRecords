@{
    ViewBag.Title = "Book Interview";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Book Interview - SORS</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- POPPINS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <style>

            /* =========================================================
                                           GLOBAL
                                        ========================================================= */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                background: #f1f1f1;
                color: #263238;
                min-height: 100vh;
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

            :root {
                --red: #ed1c24;
                --red-dark: #c9151c;
                --red-light: #fff1f1;
                --sidebar: #222b30;
                --sidebar-hover: #2d373d;
                --white: #ffffff;
                --black-gray: #263238;
                --dark-gray: #455a64;
                --gray: #78909c;
                --light-gray: #eceff1;
                --border: #e1e5e8;
                --page-bg: #f1f1f1;
            }


            /* =========================================================
                                           TOP NAVBAR
                                        ========================================================= */

            .navbar-custom {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 56px;
                background: var(--white);
                border-bottom: 1px solid #e0e0e0;
                display: flex;
                align-items: center;
                z-index: 1030;
                padding: 0;
            }


            /* =========================================================
                                           LEFT LOGO BOX
                                        ========================================================= */

            .navbar-left-box {
                width: 155px;
                height: 56px;
                background: var(--sidebar);
                display: flex;
                align-items: center;
                padding: 0 15px;
                border-right: 1px solid #39434a;
                transition: all .3s ease;
            }

            .navbar-brand-custom {
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
            }

                .navbar-brand-custom img {
                    width: 34px;
                    height: 34px;
                    object-fit: contain;
                    border-radius: 50%;
                }

            .brand-text {
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: .4px;
            }


            /* =========================================================
                                           HAMBURGER
                                        ========================================================= */

            .toggle-zone-box {
                height: 56px;
                width: 55px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #ffffff;
            }

            .sidebar-toggle-btn {
                border: none;
                background: transparent;
                color: var(--red);
                font-size: 18px;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: .2s ease;
            }

                .sidebar-toggle-btn:hover {
                    color: var(--red-dark);
                }


            /* =========================================================
                                           NAVBAR RIGHT
                                        ========================================================= */

            .navbar-profile {
                margin-left: auto;
                height: 56px;
                display: flex;
                align-items: center;
                gap: 15px;
                padding-right: 15px;
            }


            /* =========================================================
                                           NOTIFICATION
                                        ========================================================= */

            .notification-container {
                position: relative;
            }

            .notification-btn {
                width: 40px;
                height: 40px;
                border: none;
                background: transparent;
                color: var(--dark-gray);
                font-size: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: .2s ease;
            }

                .notification-btn:hover {
                    color: var(--red);
                }

            .notification-badge-dot {
                position: absolute;
                top: 8px;
                right: 7px;
                width: 7px;
                height: 7px;
                background: var(--red);
                border-radius: 50%;
                border: 1px solid white;
            }


            /* =========================================================
                                           NOTIFICATION DROPDOWN
                                        ========================================================= */

            .notification-dropdown-custom {
                position: absolute;
                right: 0;
                top: 48px;
                width: 330px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
                overflow: hidden;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all .25s ease;
                z-index: 1050;
            }

            .notification-container.open .notification-dropdown-custom {
                max-height: 450px;
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .notif-header {
                padding: 14px 16px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border-bottom: 1px solid #eeeeee;
            }

            .notif-header-title {
                color: var(--black-gray);
                font-size: 13px;
                font-weight: 700;
            }

            .notif-mark-read {
                color: var(--red);
                font-size: 10px;
                font-weight: 600;
            }

                .notif-mark-read:hover {
                    color: var(--red-dark);
                }

            .notif-body {
                max-height: 300px;
                overflow-y: auto;
            }

            .notif-item {
                display: flex;
                gap: 10px;
                padding: 12px 15px;
                border-bottom: 1px solid #f1f1f1;
                color: inherit;
                transition: .2s ease;
            }

                .notif-item:hover {
                    background: var(--red-light);
                }

            .notif-icon-box {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .notif-icon-success {
                background: #e8f5e9;
                color: #43a047;
            }

            .notif-icon-warning {
                background: #fff3e0;
                color: #fb8c00;
            }

            .notif-text {
                color: var(--dark-gray);
                font-size: 11px;
                line-height: 1.4;
            }

            .notif-time {
                color: #9e9e9e;
                font-size: 9px;
                margin-top: 3px;
            }

            .notif-footer {
                padding: 10px;
                text-align: center;
                background: #fafafa;
                border-top: 1px solid #eeeeee;
            }

            .notif-footer-btn {
                color: var(--red);
                font-size: 11px;
                font-weight: 600;
            }


            /* =========================================================
                                           PROFILE
                                        ========================================================= */

            .profile-container {
                position: relative;
            }

            .profile-widget {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 4px 8px;
                border-radius: 20px;
                background: #f5f5f5;
                border: 1px solid #e3e3e3;
                cursor: pointer;
                transition: .2s ease;
            }

                .profile-widget:hover {
                    background: #eeeeee;
                }

            .profile-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: #ffb52e;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
            }

            .profile-info {
                line-height: 1.1;
            }

            .profile-name {
                display: block;
                color: var(--black-gray);
                font-size: 10px;
                font-weight: 700;
            }

            .profile-email {
                display: block;
                color: #78909c;
                font-size: 8px;
            }

            .profile-arrow {
                color: #546e7a;
                font-size: 11px;
                transition: .3s;
            }

            .profile-dropdown-custom {
                position: absolute;
                right: 0;
                top: 48px;
                width: 200px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 10px 30px rgba(0,0,0,.12);
                overflow: hidden;
                max-height: 0;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-8px);
                transition: all .25s ease;
                z-index: 1050;
            }

            .profile-container.open .profile-dropdown-custom {
                max-height: 200px;
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .profile-container.open .profile-arrow {
                transform: rotate(180deg);
            }

            .profile-dropdown-custom a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 12px 15px;
                color: var(--dark-gray);
                font-size: 12px;
                font-weight: 500;
                transition: .2s ease;
            }

                .profile-dropdown-custom a:hover {
                    background: var(--red-light);
                    color: var(--red);
                }

                .profile-dropdown-custom a i {
                    font-size: 16px;
                }


            /* =========================================================
                                           SIDEBAR
                                        ========================================================= */

            .sidebar-menu-wrapper {
                position: fixed;
                top: 56px;
                left: 0;
                bottom: 0;
                width: 155px;
                background: var(--sidebar);
                border-right: 1px solid #39434a;
                padding: 15px 8px;
                overflow-y: auto;
                overflow-x: hidden;
                z-index: 1020;
                transition: all .3s ease;
            }

                .sidebar-menu-wrapper::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-menu-wrapper::-webkit-scrollbar-track {
                    background: var(--sidebar);
                }

                .sidebar-menu-wrapper::-webkit-scrollbar-thumb {
                    background: #45545d;
                    border-radius: 10px;
                }

            .sidebar-links {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .sidebar-link-item {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 11px 10px;
                border-radius: 5px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 500;
                white-space: nowrap;
                transition: all .2s ease;
            }

                .sidebar-link-item i {
                    width: 17px;
                    min-width: 17px;
                    font-size: 14px;
                    display: inline-flex;
                    justify-content: center;
                }

                .sidebar-link-item:hover {
                    color: var(--red);
                    background: rgba(237, 28, 36, .08);
                }

                .sidebar-link-item.active {
                    color: var(--red);
                    background: transparent;
                    font-weight: 600;
                }


            /* =========================================================
                                           SETTINGS
                                        ========================================================= */

            .sidebar-settings {
                list-style: none;
            }

            .settings-toggle {
                justify-content: space-between;
                cursor: pointer;
            }

                .settings-toggle > a {
                    color: #ffffff !important;
                }

                    .settings-toggle > a:hover {
                        color: var(--red) !important;
                    }

                .settings-toggle.active {
                    color: var(--red);
                    background: rgba(237,28,36,.08);
                }

                    .settings-toggle.active > a {
                        color: var(--red) !important;
                    }

            .settings-arrow {
                color: #ffffff;
                font-size: 11px;
                transition: .3s;
            }

            .settings-toggle:hover .settings-arrow {
                color: var(--red);
            }

            .settings-submenu {
                list-style: none;
                padding: 0 0 0 12px;
                margin: 2px 0 0 0;
                max-height: 0;
                overflow: hidden;
                transition: max-height .3s ease;
            }

                .settings-submenu li {
                    margin: 2px 0;
                }

                .settings-submenu a {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    padding: 8px 9px;
                    border-radius: 5px;
                    color: #ffffff !important;
                    font-size: 11px;
                    font-weight: 500;
                    transition: .2s ease;
                }

                    .settings-submenu a:hover {
                        background: rgba(237,28,36,.10);
                        color: var(--red) !important;
                    }

                    .settings-submenu a i {
                        color: #ffffff;
                        font-size: 12px;
                    }

                    .settings-submenu a:hover i {
                        color: var(--red);
                    }

            .sidebar-settings.open .settings-submenu {
                max-height: 150px;
            }

            .sidebar-settings.open .settings-arrow {
                transform: rotate(90deg);
            }


            /* =========================================================
                                           LOGOUT
                                        ========================================================= */

            .logout-wrapper {
                position: absolute;
                bottom: 15px;
                left: 8px;
                right: 8px;
            }

            .logout-link {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 10px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 500;
                border-radius: 5px;
                transition: .2s ease;
            }

                .logout-link:hover {
                    color: var(--red);
                    background: rgba(237,28,36,.08);
                }

                .logout-link i {
                    font-size: 16px;
                }


            /* =========================================================
                                           MAIN CONTENT
                                        ========================================================= */

            .page-container {
                margin-left: 155px;
                padding: 78px 18px 35px 18px;
                min-height: 100vh;
                transition: margin-left .3s ease;
            }


            /* =========================================================
                                           PAGE HEADING
                                        ========================================================= */

            .heading-section {
                margin-bottom: 18px;
            }

            .page-title {
                color: var(--black-gray);
                font-size: 21px;
                font-weight: 700;
                margin-bottom: 2px;
            }

            .page-subtitle {
                color: #607d8b;
                font-size: 10px;
                font-weight: 500;
                margin: 0;
            }


            /* =========================================================
                                           BOOKING LAYOUT
                                        ========================================================= */

            .booking-layout {
                display: grid;
                grid-template-columns: minmax(0, 2.2fr) minmax(220px, .78fr);
                gap: 12px;
                align-items: start;
            }


            /* =========================================================
                                           BOOKING CARD
                                        ========================================================= */

            .booking-card {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 9px;
                padding: 16px 17px 20px;
                box-shadow: 0 3px 15px rgba(0,0,0,.05);
            }

            .booking-card-header {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 18px;
            }

            .booking-card-icon {
                width: 26px;
                height: 26px;
                border-radius: 5px;
                background: #ffffff;
                border: 2px solid #455a64;
                color: #455a64;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 14px;
            }

            .booking-card-title {
                color: #263238;
                font-size: 13px;
                font-weight: 700;
            }


            /* =========================================================
                                           ALERTS
                                        ========================================================= */

            .alert-custom {
                font-size: 11px;
                padding: 10px 14px;
                border-radius: 7px;
                margin-bottom: 16px;
            }


            /* =========================================================
                                           SECTION TITLE
                                        ========================================================= */

            .form-section {
                margin-bottom: 18px;
            }

            .form-section-title {
                color: #263238;
                font-size: 12px;
                font-weight: 700;
                padding-bottom: 8px;
                border-bottom: 1px solid #e1e5e8;
                margin-bottom: 15px;
            }


            /* =========================================================
                                           FORM LABEL
                                        ========================================================= */

            .form-label-custom {
                display: block;
                color: #37474f;
                font-size: 10px;
                font-weight: 600;
                margin-bottom: 6px;
            }


            /* =========================================================
                                           INPUT WRAPPER
                                        ========================================================= */

            .input-wrapper {
                position: relative;
            }

            .input-icon {
                position: absolute;
                left: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: #78909c;
                font-size: 14px;
                pointer-events: none;
                z-index: 2;
            }

            .form-control-custom {
                width: 100%;
                height: 38px;
                border: 1px solid #d8dde0;
                border-radius: 7px;
                background: #ffffff;
                color: #455a64;
                font-size: 10px;
                padding: 0 12px 0 36px;
                outline: none;
                box-shadow: 0 2px 6px rgba(0,0,0,.10);
                transition: all .2s ease;
            }

                .form-control-custom::placeholder {
                    color: #a0a8ad;
                }

                .form-control-custom:focus {
                    border-color: var(--red);
                    box-shadow: 0 0 0 3px rgba(237,28,36,.08);
                }


            /* =========================================================
                                           FILE INPUT
                                        ========================================================= */

            .file-input-wrapper {
                position: relative;
                display: flex;
                height: 38px;
                border: 1px solid #d8dde0;
                border-radius: 7px;
                overflow: hidden;
                background: #ffffff;
                box-shadow: 0 2px 6px rgba(0,0,0,.10);
            }

            .file-input-label {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0 12px;
                color: #a0a8ad;
                font-size: 10px;
                cursor: pointer;
                overflow: hidden;
                white-space: nowrap;
            }

                .file-input-label i {
                    color: #78909c;
                    font-size: 14px;
                }

            .file-input-wrapper input[type="file"] {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
            }

            .browse-btn {
                width: 66px;
                border: none;
                background: var(--red);
                color: #ffffff;
                font-size: 10px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s ease;
            }

                .browse-btn:hover {
                    background: var(--red-dark);
                }


            /* =========================================================
                                           DATE / TIME INPUT
                                        ========================================================= */

            .form-control-custom[type="date"] {
                color: #78909c;
                padding-right: 32px;
            }

                .form-control-custom[type="date"]::-webkit-calendar-picker-indicator {
                    opacity: .55;
                    cursor: pointer;
                }


            /* =========================================================
                                           TEXTAREA
                                        ========================================================= */

            .textarea-custom {
                width: 100%;
                min-height: 46px;
                resize: vertical;
                border: 1px solid #d8dde0;
                border-radius: 7px;
                background: #ffffff;
                color: #455a64;
                font-size: 10px;
                padding: 12px;
                outline: none;
                box-shadow: 0 2px 6px rgba(0,0,0,.10);
                transition: all .2s ease;
            }

                .textarea-custom::placeholder {
                    color: #a0a8ad;
                }

                .textarea-custom:focus {
                    border-color: var(--red);
                    box-shadow: 0 0 0 3px rgba(237,28,36,.08);
                }


            /* =========================================================
                                           FORM BUTTONS
                                        ========================================================= */

            .booking-actions {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 10px;
                margin-top: 18px;
            }

            .btn-reset {
                min-width: 184px;
                height: 38px;
                border: 1px solid #ff6b70;
                border-radius: 7px;
                background: #ffffff;
                color: var(--red);
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                transition: all .2s ease;
            }

                .btn-reset:hover {
                    background: var(--red-light);
                }

            .btn-submit {
                min-width: 184px;
                height: 38px;
                border: none;
                border-radius: 7px;
                background: var(--red);
                color: #ffffff;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(237,28,36,.18);
                transition: all .2s ease;
            }

                .btn-submit:hover {
                    background: var(--red-dark);
                    transform: translateY(-1px);
                    box-shadow: 0 5px 13px rgba(237,28,36,.22);
                }


            /* =========================================================
                                           RIGHT SIDE CARDS
                                        ========================================================= */

            .right-side {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }


            /* =========================================================
                                           REMINDER
                                        ========================================================= */

            .reminder-card {
                background: #fff6f6;
                border: 1px solid #ffc5c7;
                border-radius: 7px;
                padding: 13px;
            }

            .side-card-header {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #263238;
                font-size: 12px;
                font-weight: 700;
                margin-bottom: 8px;
            }

                .side-card-header i {
                    color: var(--red);
                    font-size: 14px;
                }

            .reminder-text {
                color: #78909c;
                font-size: 9px;
                line-height: 1.5;
                margin: 0;
            }


            /* =========================================================
                                           GUIDELINES
                                        ========================================================= */

            .guideline-card {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 7px;
                padding: 13px;
                box-shadow: 0 2px 8px rgba(0,0,0,.03);
            }

            .guideline-list {
                margin: 0;
                padding: 0;
                list-style: none;
            }

            .guideline-item {
                display: flex;
                align-items: flex-start;
                gap: 8px;
                padding: 8px 0;
                border-bottom: 1px solid #eeeeee;
            }

                .guideline-item:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }

            .guideline-icon {
                width: 15px;
                min-width: 15px;
                color: var(--red);
                font-size: 12px;
                margin-top: 2px;
            }

            .guideline-content {
                flex: 1;
            }

            .guideline-title {
                display: block;
                color: #37474f;
                font-size: 10px;
                font-weight: 700;
                margin-bottom: 2px;
            }

            .guideline-description {
                display: block;
                color: #78909c;
                font-size: 8.5px;
                line-height: 1.35;
            }


            /* =========================================================
                                           SIDEBAR COLLAPSE
                                        ========================================================= */

            body.sidebar-collapsed .navbar-left-box {
                width: 60px;
                padding: 0;
                justify-content: center;
            }

            body.sidebar-collapsed .brand-text {
                display: none;
            }

            body.sidebar-collapsed .sidebar-menu-wrapper {
                width: 60px;
                padding-left: 6px;
                padding-right: 6px;
            }

            body.sidebar-collapsed .sidebar-link-item {
                justify-content: center;
                padding-left: 0;
                padding-right: 0;
                gap: 0;
            }

            body.sidebar-collapsed .sidebar-link-text {
                display: none;
            }

            body.sidebar-collapsed .settings-arrow {
                display: none;
            }

            body.sidebar-collapsed .settings-submenu {
                display: none !important;
            }

            body.sidebar-collapsed .logout-link {
                justify-content: center;
                padding-left: 0;
                padding-right: 0;
            }

            body.sidebar-collapsed .logout-text {
                display: none;
            }

            body.sidebar-collapsed .page-container {
                margin-left: 60px;
            }


            /* =========================================================
                                           RESPONSIVE
                                        ========================================================= */

            @@media (max-width: 1000px) {

                .navbar-left-box {
                    width: 210px;
                }

                .sidebar-menu-wrapper {
                    width: 210px;
                }

                .page-container {
                    margin-left: 210px;
                }

                body.sidebar-collapsed .page-container {
                    margin-left: 60px;
                }

                .booking-layout {
                    grid-template-columns: 1fr;
                }

                .right-side {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                }
            }


            @@media (max-width: 700px) {

                .navbar-left-box {
                    width: 60px;
                    padding: 0;
                    justify-content: center;
                }

                .brand-text {
                    display: none;
                }

                .sidebar-menu-wrapper {
                    width: 60px;
                }

                .sidebar-link-item {
                    justify-content: center;
                    padding: 11px 0;
                    gap: 0;
                }

                .sidebar-link-text {
                    display: none;
                }

                .settings-arrow {
                    display: none;
                }

                .settings-submenu {
                    display: none !important;
                }

                .page-container {
                    margin-left: 60px;
                    padding: 75px 12px 25px;
                }

                .profile-info {
                    display: none;
                }

                .profile-widget {
                    padding: 4px;
                }

                .booking-card {
                    padding: 14px;
                }

                .right-side {
                    display: flex;
                }

                .booking-actions {
                    flex-direction: column;
                }

                .btn-reset,
                .btn-submit {
                    width: 100%;
                }
            }


            @@media (max-width: 500px) {

                .navbar-profile {
                    gap: 5px;
                    padding-right: 7px;
                }

                .notification-dropdown-custom {
                    width: 280px;
                    right: -60px;
                }

                .profile-dropdown-custom {
                    right: -5px;
                }

                .page-title {
                    font-size: 18px;
                }

                .page-subtitle {
                    font-size: 9px;
                }
            }
            /* =========================================================
                                   EDIT BOOK INTERVIEW MODAL
                                ========================================================= */

            .eb-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 20, 22, 0.55);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 2000;
                padding: 20px;
            }

                .eb-overlay.show {
                    display: flex;
                }

            .eb-card {
                width: 100%;
                max-width: 400px;
                background: #ffffff;
                border-left: 6px solid var(--red);
                border-radius: 10px;
                padding: 26px 28px;
                box-shadow: 0 25px 60px rgba(0,0,0,.28);
                opacity: 0;
                transform: translateY(16px);
                animation: ebSlideIn .3s ease forwards;
            }

            @@keyframes ebSlideIn {
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .eb-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: var(--red-light);
                color: var(--red);
                font-size: 10px;
                font-weight: 700;
                letter-spacing: .3px;
                padding: 6px 11px;
                border-radius: 20px;
                margin-bottom: 16px;
            }

            .eb-title {
                color: #263238;
                font-size: 15px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .eb-subtitle {
                color: #78909c;
                font-size: 10.5px;
                line-height: 1.5;
                margin-bottom: 20px;
            }

            .eb-group {
                margin-bottom: 16px;
            }

            .eb-label {
                display: block;
                color: #37474f;
                font-size: 10px;
                font-weight: 600;
                margin-bottom: 6px;
            }

            .eb-input-wrap {
                position: relative;
            }

                .eb-input-wrap i {
                    position: absolute;
                    left: 12px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #78909c;
                    font-size: 13px;
                    pointer-events: none;
                }

            .eb-input {
                width: 100%;
                height: 40px;
                border: 1px solid #d8dde0;
                border-radius: 7px;
                background: #ffffff;
                color: #455a64;
                font-size: 11px;
                padding: 0 12px 0 34px;
                outline: none;
                transition: all .2s ease;
            }

                .eb-input:focus {
                    border-color: var(--red);
                    box-shadow: 0 0 0 3px rgba(237,28,36,.08);
                }

                .eb-input::placeholder {
                    color: #a0a8ad;
                }

            select.eb-input {
                padding-left: 34px;
                appearance: auto;
            }

            .eb-actions {
                display: flex;
                gap: 10px;
                margin-top: 22px;
            }

            .eb-btn-cancel {
                flex: 1;
                height: 40px;
                border: 1px solid #d8dde0;
                background: #ffffff;
                color: #455a64;
                border-radius: 7px;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s ease;
            }

                .eb-btn-cancel:hover {
                    background: #f1f1f1;
                }

            .eb-btn-save {
                flex: 1;
                height: 40px;
                border: none;
                background: var(--red);
                color: #ffffff;
                border-radius: 7px;
                font-size: 11px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(237,28,36,.18);
                transition: .2s ease;
            }

                .eb-btn-save:hover {
                    background: var(--red-dark);
                }

                .eb-btn-save:disabled {
                    opacity: .65;
                    cursor: not-allowed;
                }

            .eb-error-text {
                color: var(--red-dark);
                font-size: 10px;
                font-weight: 500;
                margin-top: -8px;
                margin-bottom: 14px;
                display: none;
            }


            /* =========================================================
                                   SUCCESS MODAL
                                ========================================================= */

            .eb-success-card {
                width: 100%;
                max-width: 340px;
                background: #ffffff;
                border-radius: 12px;
                padding: 30px 28px 26px;
                text-align: center;
                box-shadow: 0 25px 60px rgba(0,0,0,.28);
                opacity: 0;
                transform: translateY(16px);
                animation: ebSlideIn .3s ease forwards;
            }

            .eb-success-label {
                color: #90a4ae;
                font-size: 9.5px;
                font-weight: 700;
                letter-spacing: .6px;
                text-transform: uppercase;
                margin-bottom: 18px;
            }

            .eb-success-icon {
                width: 62px;
                height: 62px;
                border-radius: 50%;
                background: var(--red-light);
                color: #263238;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 26px;
                margin: 0 auto 16px;
            }

            .eb-success-title {
                color: #263238;
                font-size: 16px;
                font-weight: 700;
                margin-bottom: 6px;
            }

            .eb-success-text {
                color: #78909c;
                font-size: 11px;
                line-height: 1.5;
                margin-bottom: 22px;
            }

            .eb-btn-ok {
                width: 100%;
                height: 42px;
                border: none;
                background: var(--red);
                color: #ffffff;
                border-radius: 7px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 10px rgba(237,28,36,.18);
                transition: .2s ease;
            }

                .eb-btn-ok:hover {
                    background: var(--red-dark);
                }

    </style>

</head>


<body>


    <!-- TOP NAVBAR -->

    <nav class="navbar-custom">

        <div class="navbar-left-box">

            <a class="navbar-brand-custom" href="@Url.Action("ApplicantDash", "Applicant")">
                <img src="~/Images/logo.png" alt="SORS Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <span class="brand-text">SORS</span>
            </a>

        </div>

        <div class="toggle-zone-box">
            <button class="sidebar-toggle-btn" id="toggleSidebar" type="button" title="Toggle Sidebar">
