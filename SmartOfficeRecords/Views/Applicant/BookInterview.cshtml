            <a href="@Url.Action("ApplicantLogout", "Applicant")" class="logout-link">
                <i class="bi bi-box-arrow-right"></i>
                <span class="logout-text">Logout</span>
            </a>
        </div>

    </aside>


    <!-- MAIN CONTENT -->

    <main class="page-container">

        <div class="heading-section">
            <h1 class="page-title">Book Interview</h1>
            <p class="page-subtitle">Fill out the form below to schedule your interview.</p>
        </div>

        <div class="booking-layout">

            <!-- LEFT: BOOKING FORM OR COOLDOWN NOTICE -->
            <div class="booking-card">

                @if (ViewBag.InCooldown == true)
                {
                    <div style="border: 2px solid #2563EB; border-radius: 10px; padding: 24px; text-align: center;">

                        <div style="width: 56px; height: 56px; border-radius: 50%; background: #FEE2E2; color: #E32626; display: flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 auto 16px;">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <h5 style="color: #263238; font-weight: 700; margin-bottom: 8px;">You've Already Completed an Interview.</h5>
                        <p style="color: #78909c; font-size: 11px; max-width: 420px; margin: 0 auto 20px;">
                            To give every applicant a fair chance, you can submit a new interview request 30 days after your last completed interview. Here's when you'll be eligible again.
                        </p>

                        <div style="background: #1F2933; color: #ffffff; border-radius: 8px; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                            <div style="text-align: left;">
                                <div style="font-size: 22px; font-weight: 700;">@ViewBag.DaysLeft</div>
                                <div style="font-size: 9px; color: #9CA3AF; letter-spacing: .5px;">DAYS LEFT</div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 12px; font-weight: 700;">@ViewBag.EligibleDate</div>
                                <div style="font-size: 9px; color: #9CA3AF; letter-spacing: .5px;">ELIGIBLE TO REAPPLY</div>
                            </div>
                        </div>

                        <div style="height: 6px; background: #E5E7EB; border-radius: 10px; overflow: hidden; margin-bottom: 20px;">
                            <div style="height: 100%; width: @(ViewBag.ProgressPercent)%; background: #E32626;"></div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; text-align: left; margin-bottom: 20px;">
                            <div>
                                <div style="font-size: 9px; color: #9CA3AF; font-weight: 700; letter-spacing: .4px;">LAST INTERVIEW DATE</div>
                                <div style="font-size: 12px; font-weight: 700; color: #1F2933;">@ViewBag.LastInterviewDate</div>
                            </div>
                            <div>
                                <div style="font-size: 9px; color: #9CA3AF; font-weight: 700; letter-spacing: .4px;">RESULT</div>
                                <div style="font-size: 12px; font-weight: 700; color: #16A34A;">
                                    <i class="bi bi-check-circle-fill"></i> Completed
                                </div>
                            </div>
                            <div>
                                <div style="font-size: 9px; color: #9CA3AF; font-weight: 700; letter-spacing: .4px;">POSITION APPLIED</div>
                                <div style="font-size: 12px; font-weight: 700; color: #1F2933;">@ViewBag.PositionApplied</div>
                            </div>
                            <div>
                                <div style="font-size: 9px; color: #9CA3AF; font-weight: 700; letter-spacing: .4px;">REAPPLICATION WINDOW</div>
                                <div style="font-size: 12px; font-weight: 700; color: #1F2933;">@ViewBag.ReapplicationWindow Days</div>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: center; gap: 10px;">
                            <a href="@Url.Action("MyAppointment", "Applicant")" class="btn-reset" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">
                                View My Appointment
                            </a>
                            <button type="button" class="btn-submit" style="opacity: .6; cursor: not-allowed;" disabled title="Not eligible yet">
                                <i class="bi bi-lock-fill"></i> Book Interview
                            </button>
                        </div>

                    </div>
                }
                else
                {
                    <div class="booking-card-header">
                        <div class="booking-card-icon">
                            <i class="bi bi-card-checklist"></i>
                        </div>
                        <div class="booking-card-title">Interview Booking Form</div>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-custom" id="errorAlert">@ViewBag.Error</div>
                    }
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-custom" id="successAlert">@ViewBag.Success</div>
                    }

                    @using (Html.BeginForm("BookInterview", "Applicant", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="form-section">

                            <div class="form-section-title">Personal Information</div>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label-custom">Full name</label>
                                    <div class="input-wrapper">
                                        <i class="bi bi-person input-icon"></i>
                                        <input type="text" name="FullName" class="form-control-custom" placeholder="Enter full name" required />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Contact Number</label>
                                    <div class="input-wrapper">
                                        <i class="bi bi-telephone input-icon"></i>
                                        <input type="text" name="ContactNumber" class="form-control-custom" placeholder="Enter Contact Number" required />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Email Address</label>
                                    <div class="input-wrapper">
                                        <i class="bi bi-envelope input-icon"></i>
                                        <input type="email" name="EmailAddress" class="form-control-custom" placeholder="Enter your email address" required />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Upload Resume (PDF, DOC, DOCX)</label>
                                    <div class="file-input-wrapper">
                                        <label class="file-input-label" for="resumeFile">
                                            <i class="bi bi-file-earmark"></i>
                                            <span id="fileName">Choose File</span>
                                        </label>
                                        <button type="button" class="browse-btn" onclick="document.getElementById('resumeFile').click();">Browse</button>
                                        <input type="file" id="resumeFile" name="ResumeFile" accept=".pdf,.doc,.docx" required />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Upload Valid ID (JPG, JPEG, PNG)</label>
                                    <div class="file-input-wrapper">
                                        <label class="file-input-label" for="validIDFile">
                                            <i class="bi bi-person-vcard"></i>
                                            <span id="validIDName">Choose Valid ID</span>
                                        </label>
                                        <button type="button" class="browse-btn" onclick="document.getElementById('validIDFile').click();">Browse</button>
                                        <input type="file" id="validIDFile" name="ValidIDFile" accept=".jpg,.jpeg,.png,.pdf" required />
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="form-section">

                            <div class="form-section-title">Interview Details</div>

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label-custom">Preferred Interview Date</label>
                                    <div class="input-wrapper">
                                        <i class="bi bi-calendar3 input-icon"></i>
                                        <input type="date" name="PreferredDate" class="form-control-custom" required />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label-custom">Preferred Time</label>
                                    <div class="input-wrapper">
                                        <i class="bi bi-clock input-icon"></i>
                                        <select name="PreferredTime" class="form-control-custom" required>
                                            <option value="" disabled selected>Select Time</option>
                                            <option value="09:00 AM">09:00 AM</option>
                                            <option value="10:00 AM">10:00 AM</option>
                                            <option value="11:00 AM">11:00 AM</option>
                                            <option value="01:00 PM">01:00 PM</option>
                                            <option value="02:00 PM">02:00 PM</option>
                                            <option value="03:00 PM">03:00 PM</option>
                                            <option value="04:00 PM">04:00 PM</option>
                                        </select>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <div class="form-section">
                            <label class="form-label-custom">Additional Notes (Optional)</label>
                            <textarea name="AdditionalNotes" class="textarea-custom" placeholder="Enter any additional notes...."></textarea>
                        </div>

                        <div class="booking-actions">
                            <button type="reset" class="btn-reset" id="resetBtn">Reset</button>
                            <button type="submit" class="btn-submit">Submit Booking</button>
                        </div>
                    }
                }

            </div>

            <!-- RIGHT SIDE -->
            <div class="right-side">

                <div class="reminder-card">
                    <div class="side-card-header">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>Reminder</span>
                    </div>
                    <p class="reminder-text">
                        Please provide accurate information.
                        You will receive a confirmation once your
                        booking is successfully submitted.
                    </p>
                </div>

                <div class="guideline-card">

                    <div class="side-card-header">
                        <i class="bi bi-card-list"></i>
                        <span>Interview Guidelines</span>
                    </div>

                    <ul class="guideline-list">

                        <li class="guideline-item">
                            <div class="guideline-icon"><i class="bi bi-clock"></i></div>
                            <div class="guideline-content">
                                <span class="guideline-title">Be on time</span>
                                <span class="guideline-description">Please arrive at least 10 minutes before your scheduled time.</span>
                            </div>
                        </li>

                        <li class="guideline-item">
                            <div class="guideline-icon"><i class="bi bi-card-text"></i></div>
                            <div class="guideline-content">
                                <span class="guideline-title">Bring Valid ID</span>
                                <span class="guideline-description">Present valid government-issued ID for verification.</span>
                            </div>
                        </li>

                        <li class="guideline-item">
                            <div class="guideline-icon"><i class="bi bi-person-workspace"></i></div>
                            <div class="guideline-content">
                                <span class="guideline-title">Dress appropriately</span>
                                <span class="guideline-description">Please wear professional attire for your interview.</span>
                            </div>
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </main>


    <!-- JAVASCRIPT -->

    <script>

            // SIDEBAR TOGGLE
            const toggleSidebar = document.getElementById("toggleSidebar");
            toggleSidebar.addEventListener("click", function () {
                document.body.classList.toggle("sidebar-collapsed");
            });

            // SETTINGS DROPDOWN
            const settingsToggle = document.getElementById("settingsToggle");
            const settingsGroup = document.querySelector(".sidebar-settings");

            settingsToggle.addEventListener("click", function (e) {
                e.preventDefault();
                e.stopPropagation();
                settingsGroup.classList.toggle("open");
            });

            // PROFILE DROPDOWN
            const profileContainer = document.querySelector(".profile-container");
            const profileToggle = document.getElementById("profileToggle");

            profileToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                profileContainer.classList.toggle("open");
                notificationContainer.classList.remove("open");
            });

            // NOTIFICATION DROPDOWN
            const notificationContainer = document.querySelector(".notification-container");
            const notificationToggle = document.getElementById("notificationToggle");

            notificationToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                notificationContainer.classList.toggle("open");
                profileContainer.classList.remove("open");
            });

            // CLOSE DROPDOWNS
            document.addEventListener("click", function (e) {
                if (!profileContainer.contains(e.target)) {
                    profileContainer.classList.remove("open");
                }
                if (!notificationContainer.contains(e.target)) {
                    notificationContainer.classList.remove("open");
                }
            });

            // RESUME FILE NAME
            const resumeFile = document.getElementById("resumeFile");
            const fileName = document.getElementById("fileName");

            if (resumeFile) {
                resumeFile.addEventListener("change", function () {
                    fileName.textContent = this.files.length > 0 ? this.files[0].name : "Choose File";
                });
            }

            // VALID ID FILE NAME
            const validIDFile = document.getElementById("validIDFile");
            const validIDName = document.getElementById("validIDName");

            if (validIDFile) {
                validIDFile.addEventListener("change", function () {
                    validIDName.textContent = this.files.length > 0 ? this.files[0].name : "Choose Valid ID";
                });
            }

            // RESET FILE LABELS ON FORM RESET
            const resetBtn = document.getElementById("resetBtn");
            if (resetBtn) {
                resetBtn.addEventListener("click", function () {
                    if (fileName) fileName.textContent = "Choose File";
                    if (validIDName) validIDName.textContent = "Choose Valid ID";
                });
            }

            // AUTO-DISMISS ALERTS
            const successAlert = document.getElementById('successAlert');
            if (successAlert) {
                setTimeout(function () {
                    successAlert.style.transition = "opacity 0.5s ease";
                    successAlert.style.opacity = "0";
                    setTimeout(function () { successAlert.remove(); }, 500);
                }, 3000);
            }

            const errorAlert = document.getElementById('errorAlert');
            if (errorAlert) {
                setTimeout(function () {
                    errorAlert.style.transition = "opacity 0.5s ease";
                    errorAlert.style.opacity = "0";
                    setTimeout(function () { errorAlert.remove(); }, 500);
                }, 3000);
            }

    </script>


    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>