@{
    ViewBag.Title = "Applicant Register";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Applicant Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Poppins', sans-serif;
            }

            body {
                min-height: 100vh;
                background: #F4F6F8;
                overflow: hidden;
            }

            .main-container {
                width: 100%;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .register-wrapper {
                width: 100%;
                height: 100vh;
                display: flex;
                background: #FFFFFF;
                overflow: hidden;
            }

            .left-side {
                width: 33%;
                height: 100vh;
                background: linear-gradient(145deg, #242D32 0%, #1A2024 45%, #101214 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

                .left-side::before {
                    content: "";
                    position: absolute;
                    width: 500px;
                    height: 500px;
                    top: -250px;
                    left: -250px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.025);
                }

                .left-side::after {
                    content: "";
                    position: absolute;
                    width: 600px;
                    height: 600px;
                    bottom: -350px;
                    right: -350px;
                    border-radius: 50%;
                    background: rgba(237, 28, 36, 0.025);
                }

            .top-content {
                width: 100%;
                text-align: center;
                padding: 40px;
                position: relative;
                z-index: 2;
            }

                .top-content img {
                    width: 132px;
                    height: 132px;
                    object-fit: contain;
                    background: #FFFFFF;
                    padding: 10px;
                    border-radius: 50%;
                    margin-bottom: 31px;
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
                    transition: transform 0.3s ease;
                }

                    .top-content img:hover {
                        transform: scale(1.03);
                    }

                .top-content h1 {
                    color: #FFFFFF;
                    font-size: 31px;
                    font-weight: 700;
                    line-height: 1.55;
                    letter-spacing: 0.4px;
                    margin: 0;
                    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
                }

            .right-side {
                width: 67%;
                height: 100vh;
                background: #F5F7F9;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 25px 35px;
            }

            .register-card {
                width: 100%;
                max-width: 630px;
                background: #FFFFFF;
                border: 1px solid #E1E5E9;
                border-radius: 10px;
                padding: 35px 45px 27px 45px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
                animation: slideInCard 0.6s ease forwards;
            }

                .register-card h2 {
                    text-align: center;
                    color: #171717;
                    font-size: 24px;
                    font-weight: 700;
                    margin-bottom: 3px;
                }

            .subtitle {
                text-align: center;
                color: #6B7280;
                font-size: 12px;
                margin-bottom: 13px;
            }

            .profile-upload {
                display: flex;
                justify-content: center;
                margin-bottom: 8px;
            }

            .profile-upload-container {
                text-align: center;
            }

            .profile-upload label {
                width: 54px;
                height: 54px;
                border-radius: 50%;
                border: 1.5px solid #ED1C24;
                background: #FFFFFF;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
                transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
            }

                .profile-upload label:hover {
                    background: #FFF5F5;
                    border-color: #C9151C;
                    transform: scale(1.03);
                }

            .profile-upload img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: none;
            }

            .profile-upload .upload-icon {
                color: #ED1C24;
                font-size: 17px;
            }

            .profile-upload input[type="file"] {
                display: none;
            }

            .profile-text {
                color: #444444;
                font-size: 9px;
                line-height: 1.1;
                margin-top: 2px;
            }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px 24px;
            }

            .input-group-custom {
                position: relative;
                width: 100%;
            }

                .input-group-custom .left-icon {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #87919B;
                    font-size: 16px;
                    z-index: 3;
                    transition: color 0.2s ease;
                }

                .input-group-custom .right-icon {
                    position: absolute;
                    right: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #87919B;
                    font-size: 16px;
                    cursor: pointer;
                    z-index: 3;
                    transition: color 0.2s ease;
                }

                    .input-group-custom .right-icon:hover {
                        color: #ED1C24;
                    }

            .form-control-custom {
                width: 100%;
                height: 48px;
                border: 1px solid #E1D8D9;
                border-radius: 7px;
                background: #FFFFFF;
                color: #30343B;
                font-size: 13px;
                padding-left: 42px;
                padding-right: 42px;
                outline: none;
                transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            }

                .form-control-custom::placeholder {
                    color: #515A64;
                    opacity: 1;
                    font-size: 13px;
                }

                .form-control-custom:hover {
                    border-color: #D7C7C9;
                }

                .form-control-custom:focus {
                    background: #FFFFFF;
                    border-color: #ED1C24;
                    box-shadow: 0 0 0 3px rgba(237, 28, 36, 0.09);
                }

            .input-group-custom:focus-within .left-icon {
                color: #ED1C24;
            }

            .form-control-custom[type="date"] {
                color: #515A64;
                padding-right: 38px;
            }

                .form-control-custom[type="date"]::-webkit-calendar-picker-indicator {
                    position: absolute;
                    right: 12px;
                    cursor: pointer;
                    opacity: 0.7;
                }

            .upload-box {
                width: 100%;
                margin-top: 12px;
                border: 1.5px dashed #E1E1E1;
                border-radius: 7px;
                background: #FFFFFF;
                min-height: 105px;
                padding: 7px 15px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                transition: border-color 0.2s ease, background 0.2s ease;
            }

                .upload-box:hover {
                    border-color: #ED1C24;
                    background: #FFF9F9;
                }

                .upload-box > i {
                    color: #ED1C24;
                    font-size: 23px;
                    line-height: 1;
                    margin-bottom: 4px;
                }

                .upload-box h6 {
                    color: #222222;
                    font-size: 10px;
                    font-weight: 600;
                    margin: 0 0 3px 0;
                }

                .upload-box p {
                    color: #555555;
                    font-size: 9px;
                    margin: 0 0 3px 0;
                }

                .upload-box input[type="file"] {
                    width: auto;
                    max-width: 115px;
                    height: 22px;
                    padding: 1px 5px;
                    border: none;
                    background: #ED1C24;
                    color: #FFFFFF;
                    border-radius: 4px;
                    font-size: 8px;
                    cursor: pointer;
                }

                    .upload-box input[type="file"]::file-selector-button {
                        border: none;
                        background: #ED1C24;
                        color: #FFFFFF;
                        font-family: 'Poppins', sans-serif;
                        font-size: 9px;
                        font-weight: 500;
                        padding: 3px 8px;
                        border-radius: 4px;
                        cursor: pointer;
                    }

            .upload-info {
                color: #333333;
                font-size: 8px;
                font-weight: 500;
                margin-top: 3px;
            }

            .btn-register {
                width: 75%;
                height: 47px;
                border: none;
                border-radius: 7px;
                background: #ED1C24;
                color: #FFFFFF;
                font-size: 16px;
                font-weight: 600;
                letter-spacing: 0.2px;
                display: block;
                margin: 30px auto 0;
                cursor: pointer;
                transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
                box-shadow: 0 5px 14px rgba(237, 28, 36, 0.20);
            }

                .btn-register:hover {
                    background: #D8171F;
                    transform: translateY(-1px);
                    box-shadow: 0 8px 18px rgba(237, 28, 36, 0.28);
                }

                .btn-register:active {
                    background: #C9151C;
                    transform: translateY(0);
                    box-shadow: 0 4px 10px rgba(237, 28, 36, 0.20);
                }

            .login-link {
                text-align: center;
                margin-top: 13px;
                color: #222222;
                font-size: 13px;
            }

                .login-link a {
                    color: #ED1C24;
                    font-weight: 600;
                    text-decoration: underline;
                    margin-left: 4px;
                    transition: color 0.2s ease;
                }

                    .login-link a:hover {
                        color: #C9151C;
                    }

            .error-message {
                background: #FFF1F2;
                border: 1px solid #FECDD3;
                color: #C9151C;
                text-align: center;
                padding: 9px;
                border-radius: 7px;
                margin-bottom: 15px;
                font-size: 12px;
                font-weight: 500;
            }

            .success-message {
                background: #F1F5F9;
                border: 1px solid #CBD5E1;
                color: #334155;
                text-align: center;
                padding: 9px;
                border-radius: 7px;
                margin-bottom: 15px;
                font-size: 12px;
                font-weight: 500;
            }

            @@keyframes slideInCard {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (max-width: 1100px) {
                .left-side {
                    width: 35%;
                }

                .right-side {
                    width: 65%;
                }

                .register-card {
                    max-width: 600px;
                    padding-left: 30px;
                    padding-right: 30px;
                }

                .top-content h1 {
                    font-size: 27px;
                }

                .top-content img {
                    width: 115px;
                    height: 115px;
                }
            }

            @@media (max-width: 991px) {
                body {
                    overflow-y: auto;
                }

                .register-wrapper {
                    height: auto;
                    min-height: 100vh;
                    flex-direction: column;
                    overflow-y: auto;
                }

                .left-side {
                    width: 100%;
                    height: auto;
                    min-height: 300px;
                }

                .right-side {
                    width: 100%;
                    height: auto;
                    min-height: 700px;
                    padding: 35px 20px;
                }

                .top-content {
                    padding: 40px 20px;
                }

                    .top-content img {
                        width: 105px;
                        height: 105px;
                        margin-bottom: 20px;
                    }

                    .top-content h1 {
                        font-size: 24px;
                    }

                .register-card {
                    max-width: 600px;
                    padding: 35px 25px;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                    gap: 12px;
                }

                .btn-register {
                    width: 100%;
                }
            }

            @@media (max-width: 576px) {
                .left-side {
                    min-height: 270px;
                }

                .top-content {
                    padding: 30px 15px;
                }

                    .top-content img {
                        width: 90px;
                        height: 90px;
                    }

                    .top-content h1 {
                        font-size: 21px;
                    }

                .right-side {
                    padding: 25px 12px;
                }

                .register-card {
                    padding: 30px 20px;
                }

                    .register-card h2 {
                        font-size: 22px;
                    }

                .subtitle {
                    font-size: 11px;
                }
            }
    </style>
</head>

<body>

    <div class="main-container">
        <div class="register-wrapper">

            <div class="left-side">
                <div class="top-content">
                    <img src="~/Images/logo.png" alt="Smart Office Records System Logo" />
                    <h1>
                        SMART OFFICE
                        <br />
                        RECORDS SYSTEM
                    </h1>
                </div>
            </div>

            <div class="right-side">
                <div class="register-card">

                    <h2>Create an Account!</h2>
                    <p class="subtitle">Fill in the details to get started.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="error-message">
                            <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div class="success-message">
                            <i class="bi bi-check-circle me-2"></i>@ViewBag.Success
                        </div>
                    }

                    @using (Html.BeginForm("ApplicantRegister", "Applicant", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="profile-upload">
                            <div class="profile-upload-container">
                                <label for="ProfileImage">
                                    <img id="previewImage" src="" alt="Profile Picture" />
                                    <i class="bi bi-camera-fill upload-icon" id="cameraIcon"></i>
                                </label>

                                <input type="file"
                                       id="ProfileImage"
                                       name="ProfileImage"
                                       accept=".jpg,.jpeg,.png" />

                                <div class="profile-text">Profile</div>
                            </div>
                        </div>

                        <div class="form-grid">

                            <div class="input-group-custom">
                                <i class="bi bi-person left-icon"></i>
                                <input type="text" name="Fullname" class="form-control-custom" placeholder="Full name" required />
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-person-badge left-icon"></i>
                                <input type="text" name="Username" class="form-control-custom" placeholder="Username" required />
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-envelope left-icon"></i>
                                <input type="email" name="Email" class="form-control-custom" placeholder="Email Address" required />
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-person-plus left-icon"></i>
                                <input type="text" name="InvitedBy" class="form-control-custom" placeholder="Invited by" />
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-telephone left-icon"></i>
                                <input type="text" name="ContactNumber" class="form-control-custom" placeholder="Contact Number" required />
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-lock left-icon"></i>
                                <input type="password" id="password" name="Password" class="form-control-custom" placeholder="Password" required />
                                <i class="bi bi-eye right-icon" id="togglePassword"></i>
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-calendar-event left-icon"></i>
                                <input type="text"
                                       name="Birthdate"
                                       class="form-control-custom"
                                       placeholder="Birthdate"
                                       onfocus="(this.type='date')"
                                       onblur="if(!this.value)this.type='text'"
                                       required />
                            </div>

                            <div class="input-group-custom">
                                <i class="bi bi-lock-fill left-icon"></i>
                                <input type="password" id="confirmPassword" name="ConfirmPassword" class="form-control-custom" placeholder="Confirm Password" required />
                                <i class="bi bi-eye right-icon" id="toggleConfirmPassword"></i>
                            </div>

                        </div>

                        <div class="upload-box">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                            <h6>Upload a Photo of Valid ID</h6>
                            <p>or</p>
                            <input type="file" name="ValidID" accept=".jpg,.jpeg,.png" />
                            <div class="upload-info">JPG, JPEG or PNG, Max size 4MB.</div>
                        </div>

                        <button type="submit" class="btn-register">Register</button>
                    }

                    <div class="login-link">
                        Already have an account?
                        <a href="@Url.Action("ApplicantLogin", "Applicant")">Login!</a>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script>
            const togglePassword = document.querySelector("#togglePassword");
            const password = document.querySelector("#password");

            togglePassword.addEventListener("click", function () {
                const type = password.getAttribute("type") === "password" ? "text" : "password";
                password.setAttribute("type", type);
                this.classList.toggle("bi-eye");
                this.classList.toggle("bi-eye-slash");
            });

            const toggleConfirmPassword = document.querySelector("#toggleConfirmPassword");
            const confirmPassword = document.querySelector("#confirmPassword");

            toggleConfirmPassword.addEventListener("click", function () {
                const type = confirmPassword.getAttribute("type") === "password" ? "text" : "password";
                confirmPassword.setAttribute("type", type);
                this.classList.toggle("bi-eye");
                this.classList.toggle("bi-eye-slash");
            });

            const profileInput = document.getElementById("ProfileImage");
            const previewImage = document.getElementById("previewImage");
            const cameraIcon = document.getElementById("cameraIcon");

            if (profileInput) {
                profileInput.addEventListener("change", function () {
                    if (this.files && this.files[0]) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            previewImage.src = e.target.result;
                            previewImage.style.display = "block";
                            cameraIcon.style.display = "none";
                        };
                        reader.readAsDataURL(this.files[0]);
                    }
                });
            }
    </script>

</body>
</html>